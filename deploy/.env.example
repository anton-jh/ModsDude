# Copy to ~/modsdude/.env on the server and fill in; chmod 600, since these are the server's secrets.
# Generate passwords with `openssl rand -hex 24`: hex only, so nothing needs escaping in the connection
# string compose.yml builds from POSTGRES_PASSWORD.

# The domain Caddy serves and gets a certificate for, such as modsdude.com. Its DNS must point at this server.
SITE_ADDRESS=

# Only read when the database volume is first created. Changing it later does not change the password.
POSTGRES_PASSWORD=

# The production storage account's name, and the modsdude-vps app registration that may write to it:
# Application (client) ID, Directory (tenant) ID and a client secret's value.
STORAGE_ACCOUNT_NAME=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# The password for /admin and the Hangfire dashboard at /admin/jobs; the username is admin.
ADMIN_PASSWORD=

# The backup storage account's name, which the admin page lists backups from, and the db-backups container's
# Create-only SAS URL that backup.sh uploads with.
BACKUP_STORAGE_ACCOUNT_NAME=
BACKUP_SAS_URL=

# The healthchecks.io ping URLs of the hourly and daily backup checks.
BACKUP_PING_HOURLY=
BACKUP_PING_DAILY=
