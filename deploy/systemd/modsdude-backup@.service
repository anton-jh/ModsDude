# Installed as a user unit of modsdude by deploy.sh. The instance is the tier: modsdude-backup@hourly,
# modsdude-backup@daily, or modsdude-backup@deploy, which deploy.sh starts before it migrates.

[Unit]
Description=Back up the ModsDude database (%i)

[Service]
Type=oneshot
EnvironmentFile=%h/modsdude/.env
ExecStart=/bin/bash %h/modsdude/backup.sh %i
