<UserControl x:Class="ModsDude.Client.Wpf.Mods.ModDependentsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mods="clr-namespace:ModsDude.Client.Wpf.Mods"
             mc:Ignorable="d"
             Width="620" MaxHeight="640"
             d:DataContext="{d:DesignInstance Type=mods:ModDependentsModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <shared:Surface Style="{StaticResource ModalSurface}">

        <Grid RowDefinitions="auto * auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 12">
                <Grid ColumnDefinitions="auto *">
                    <TextBlock Grid.Column="0"
                               Text="&#xE7BA;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Margin="0 0 12 0"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Style="{StaticResource TitleTextBlockStyle}" />
                </Grid>

                <TextBlock Text="{Binding Message}"
                           Margin="0 12 0 0"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding Advice}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="24 0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type mods:ProfileDependentViewModel}">
                                <Border Style="{StaticResource InsetWell}"
                                        Margin="0 0 0 12"
                                        Padding="12">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="* auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Grid.Column="1"
                                                       Margin="8 0 0 0"
                                                       Text="{Binding Summary}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Style="{DynamicResource CaptionTextBlockStyle}" />
                                        </Grid>

                                        <!-- The one case pruning cannot solve, so it is said on the
                                             row rather than left to somebody comparing numbers. -->
                                        <TextBlock Margin="0 4 0 0"
                                                   Text="Current revision · cannot be pruned"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                                   Visibility="{Binding IncludesHead, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- Wrapping, because a profile with two hundred revisions
                                             using one mod is an ordinary thing to have to look at. -->
                                        <ItemsControl ItemsSource="{Binding Revisions}" Margin="0 8 0 0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type mods:RevisionLinkViewModel}">
                                                    <TextBlock Margin="0 0 10 2">
                                                        <Hyperlink Style="{StaticResource TextLink}"
                                                                   ToolTip="Open revision"
                                                                   Command="{Binding OpenCommand}">
                                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding TruncationNote}"
                               Margin="0 0 0 12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Visibility="{Binding Truncated, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>

            <Border Style="{StaticResource ModalFooter}"
                    Grid.Row="2"
                    Margin="0 16 0 0">
                <Button Margin="24"
                        MinWidth="120"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="OK"
                        Command="{Binding CloseCommand}" />
            </Border>
        </Grid>
    </shared:Surface>

</UserControl>
