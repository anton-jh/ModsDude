<UserControl x:Class="ModsDude.Client.Wpf.Mods.ModDetailsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ModsDude.Client.Wpf.Shared.Behaviors"
             xmlns:imaging="clr-namespace:ModsDude.Client.Wpf.Mods.Imaging"
             xmlns:mods="clr-namespace:ModsDude.Client.Wpf.Mods"
             mc:Ignorable="d"
             Width="920" Height="620"
             d:DataContext="{d:DesignInstance Type=mods:ModDetailsModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <shared:Surface Style="{StaticResource ModalSurface}" FocusManager.FocusedElement="{Binding ElementName=CloseButton}">

        <Grid RowDefinitions="auto * auto">

            <Grid Grid.Row="0" Margin="24 24 56 16" ColumnDefinitions="* auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}"
                               TextWrapping="Wrap"
                               Style="{StaticResource TitleTextBlockStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                                   Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                        <TextBlock Text="•" Margin="8 0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Id}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="•" Margin="8 0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding Author}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Level with the corner close button the modal layer draws. -->
                <Button Grid.Column="1"
                        Margin="12 -16 0 0"
                        VerticalAlignment="Top"
                        Style="{StaticResource SubtleIconButton}"
                        Content="&#xE721;"
                        FontSize="14"
                        ToolTip="Find (Ctrl+F)"
                        AutomationProperties.Name="Find"
                        Command="{Binding OpenFindCommand}" />
            </Grid>

            <Grid Grid.Row="1" Margin="24 0 24 0" ColumnDefinitions="400 *">

                <Grid Grid.Column="0" RowDefinitions="* auto">

                    <Border Grid.Row="0"
                            CornerRadius="{StaticResource WellCornerRadius}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="No images"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasImages}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Loading…"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding IsLoadingFullImage, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <Image Source="{Binding FullImage}" Stretch="Uniform" Margin="12" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             Margin="0 12 0 0"
                             MaxHeight="96"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Images}"
                             SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasImageStrip, Converter={StaticResource BoolToVisibilityConverter}}">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type imaging:ModImageViewModel}">
                                <Border behaviors:LazyLoad.Source="{Binding}"
                                        Width="64" Height="64"
                                        CornerRadius="{StaticResource BadgeCornerRadius}"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        ToolTip="{Binding Name}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid Grid.Column="1" Margin="24 0 0 0" RowDefinitions="auto *">

                    <Grid Grid.Row="0"
                          Margin="0 0 0 12"
                          ColumnDefinitions="* auto auto auto auto"
                          Visibility="{Binding IsFindOpen, Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBox x:Name="FindBox"
                                 Grid.Column="0"
                                 AutomationProperties.Name="Find in description"
                                 behaviors:FocusRequest.Count="{Binding FindFocusRequests}"
                                 Text="{Binding FindQuery, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Modifiers="Shift" Command="{Binding FindPreviousCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Grid.Column="0"
                                   Text="Find in description"
                                   Margin="12 0 0 0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FindBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="1"
                                   Margin="12 0 4 0"
                                   VerticalAlignment="Center"
                                   Text="{Binding MatchSummary}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Button Grid.Column="2"
                                Style="{StaticResource SubtleIconButton}"
                                Content="&#xE70E;"
                                FontSize="12"
                                ToolTip="Previous (Shift+Enter)"
                                AutomationProperties.Name="Previous match"
                                Command="{Binding FindPreviousCommand}" />

                        <Button Grid.Column="3"
                                Style="{StaticResource SubtleIconButton}"
                                Content="&#xE70D;"
                                FontSize="12"
                                ToolTip="Next (Enter)"
                                AutomationProperties.Name="Next match"
                                Command="{Binding FindNextCommand}" />

                        <Button Grid.Column="4"
                                Style="{StaticResource SubtleIconButton}"
                                Content="&#xE711;"
                                FontSize="12"
                                ToolTip="Close find (Esc)"
                                AutomationProperties.Name="Close find"
                                Command="{Binding CloseFindCommand}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock behaviors:HighlightedText.Segments="{Binding DescriptionSegments}"
                                   TextWrapping="Wrap"
                                   Margin="0 0 12 0" />
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Style="{StaticResource ModalFooter}"
                    Grid.Row="2"
                    Margin="0 24 0 0">

                <Button x:Name="CloseButton"
                        Margin="24"
                        Width="160"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="Close"
                        Command="{Binding CloseCommand}" />
            </Border>
        </Grid>
    </shared:Surface>

</UserControl>
