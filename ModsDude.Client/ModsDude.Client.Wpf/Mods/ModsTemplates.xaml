<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:import="clr-namespace:ModsDude.Client.Wpf.Mods.Import"
                    xmlns:mods="clr-namespace:ModsDude.Client.Wpf.Mods">

    <DataTemplate DataType="{x:Type mods:RepoModsPageViewModel}">
        <mods:RepoModsPage />
    </DataTemplate>

    <DataTemplate DataType="{x:Type mods:ModDetailsModalViewModel}">
        <mods:ModDetailsModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type mods:ModDependentsModalViewModel}">
        <mods:ModDependentsModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type mods:ModVersionArbitrationModalViewModel}">
        <mods:ModVersionArbitrationModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type mods:ModVersionReorderModalViewModel}">
        <mods:ModVersionReorderModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type import:UnrecognisedFilesModalViewModel}">
        <import:UnrecognisedFilesModal />
    </DataTemplate>

</ResourceDictionary>
