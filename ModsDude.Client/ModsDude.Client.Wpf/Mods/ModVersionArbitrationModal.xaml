<UserControl x:Class="ModsDude.Client.Wpf.Mods.ModVersionArbitrationModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mods="clr-namespace:ModsDude.Client.Wpf.Mods"
             mc:Ignorable="d"
             Width="640" MaxHeight="700"
             d:DataContext="{d:DesignInstance Type=mods:ModVersionArbitrationModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <shared:Surface Style="{StaticResource ModalSurface}">

        <Grid RowDefinitions="auto * auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 12">
                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 12 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="24 0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Mods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type mods:ModVersionArbitrationItemViewModel}">
                            <StackPanel Margin="0 0 0 20">
                                <TextBlock Text="{Binding Name}"
                                           Margin="0 0 0 6"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                <mods:ModVersionOrderEditor DataContext="{Binding Order}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Style="{StaticResource ModalFooter}"
                    Grid.Row="2"
                    Margin="0 16 0 0">

                <Grid RowDefinitions="auto auto" Margin="24 16 24 20">

                    <!-- Said here rather than left for the button to imply: skipping costs the mods
                         in this modal and nothing else, and someone importing two thousand of them
                         should not have to guess that. -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding SkipMessage}"
                               TextWrapping="Wrap"
                               Margin="0 0 0 12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Grid Grid.Row="1" ColumnDefinitions="* *">
                        <Button Grid.Column="0"
                                Margin="0 0 4 0"
                                Style="{DynamicResource AccentButtonStyle}"
                                Content="Use this order"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ConfirmCommand}" />

                        <Button Grid.Column="1"
                                Margin="4 0 0 0"
                                Content="Skip"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SkipCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </shared:Surface>

</UserControl>
