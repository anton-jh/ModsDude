<UserControl x:Class="ModsDude.Client.Wpf.Mods.Import.LikelyCopiesModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:import="clr-namespace:ModsDude.Client.Wpf.Mods.Import"
             mc:Ignorable="d"
             Width="600" MaxHeight="700"
             d:DataContext="{d:DesignInstance Type=import:LikelyCopiesModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto auto * auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 12">
                <Grid ColumnDefinitions="auto *">
                    <TextBlock Grid.Column="0"
                               Text="&#xE7BA;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Margin="0 0 12 0"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Style="{StaticResource TitleTextBlockStyle}" />
                </Grid>

                <TextBlock Text="{Binding Message}"
                           Margin="0 12 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="24 0 24 6" ColumnDefinitions="* *">
                <TextBlock Grid.Column="0"
                           Text="File"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1"
                           Margin="12 0 0 0"
                           Text="Looks like a copy of"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ScrollViewer Grid.Row="2" Margin="24 0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type import:LikelyCopyItem}">
                            <Grid Margin="0 0 0 6" ColumnDefinitions="* *">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           ToolTip="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1"
                                           Margin="12 0 0 0"
                                           Text="{Binding Original}"
                                           ToolTip="{Binding Original}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Margin="0 16 0 0"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">

                <Grid ColumnDefinitions="* *" RowDefinitions="auto auto" Margin="24 16 24 20">
                    <Button Grid.Row="0" Grid.Column="0"
                            Margin="0 0 4 0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="{Binding LeaveOutText}"
                            HorizontalAlignment="Stretch"
                            IsDefault="True"
                            Command="{Binding LeaveOutCommand}" />

                    <Button Grid.Row="0" Grid.Column="1"
                            Margin="4 0 0 0"
                            Content="Import anyway"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ImportAnywayCommand}" />

                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Margin="4 6 0 0"
                               Text="{Binding ImportAnywayHint}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Style="{DynamicResource CaptionTextBlockStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

</UserControl>
