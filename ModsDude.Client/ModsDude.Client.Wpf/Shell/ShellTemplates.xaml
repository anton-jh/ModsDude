<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:accountBlock="clr-namespace:ModsDude.Client.Wpf.Shell.AccountBlock"
                    xmlns:modals="clr-namespace:ModsDude.Client.Wpf.Shell.Modals"
                    xmlns:offline="clr-namespace:ModsDude.Client.Wpf.Shell.Offline"
                    xmlns:shell="clr-namespace:ModsDude.Client.Wpf.Shell"
                    xmlns:updates="clr-namespace:ModsDude.Client.Wpf.Shell.Updates">

    <DataTemplate DataType="{x:Type shell:MainPageViewModel}">
        <shell:MainPage />
    </DataTemplate>

    <DataTemplate DataType="{x:Type updates:BuildMismatchViewModel}">
        <updates:BuildMismatchView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type accountBlock:AccountBlockedViewModel}">
        <accountBlock:AccountBlockedView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type offline:OfflineViewModel}">
        <offline:OfflineView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type modals:ModalViewModel}">
        <modals:Modal />
    </DataTemplate>

    <!-- Without its own template this would fall through to the base ModalViewModel one
         above and render as a confirmation modal. -->
    <DataTemplate DataType="{x:Type modals:ErrorModalViewModel}">
        <modals:ErrorModal />
    </DataTemplate>

    <DataTemplate DataType="{x:Type modals:WizardModalViewModel}">
        <modals:WizardModal />
    </DataTemplate>
    <DataTemplate DataType="{x:Type modals:QuestionStepViewModel}">
        <modals:QuestionStep />
    </DataTemplate>
    <DataTemplate DataType="{x:Type modals:ReviewStepViewModel}">
        <modals:ReviewStep />
    </DataTemplate>

</ResourceDictionary>
