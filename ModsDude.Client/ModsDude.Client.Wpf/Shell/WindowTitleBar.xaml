<UserControl x:Class="ModsDude.Client.Wpf.Shell.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:ModsDude.Client.Wpf.Shell"
             mc:Ignorable="d"
             d:DesignHeight="48" d:DesignWidth="800"
             Height="48">

    <!-- The window's title bar, drawn here rather than by Windows so it can be 48px tall - the height of
         Windows 11's own tall title bar, and roughly Chrome's. Windows draws its caption buttons at a fixed
         size that only fits its own thin bar, so the buttons are ours too.

         Everything outside the buttons is caption: the code-behind answers Windows' hit test for it, which
         is what gives dragging, double-click to maximise, and the system menu on right-click. -->
    <UserControl.Resources>

        <Style TargetType="shell:CaptionButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="shell:CaptionButton">
                        <Border x:Name="Surface" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsHovered" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPushed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>

                            <!-- Close is red, and white on it, whatever the theme - which is what Windows does. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsClose" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsClose" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#C83C31" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Dimmed while another window has the focus, like the title beside them. -->
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid ColumnDefinitions="auto * auto auto auto">

        <Image Grid.Column="0"
               Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
               Width="16" Height="16"
               Margin="16 0 12 0"
               VerticalAlignment="Center" />

        <TextBlock Grid.Column="1"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <shell:CaptionButton Grid.Column="2"
                          x:Name="MinimizeButton"
                          Content="&#xE921;"
                          Click="OnMinimize" />

        <shell:CaptionButton Grid.Column="3"
                          x:Name="MaximizeButton">
            <shell:CaptionButton.Style>
                <Style TargetType="shell:CaptionButton" BasedOn="{StaticResource {x:Type shell:CaptionButton}}">
                    <Setter Property="Content" Value="&#xE922;" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Content" Value="&#xE923;" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </shell:CaptionButton.Style>
        </shell:CaptionButton>

        <shell:CaptionButton Grid.Column="4"
                          x:Name="CloseButton"
                          Content="&#xE8BB;"
                          IsClose="True"
                          Click="OnClose" />
    </Grid>
</UserControl>
