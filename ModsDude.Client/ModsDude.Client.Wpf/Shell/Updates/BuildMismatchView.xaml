<UserControl x:Class="ModsDude.Client.Wpf.Shell.Updates.BuildMismatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:updates="clr-namespace:ModsDude.Client.Wpf.Shell.Updates"
             mc:Ignorable="d"
             Width="440"
             d:DataContext="{d:DesignInstance updates:BuildMismatchViewModel, IsDesignTimeCreatable=False}">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Grid RowDefinitions="* auto">
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="24 32 24 24">

                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0 0 0 24" />

                <Grid ColumnDefinitions="auto *" RowDefinitions="auto auto">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="This app"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0 0 24 8" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding ClientBuild}"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Server"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0 0 24 0" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding ServerBuild}"
                               FontWeight="SemiBold" />
                </Grid>

                <TextBlock Text="{Binding UpdateStatus}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0 24 0 0"
                           Visibility="{Binding IsClientBehind, Converter={StaticResource BoolToVisibilityConverter}}" />

            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24">
                    <Button Content="Restart to update"
                            Style="{DynamicResource AccentButtonStyle}"
                            Command="{Binding RestartCommand}"
                            Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Retry now"
                            Command="{Binding RetryCommand}"
                            Visibility="{Binding IsClientBehind, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
