<UserControl x:Class="ModsDude.Client.Wpf.Shell.Notices.NoticeRail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:notices="clr-namespace:ModsDude.Client.Wpf.Shell.Notices"
             xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=notices:NoticeCenterViewModel, IsDesignTimeCreatable=False}">

    <!-- The collapsed notice column: what is on screen while it is closed, so it carries enough to
         decide whether to open it - a count per severity, in words. Eye-catching by a glowing edge in
         the worst severity's colour and coloured counts, rather than by a tinted rail that would spend
         the loudest thing on screen on the difference between "look now" and "look". -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True" />
                        <Condition Binding="{Binding IsCollapsed}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Button Width="36"
            VerticalAlignment="Stretch"
            ToolTip="Show notices"
            Cursor="Hand"
            Command="{Binding ToggleCollapsedCommand}">

        <!-- Its own template: the theme's button centres its content in a padded, rounded box, which
             would float the edge in the middle of the rail and clip the rotated counts. -->
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Rail"
                        Background="{DynamicResource WindowBrush}"
                        BorderThickness="1 0 0 0"
                        BorderBrush="{DynamicResource ShellStrokeBrush}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Rail" Property="Background" Value="{DynamicResource ShellBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <Grid>
            <shared:Surface Width="3"
                            HorizontalAlignment="Left"
                            CornerRadius="0 2 2 0"
                            ShadowBlur="6"
                            ShadowOpacity="0.3">
                <shared:Surface.Style>
                    <Style TargetType="shared:Surface">
                        <Setter Property="Background" Value="{DynamicResource InfoBrush}" />
                        <Setter Property="ShadowColor" Value="{StaticResource InfoColor}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HighestSeverity}" Value="Critical">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Setter Property="ShadowColor" Value="{StaticResource CriticalColor}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestSeverity}" Value="Warning">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Setter Property="ShadowColor" Value="{StaticResource CautionColor}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HighestSeverity}" Value="Pending">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="ShadowColor" Value="{StaticResource AccentGlowColor}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </shared:Surface.Style>
            </shared:Surface>

            <StackPanel VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Margin="1 14 0 0">

                <TextBlock Text="&#xEA8F;"
                           HorizontalAlignment="Center"
                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Rotated rather than one glyph per line: the counts are words, and a column of
                     single letters is a puzzle. Top to bottom, the direction a rail on the right edge
                     is read in. The width is the pre-rotation one, so it is the height this ends up
                     taking: without it LayoutTransform measures the text against the rail's own width
                     before turning it, and every label is clipped. -->
                <ItemsControl ItemsSource="{Binding SeverityCounts}"
                              Width="260"
                              Margin="0 12 0 0"
                              HorizontalAlignment="Center"
                              Focusable="False">
                    <ItemsControl.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </ItemsControl.LayoutTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0 0 6 0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
