<UserControl x:Class="ModsDude.Client.Wpf.Shell.Notices.NoticeColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:notices="clr-namespace:ModsDude.Client.Wpf.Shell.Notices"
             xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=notices:NoticeCenterViewModel, IsDesignTimeCreatable=False}">

    <!-- The open notice column: every background problem, each one a card, on a layer laid over the
         page's right edge (see MainWindow). Everything in it is visible from every view and stops
         nobody working. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True" />
                        <Condition Binding="{Binding IsCollapsed}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <shared:Surface Style="{StaticResource ContentPane}" Padding="12 14 12 12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- What belongs to the column rather than to any card in it. Collapsing lives here so that
                 the button which closes it is where the user is already looking. -->
            <Grid Grid.Row="0" Margin="4 0 0 12" ColumnDefinitions="auto * auto">
                <TextBlock Grid.Column="0"
                           Text="NOTICES"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionCaption}" />

                <ItemsControl Grid.Column="1"
                              Margin="12 0 0 0"
                              VerticalAlignment="Center"
                              Focusable="False"
                              ItemsSource="{Binding SeverityCounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0 0 6 0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <Button Grid.Column="2"
                        Content="&#xE76C;"
                        FontSize="12"
                        Style="{StaticResource SubtleIconButton}"
                        ToolTip="Collapse. A notice you have not seen opens it again."
                        Command="{Binding ToggleCollapsedCommand}" />
            </Grid>

            <!-- Top-anchored, under the header: a panel mostly empty above its contents reads as
                 something that failed to load. -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Notices}"
                              Focusable="False"
                              VerticalAlignment="Top" />
            </ScrollViewer>

            <!-- The tail the column is holding back, and the one gesture for the morning after an
                 update-all that touched every game on the machine. -->
            <Border Grid.Row="2"
                    Margin="-12 2 -12 -12"
                    Padding="10 8"
                    BorderThickness="0 1 0 0"
                    BorderBrush="{DynamicResource ContentStrokeBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasOverflow}" Value="False" />
                                    <Condition Binding="{Binding CanDismissAll}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid ColumnDefinitions="* auto">
                    <Button Grid.Column="0"
                            Content="{Binding Overflow}"
                            Style="{StaticResource SubtleTextButton}"
                            Command="{Binding ToggleShowAllCommand}"
                            Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Button Grid.Column="1"
                            Content="Dismiss all"
                            Style="{StaticResource SubtleTextButton}"
                            Command="{Binding DismissAllCommand}"
                            Visibility="{Binding CanDismissAll, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
    </shared:Surface>
</UserControl>
