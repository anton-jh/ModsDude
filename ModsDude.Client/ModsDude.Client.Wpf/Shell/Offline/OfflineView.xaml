<UserControl x:Class="ModsDude.Client.Wpf.Shell.Offline.OfflineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:offline="clr-namespace:ModsDude.Client.Wpf.Shell.Offline"
             mc:Ignorable="d"
             Width="440"
             d:DataContext="{d:DesignInstance offline:OfflineViewModel, IsDesignTimeCreatable=False}">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Grid RowDefinitions="* auto">
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="24 32 24 24">

                <TextBlock Text="Offline"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0 0 0 24" />

                <Grid ColumnDefinitions="auto *" RowDefinitions="auto auto auto">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Server"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0 0 24 8" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="Not answering"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Attempts"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0 0 24 8" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding Attempts}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Next attempt"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0 0 24 0" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding NextAttempt}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Grid>

            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24">
                    <Button Content="Retry now"
                            Style="{DynamicResource AccentButtonStyle}"
                            Command="{Binding RetryNowCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
