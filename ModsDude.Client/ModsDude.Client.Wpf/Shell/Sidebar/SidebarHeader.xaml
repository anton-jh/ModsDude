<UserControl x:Class="ModsDude.Client.Wpf.Shell.Sidebar.SidebarHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sidebar="clr-namespace:ModsDude.Client.Wpf.Shell.Sidebar"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=sidebar:SidebarHeader, IsDesignTimeCreatable=True}">

    <Grid ColumnDefinitions="* auto auto" Margin="0 32 0 0">
        <Grid.RowDefinitions>
            <!-- As tall as the buttons make it, whether or not they are drawn, so every header is the same height. -->
            <RowDefinition Height="Auto" MinHeight="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Margin="16 0 0 4"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   FontSize="12"
                   Opacity="0.7"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- Creating one of what the list below holds. It is a page like any other, so while that page
             is open the button is drawn the way a selected row is: the sidebar always says where you are,
             and this is the one place it would otherwise go quiet. The tooltip is the item's own, which
             is the reason where the membership level does not allow it - and it shows on the disabled
             button for the same reason the rows' tooltips do. -->
        <Border Grid.Column="1" Grid.Row="0"
                Margin="8 0 0 4"
                CornerRadius="4"
                VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAddSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Button Style="{StaticResource SubtleIconButton}"
                    Width="26" Height="26"
                    Command="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    IsEnabled="{Binding IsAddEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTip="{Binding AddToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTipService.InitialShowDelay="200">
                <TextBlock Text="&#xE710;" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAddEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </Border>

        <!-- Null draws no button at all, which is every header with nothing to refresh. -->
        <Button Grid.Column="2" Grid.Row="0"
                Margin="4 0 16 4"
                VerticalAlignment="Center"
                Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ToolTip="{Binding ActionToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ToolTipService.InitialShowDelay="200"
                Background="Transparent"
                BorderThickness="0"
                Padding="4"
                MinWidth="0"
                MinHeight="0">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <!-- With changes waiting on the server the glyph takes the accent and a dot sits on its corner, so
                 the button reads as something to press rather than something that is always there. -->
            <Grid>
                <TextBlock Text="{Binding ActionIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingChanges, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Ellipse Width="6" Height="6"
                         Margin="0 -3 -3 0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                         IsHitTestVisible="False"
                         Visibility="{Binding HasPendingChanges, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Button>

        <Separator Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                   Foreground="{DynamicResource DividerStrokeColorDefaultBrush}"
                   Margin="4 4" />

    </Grid>

</UserControl>
