<Window x:Class="ModsDude.Client.Wpf.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:backgroundtasks="clr-namespace:ModsDude.Client.Wpf.Shell.BackgroundTasks"
        xmlns:notices="clr-namespace:ModsDude.Client.Wpf.Shell.Notices"
        xmlns:shell="clr-namespace:ModsDude.Client.Wpf.Shell"
        xmlns:toasts="clr-namespace:ModsDude.Client.Wpf.Shell.Toasts"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=shell:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="ModsDude" Width="1600" Height="900" MinWidth="1000"
        Icon="/Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontSize="14">

    <!-- The title bar is ours - see WindowTitleBar. A caption height of zero hands the whole client area to
         WPF, and the bar tells Windows which of its pixels are caption. The one-pixel glass frame is what
         keeps Windows' shadow and rounded corners on a window with no frame of its own. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="0 0 0 1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Margined by the code-behind while maximised: a window without a frame still gets maximised as if it
         had one, so its outer edge hangs off every side of the screen by the frame's width.
         Opaque, because the theme's backdrop extends the glass frame over the whole window, and Windows
         draws its own caption buttons into it wherever the window is see-through. -->
    <Grid x:Name="Root" RowDefinitions="auto *" Background="{DynamicResource WindowBrush}">

    <shell:WindowTitleBar Grid.Row="0" />

    <Grid Grid.Row="1">
        <!-- The rail is a real column of the window, so the content area genuinely ends where it
             begins and nothing is ever drawn underneath it. It is Auto and collapses to nothing
             while there is nothing to say, which is most of the time.

             The expanded panel is an overlay inside column 0 instead, and that asymmetry is
             deliberate: it opens uninvited - a notice the user has not seen re-opens it - and taking
             420px out of a mod list mid-scroll would recompute every column width and re-wrap every
             row under somebody's hands. A rail appearing is narrow and stable; a panel appearing is
             sudden and temporary, so it floats and casts a shadow. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Frame Grid.Column="0"
               Content="{Binding Path=CurrentPage}"
               NavigationUIVisibility="Hidden" />

        <notices:NoticeColumn Grid.Column="0"
                              HorizontalAlignment="Right"
                              Width="420"
                              DataContext="{Binding Notices}" />

        <notices:NoticeRail Grid.Column="1" DataContext="{Binding Notices}" />

        <!-- Over the page and the notices both: nothing on them works while the server does not answer.
             Under the progress strip, so work already running can still be cancelled. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="{DynamicResource WindowBrush}"
              Visibility="{Binding Offline.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <ContentControl Content="{Binding Offline}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

        </Grid>

        <!-- Along the top edge, and about the present rather than the past: notices and toasts report
             something that has already happened, so this one is somewhere else on purpose. It survives
             navigation - an import queued on one page is still visible from another - which is the half
             a page's own progress cannot do. Nothing to dismiss: it goes when the work does.

             A fixed width rather than one sized to its text: the widest line is a subtask name or a
             phase, both of which change every few seconds, and a strip that follows them breathes.
             Long lines trim instead. -->
        <shared:Surface Style="{StaticResource FloatingSurface}"
                        Grid.Column="0"
                        DataContext="{Binding BackgroundTasks}"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Width="520"
                        Margin="0 4 0 0"
                        Padding="16 10">

            <StackPanel Orientation="Vertical">

                <Grid ColumnDefinitions="* auto auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               ToolTip="{Binding Title}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <!-- One task at a time, with the others an arrow away rather than a second bar
                         racing this one. Nothing pages itself: a task starting while somebody is
                         watching another leaves a dot here instead of taking the strip. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="12 0 0 0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="&#x2039;"
                                Padding="6 0"
                                MinWidth="0"
                                Command="{Binding PreviousCommand}"
                                IsEnabled="{Binding CanGoPrevious}" />

                        <TextBlock Text="{Binding PagerText}"
                                   Margin="6 0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <Ellipse Width="6" Height="6"
                                 Margin="0 0 6 0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                 Visibility="{Binding HasUnseen, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Button Content="&#x203a;"
                                Padding="6 0"
                                MinWidth="0"
                                Command="{Binding NextCommand}"
                                IsEnabled="{Binding CanGoNext}" />
                    </StackPanel>

                    <!-- The only control on the strip, and only for the task on screen - which is why
                         the pager beside it matters. It has to live here rather than on the page that
                         started the job: a page is rebuilt from scratch on every navigation, so the
                         Cancel somebody had disappears the moment they use the freedom this strip
                         exists to give them. It asks rather than kills - a sync stops at the next file
                         - so the entry stays up until the work unwinds, which is why the button goes
                         away on the first press rather than inviting a second.

                         Greyed rather than hidden for the second after a task ends underneath it: a
                         click aimed at work that has just finished must not land on its neighbour,
                         and a button that vanished would move everything beside it. -->
                    <Button Grid.Column="2"
                            Content="Cancel"
                            Margin="12 0 0 0"
                            Padding="10 2"
                            VerticalAlignment="Center"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsCancelEnabled}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <!-- What the task said on the left, and how long it reckons is left on the right. The
                     estimate is its own column so a long detail trims instead of pushing it off. -->
                <Grid ColumnDefinitions="* auto"
                      Margin="0 2 0 0"
                      Visibility="{Binding HasStatusLine, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Detail}"
                               TextTrimming="CharacterEllipsis"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Remaining}"
                               Margin="12 0 0 0"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <!-- Only for work that moves bytes while a speed limit is set, so a slow transfer
                     explains itself. Quieter than the detail above: it is why, not what. -->
                <TextBlock Text="{Binding Limit}"
                           Margin="0 2 0 0"
                           TextTrimming="CharacterEllipsis"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasLimit, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ProgressBar Height="5"
                             Margin="0 8 0 0"
                             Minimum="0" Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}" />

                <!-- Only the parts that have been going long enough to be worth naming. The fast ones
                     are the count on the line above: five names cycling through one line is what this
                     replaced, and five rows cycling would be that plus a strip that changes height. -->
                <ItemsControl ItemsSource="{Binding Subtasks}"
                              Margin="0 8 0 0"
                              Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type backgroundtasks:BackgroundSubtaskViewModel}">
                            <StackPanel Margin="0 0 0 6">
                                <Grid ColumnDefinitions="* auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Amount}"
                                               Margin="12 0 0 0"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding HasAmount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>

                                <ProgressBar Height="4"
                                             Margin="0 3 0 0"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding MoreSubtasks}"
                           TextTrimming="CharacterEllipsis"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasMoreSubtasks, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </shared:Surface>

        <!-- Over the page and the notices both: nothing on them works while the server refuses this build. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="{DynamicResource WindowBrush}"
              Visibility="{Binding BuildMismatch.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <ContentControl Content="{Binding BuildMismatch}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

        </Grid>

        <!-- Over the page and the notices both: nothing on them works while the account is blocked. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="{DynamicResource WindowBrush}"
              Visibility="{Binding AccountBlocked.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <ContentControl Content="{Binding AccountBlocked}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

        </Grid>

        <!-- Over the page and the notices both: nothing on them works until the user signs in again. -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="{DynamicResource WindowBrush}"
              Visibility="{Binding SignInRequired.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <ContentControl Content="{Binding SignInRequired}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

        </Grid>

        <!-- A press and release both on the scrim dismiss the modal; see MainWindow.OnScrimMouseUp. -->
        <Grid x:Name="ModalScrim"
              Grid.Column="0" Grid.ColumnSpan="2"
              Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding IsModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              MouseLeftButtonDown="OnScrimMouseDown"
              MouseLeftButtonUp="OnScrimMouseUp">

            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <ContentControl Content="{Binding Modal}" />

                <!-- Over the modal's top-right corner. A dismissable modal keeps its header 56 clear
                     on the right for it. -->

                <Button Style="{StaticResource SubtleIconButton}"
                        Content="&#xE711;"
                        FontSize="12"
                        Margin="0 8 8 0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ToolTip="Close"
                        AutomationProperties.Name="Close"
                        Command="{Binding DismissModalCommand}"
                        Visibility="{Binding Modal.IsDismissable, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
            </Grid>

        </Grid>

        <!-- Last, so it is on top of the modal layer as well: a result reported while a modal is open
             should still be seen. Bottom centre of the window rather than of a page, which is what
             lets any page or service use it without knowing where it is drawn. -->
        <toasts:ToastHost Grid.Column="0" Grid.ColumnSpan="2"
                      DataContext="{Binding Toasts}" />
    </Grid>

    </Grid>

</Window>
