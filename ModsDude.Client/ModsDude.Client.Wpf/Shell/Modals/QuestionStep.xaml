<UserControl x:Class="ModsDude.Client.Wpf.Shell.Modals.QuestionStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:modals="clr-namespace:ModsDude.Client.Wpf.Shell.Modals"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=modals:QuestionStepViewModel, IsDesignTimeCreatable=False}">

    <TextBlock Text="{Binding Message}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

</UserControl>
