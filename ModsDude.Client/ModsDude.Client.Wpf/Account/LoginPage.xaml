<shared:AppPage x:Class="ModsDude.Client.Wpf.Account.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
      xmlns:account="clr-namespace:ModsDude.Client.Wpf.Account"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance account:LoginPageViewModel, IsDesignTimeCreatable=False}"
      Title="LoginPage">

    <Border Width="440"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Grid RowDefinitions="* auto">
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="24 32 24 24">

                <TextBlock Text="Sign in"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Margin="0 0 0 24" />

                <Grid ColumnDefinitions="auto *">
                    <TextBlock Grid.Column="0"
                               Text="Status"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0 0 24 0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               FontWeight="SemiBold" />
                </Grid>

            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24">
                    <Button Content="Create account"
                            Command="{Binding CreateAccountCommand}"
                            Margin="0 0 8 0" />
                    <Button Content="Sign in"
                            Style="{DynamicResource AccentButtonStyle}"
                            Command="{Binding SignInCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</shared:AppPage>
