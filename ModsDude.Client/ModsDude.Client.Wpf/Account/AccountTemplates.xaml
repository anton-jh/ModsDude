<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:account="clr-namespace:ModsDude.Client.Wpf.Account">

    <DataTemplate DataType="{x:Type account:WelcomePageViewModel}">
        <account:WelcomePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type account:LoginPageViewModel}">
        <account:LoginPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type account:AccountPageViewModel}">
        <account:AccountPage />
    </DataTemplate>

</ResourceDictionary>
