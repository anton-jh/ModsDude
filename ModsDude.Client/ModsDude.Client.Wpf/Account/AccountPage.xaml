<Page x:Class="ModsDude.Client.Wpf.Account.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:account="clr-namespace:ModsDude.Client.Wpf.Account"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance account:AccountPageViewModel, IsDesignTimeCreatable=False}"
      Title="AccountPage">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Account" />

                <!-- How everybody else sees you. Both change here, for every teammate, at once. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="Profile" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="Your name and picture are what everybody in your repos sees beside the things you do." />

                            <StackPanel Orientation="Horizontal" Margin="0 16 0 0">

                                <!-- Held back until the server has answered, like the sidebar's, rather
                                     than drawn in a colour about to change. -->
                                <Grid Width="96" Height="96">
                                    <account:UserAvatar Width="96" Height="96" FontSize="40"
                                                   DataContext="{Binding Account.Avatar}"
                                                   Visibility="{Binding DataContext.Account.HasAvatar, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>

                                <StackPanel Orientation="Vertical" Margin="16 0 0 0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Change picture" Command="{Binding ChangePictureCommand}" />
                                        <Button Content="Remove picture" Margin="8 0 0 0" Command="{Binding RemovePictureCommand}" />
                                    </StackPanel>

                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
                                               Margin="0 8 0 0"
                                               Text="The middle of the picture is cut to a square. Without one, you are your initial on your own colour." />
                                </StackPanel>
                            </StackPanel>

                            <Label Content="Name" Margin="0 24 0 8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="320"
                                         MaxLength="64"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Save" Margin="8 0 0 0"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        IsDefault="True"
                                        Command="{Binding SaveNameCommand}" />
                            </StackPanel>

                            <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Margin="0 8 0 0"
                                       Text="{Binding NameError}"
                                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Said here because it is the question a rename raises: what if somebody
                                 else is already called that. Nothing happens - the tag tells them apart. -->
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Margin="0 8 0 0">
                                <Run Text="Names do not have to be unique. Where two people in a list share one, each is shown with their tag - yours is" />
                                <Run Text="{Binding Account.Tag, Mode=OneWay}" FontFamily="Consolas" /><Run Text="." />
                            </TextBlock>

                        </StackPanel>
                    </GroupBox>
                </Border>

                <!-- The account itself, which belongs to the sign-in provider rather than to ModsDude. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Sign-in" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="Signed in as" />
                                <Run Text="{Binding Account.Email, Mode=OneWay}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </TextBlock>

                            <Label Content="Password" Margin="0 24 0 8" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="This opens the sign-in page in your browser. Choose &quot;Forgot password?&quot; there, and you will be emailed a code to set a new one." />
                            <Button Content="Change password" Margin="0 12 0 0" HorizontalAlignment="Left"
                                    Command="{Binding ResetPasswordCommand}" />

                            <Label Content="Switch user" Margin="0 24 0 8" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="Sign in as somebody else. You stay signed in as yourself until the new sign-in finishes." />
                            <Button Content="Switch user" Margin="0 12 0 0" HorizontalAlignment="Left"
                                    Command="{Binding Account.SwitchUserCommand}" />

                        </StackPanel>
                    </GroupBox>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
