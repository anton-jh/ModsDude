<shared:AppPage x:Class="ModsDude.Client.Wpf.Account.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
      xmlns:account="clr-namespace:ModsDude.Client.Wpf.Account"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance account:AccountPageViewModel, IsDesignTimeCreatable=False}"
      Title="AccountPage">

    <shared:Surface Style="{StaticResource PagePane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Account" />

                <!-- How everybody else sees you. Both change here, for every teammate, at once. -->
                <shared:Surface Style="{StaticResource Card}">
                    <GroupBox Header="Name and picture" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <StackPanel Orientation="Horizontal">

                                <!-- Held back until the server has answered, like the sidebar's, rather
                                     than drawn in a colour about to change. -->
                                <Grid Width="96" Height="96">
                                    <account:UserAvatar Width="96" Height="96" FontSize="40"
                                                   DataContext="{Binding Account.Avatar}"
                                                   Visibility="{Binding DataContext.Account.HasAvatar, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>

                                <StackPanel Orientation="Vertical" Margin="16 0 0 0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Change picture" Command="{Binding ChangePictureCommand}" />
                                        <Button Content="Remove picture" Margin="8 0 0 0" Command="{Binding RemovePictureCommand}" />
                                    </StackPanel>

                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0 8 0 0"
                                               Text="Cropped to a square" />
                                </StackPanel>
                            </StackPanel>

                            <Label Content="Name" Margin="0 24 0 8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="320"
                                         MaxLength="64"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Save" Margin="8 0 0 0"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        IsDefault="True"
                                        Command="{Binding SaveNameCommand}" />
                            </StackPanel>

                            <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Margin="0 8 0 0"
                                       Text="{Binding NameError}"
                                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Names need not be unique: the tag tells people with the same name apart. -->
                            <Label Content="Tag" Margin="0 24 0 8" />
                            <TextBlock FontFamily="Consolas" Text="{Binding Account.TagText}" />

                        </StackPanel>
                    </GroupBox>
                </shared:Surface>

                <!-- How the user signs in. Changed on the server's account pages, in the browser. -->
                <shared:Surface Style="{StaticResource Card}" Margin="0 16 0 0">
                    <GroupBox Header="Sign-in" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="Signed in as" />
                                <Run Text="{Binding Email, Mode=OneWay}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Margin="0 16 0 0">
                                <Button Content="Change password" Margin="0 0 8 0"
                                        Command="{Binding ChangePasswordCommand}" />
                                <Button Content="Change email"
                                        Command="{Binding ChangeEmailCommand}" />
                            </StackPanel>

                            <Button Content="Switch user" Margin="0 24 0 0" HorizontalAlignment="Left"
                                    Command="{Binding Account.SwitchUserCommand}" />

                        </StackPanel>
                    </GroupBox>
                </shared:Surface>

            </StackPanel>
        </ScrollViewer>
    </shared:Surface>
</shared:AppPage>
