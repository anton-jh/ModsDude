{
  "ModsDudeServer": {
    "BaseUrl": "http://localhost:5267"
  },
  // Trace, Debug, Information, Warning, Error or Critical. Information is enough to see every
  // failure; Debug adds what succeeded, which is what tells "published nothing" apart from
  // "had nothing to publish". Written to %LocalAppData%\ModsDude\logs.
  "Logging": {
    "MinimumLevel": "Information"
  }
}
