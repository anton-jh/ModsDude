{
  "ModsDudeServer": {
    "BaseUrl": "http://localhost:5267"
  },
  // Where an installed copy looks for a newer version: the releases of this public repo. Only an
  // installed copy ever does. "Directory" reads releases from a folder instead, for trying an update
  // without publishing one.
  "Updates": {
    "GithubRepository": "https://github.com/anton-jh/ModsDude"
  },
  // Trace, Debug, Information, Warning, Error or Critical. Information is enough to see every
  // failure; Debug adds what succeeded, which is what tells "published nothing" apart from
  // "had nothing to publish". Written to %LocalAppData%\ModsDude\logs.
  "Logging": {
    "MinimumLevel": "Information"
  }
}
