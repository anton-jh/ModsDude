<Page x:Class="ModsDude.Client.Wpf.Home.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:friends="clr-namespace:ModsDude.Client.Wpf.Friends"
      xmlns:home="clr-namespace:ModsDude.Client.Wpf.Home"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      d:DataContext="{d:DesignInstance Type=home:HomePageViewModel, IsDesignTimeCreatable=False}"
      Title="HomePage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Home" />

                <!-- Nothing to show anywhere until there is a repo. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Visibility="{Binding HasNoRepos, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="You are not in any repo yet." />
                        <Button Margin="0 12 0 0"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource AccentButtonStyle}"
                                Content="Join or create"
                                Command="{Binding JoinOrCreateCommand}" />
                    </StackPanel>
                </Border>

                <!-- Friends on the left, because joining one is what the page is for; this machine on the right. -->
                <Grid Visibility="{Binding HasRepos, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="16">
                        <GroupBox Header="Friends" Padding="0 16 0 0">
                            <friends:FriendActivityList DataContext="{Binding Friends}" />
                        </GroupBox>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16 0 0 0" Orientation="Vertical">

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="16">
                            <GroupBox Header="Your games" Padding="0 16 0 0">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Text="No game is connected on this machine." />

                                    <ItemsControl ItemsSource="{Binding Games}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type home:HomeGameViewModel}">
                                                <Button Margin="-10 0 -10 4"
                                                        Style="{StaticResource SubtleMenuButton}"
                                                        IsEnabled="{Binding HasProfile}"
                                                        Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding ProfileText, Mode=OneWay}" /><Run Text="{Binding RepoName, Mode=OneWay, StringFormat=' · {0}'}" />
                                                        </TextBlock>
                                                        <WrapPanel Margin="0 6 0 0" Orientation="Horizontal">
                                                            <Border Margin="0 0 6 0"
                                                                    Style="{StaticResource SuccessStatusChip}"
                                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Running" />
                                                            </Border>
                                                            <Border Margin="0 0 6 0"
                                                                    Style="{StaticResource ProfileSyncChip}"
                                                                    Visibility="{Binding HasSyncState, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="{Binding SyncLabel}" />
                                                            </Border>
                                                            <Border Margin="0 0 6 0"
                                                                    Style="{StaticResource StatusChip}"
                                                                    Visibility="{Binding IsHolding, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="{Binding HoldingText}" />
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </GroupBox>
                        </Border>

                        <Border Margin="0 16 0 0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="16">
                            <GroupBox Header="Your savegames" Padding="0 16 0 0">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasNoSavegames, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Text="No savegame is checked out on this machine." />

                                    <ItemsControl ItemsSource="{Binding Savegames}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type home:HomeSavegameViewModel}">
                                                <Grid Margin="0 0 0 12" ColumnDefinitions="* auto">
                                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Where}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Margin="12 0 0 0"
                                                            VerticalAlignment="Center"
                                                            Content="Check in"
                                                            IsEnabled="{Binding CanCheckIn}"
                                                            Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </GroupBox>
                        </Border>

                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
