<UserControl x:Class="ModsDude.Client.Wpf.Savegames.SavegameSlotPickerStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:savegames="clr-namespace:ModsDude.Client.Wpf.Savegames"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=savegames:SavegameSlotPickerStepViewModel, IsDesignTimeCreatable=False}">

    <StackPanel>

        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- The same list, drawn the same way, as the check-out step's: rows with a hairline under
             them inside a frame, scrolling by the pixel. -->
        <Border Margin="0 16 0 0"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <ListBox MaxHeight="400"
                     Style="{StaticResource SlotList}"
                     HorizontalContentAlignment="Stretch"
                     ItemsSource="{Binding Slots}"
                     SelectedItem="{Binding SelectedSlot, Mode=TwoWay}">
                <!-- Headed by folder only where the game reaches more than one of them: the view
                     carries no grouping at all otherwise, so a game with one savegame folder
                     shows a plain list. -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0 8 0 2"
                                           Text="{Binding Name}"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type savegames:SavegameSlotOptionViewModel}">
                        <Grid Margin="12 8" ColumnDefinitions="auto *" ToolTip="{Binding ToolTip}">
                            <savegames:SlotBadge Grid.Column="0"
                                                 Margin="0 0 12 0"
                                                 VerticalAlignment="Center"
                                                 Number="{Binding Number}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                <TextBlock Margin="0 2 0 0"
                                           TextWrapping="Wrap"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Detail}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </StackPanel>

</UserControl>
