<UserControl x:Class="ModsDude.Client.Wpf.Savegames.SavegameCheckOutStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:savegames="clr-namespace:ModsDude.Client.Wpf.Savegames"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=savegames:SavegameCheckOutStepViewModel, IsDesignTimeCreatable=False}">

    <StackPanel>

        <TextBlock Text="{Binding Intro}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- Mods. One line where the folder is already right, which is the common case and
             the one that must not read like a form. -->
        <StackPanel Margin="0 20 0 0"
                    Visibility="{Binding ShowModsSection, Converter={StaticResource BoolToVisibilityConverter}}">

            <TextBlock Text="Mods"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <TextBlock Margin="0 4 0 0"
                       TextWrapping="Wrap"
                       Text="{Binding Mods.Text}" />

            <!-- Named rather than counted. This is the moment a map at the wrong version stops
                 being untidy and starts being a damaged save. -->
            <TextBlock Margin="0 4 0 0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{Binding Mods.LockedText}"
                       Visibility="{Binding Mods.HasLocked, Converter={StaticResource BoolToVisibilityConverter}}" />

            <TextBlock Margin="0 4 0 0"
                       TextWrapping="Wrap"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Mods.Consequence}"
                       Visibility="{Binding Mods.HasConsequence, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- Slot. Shown on every check-out: the remembered one pre-selects it, it never
             decides it. One flat list across every savegame folder the game reaches, with a
             folder heading only where there is more than one - there is no game step above
             it, because a machine has one installation of the game a repo is about. -->
        <StackPanel Margin="0 20 0 0">

            <TextBlock Text="Slot"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <TextBlock Margin="0 4 0 0"
                       TextWrapping="Wrap"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding SlotNote}"
                       Visibility="{Binding HasSlotNote, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- The pre-selected row and a way to change it. -->
            <Grid Margin="0 8 0 0"
                  ColumnDefinitions="* auto"
                  Visibility="{Binding ShowPreselection, Converter={StaticResource BoolToVisibilityConverter}}">

                <Grid Grid.Column="0" DataContext="{Binding SelectedSlot}" ColumnDefinitions="auto *">
                    <!-- The slot's number first and largest: in a game with twenty numbered slots
                         it is often how the player picks a save out. Absent for a game whose
                         slots are not numbered. -->
                    <savegames:SlotBadge Grid.Column="0"
                                         Margin="0 0 12 0"
                                         VerticalAlignment="Top"
                                         Number="{Binding Number}" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Label}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{DynamicResource BodyStrongTextBlockStyle}" />

                        <TextBlock Margin="0 2 0 0"
                                   TextWrapping="Wrap"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Detail}" />
                    </StackPanel>
                </Grid>

                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        Style="{DynamicResource SubtleMenuButton}"
                        Content="Change"
                        Command="{Binding ChangeSlotCommand}" />
            </Grid>

            <!-- Drawn as the mod lists and the savegame log are - a row with a hairline under it,
                 inside a frame - and tall enough that more of twenty slots is in view at once. It
                 scrolls by the pixel (see SlotList). -->
            <Border Margin="0 8 0 0"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="{Binding ShowAllSlots, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox MaxHeight="360"
                         Style="{StaticResource SlotList}"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding Slots}"
                         SelectedItem="{Binding SelectedSlot, Mode=TwoWay}">
                    <!-- Headed by folder only where the game reaches more than one of them: the
                         view carries no grouping at all otherwise. -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0 8 0 2"
                                               Text="{Binding Name}"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type savegames:SavegameSlotOptionViewModel}">
                            <Grid Margin="12 8" ColumnDefinitions="auto *" ToolTip="{Binding ToolTip}">
                                <savegames:SlotBadge Grid.Column="0"
                                                     Margin="0 0 12 0"
                                                     VerticalAlignment="Center"
                                                     Number="{Binding Number}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                    <TextBlock Margin="0 2 0 0"
                                               TextWrapping="Wrap"
                                               Text="{Binding Detail}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <!-- A refused row says so in its own colour rather
                                                         than looking like every other option and then
                                                         refusing the button. -->
                                                    <DataTrigger Binding="{Binding IsRefused}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Margin="0 8 0 0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{Binding SlotWarning}"
                       Visibility="{Binding HasSlotWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- Revision. Absent where the save's own revision is the profile's current one. -->
        <StackPanel Margin="0 20 0 0"
                    Visibility="{Binding ShowRevisionSection, Converter={StaticResource BoolToVisibilityConverter}}">

            <TextBlock Text="Revision"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <!-- Which mod list the folder ends up on, shown whether or not anything is wrong:
                 on latest the number can differ from the one it was last played on, and in
                 compatibility mode it is the number that does not move. -->
            <TextBlock Margin="0 4 0 0"
                       TextWrapping="Wrap"
                       Text="{Binding RunsOn}"
                       Visibility="{Binding HasRunsOn, Converter={StaticResource BoolToVisibilityConverter}}" />

            <TextBlock Margin="0 4 0 0"
                       TextWrapping="Wrap"
                       Text="{Binding Revision.Text}"
                       Visibility="{Binding ShowRevisionNote, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Revision.IsCaution}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </StackPanel>

</UserControl>
