<UserControl x:Class="ModsDude.Client.Wpf.Savegames.SavegameModCheckStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:savegames="clr-namespace:ModsDude.Client.Wpf.Savegames"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=savegames:SavegameModCheckStepViewModel, IsDesignTimeCreatable=False}">

    <StackPanel>

        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Margin="0 16 0 0" ColumnDefinitions="auto *" RowDefinitions="auto auto auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Not in profile" />
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"
                       Text="{Binding NotInProfile.Value}" ToolTip="{Binding NotInProfile.ToolTip}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Not in savegame" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                       Text="{Binding NotInSavegame.Value}" ToolTip="{Binding NotInSavegame.ToolTip}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Other version" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"
                       Text="{Binding OtherVersion.Value}" ToolTip="{Binding OtherVersion.ToolTip}" />
        </Grid>

        <StackPanel Margin="0 16 0 0"
                    Visibility="{Binding HasLocked, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Locked mods"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ItemsControl Margin="0 4 0 0" ItemsSource="{Binding LockedMods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0 2 0 0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </StackPanel>

</UserControl>
