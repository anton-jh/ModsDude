<UserControl x:Class="ModsDude.Client.Wpf.Savegames.SavegameCompatibilityModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:savegames="clr-namespace:ModsDude.Client.Wpf.Savegames"
             mc:Ignorable="d"
             Width="480"
             d:DataContext="{d:DesignInstance Type=savegames:SavegameCompatibilityModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 16">

                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Intro}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Grid Margin="0 16 0 0" ColumnDefinitions="auto *" RowDefinitions="auto auto auto auto auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Last played on" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding PlayedText}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Latest" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LatestText}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Added" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding AddedCount}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Removed" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding RemovedCount}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Changed" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding ChangedCount}" />
                </Grid>

                <!-- Named rather than counted: a locked mod moving is what damages a save. -->
                <StackPanel Margin="0 16 0 0"
                            Visibility="{Binding HasLockedChanges, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="Locked mods"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <ItemsControl Margin="0 4 0 0" ItemsSource="{Binding LockedChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0 2 0 0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid Margin="24 16 24 20" ColumnDefinitions="* * auto">
                    <Button Grid.Column="0"
                            Margin="0 0 8 0"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="Compatibility mode"
                            IsDefault="True"
                            Command="{Binding UseCompatibilityModeCommand}" />

                    <Button Grid.Column="1"
                            Margin="0 0 8 0"
                            HorizontalAlignment="Stretch"
                            Content="Latest"
                            Command="{Binding UseLatestCommand}" />

                    <Button Grid.Column="2"
                            Content="Cancel"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

</UserControl>
