<shared:AppPage x:Class="ModsDude.Client.Wpf.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:settings="clr-namespace:ModsDude.Client.Wpf.Settings"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance settings:SettingsPageViewModel, IsDesignTimeCreatable=False}"
      Title="SettingsPage">

    <shared:Surface Style="{StaticResource ContentPane}">
        <Grid RowDefinitions="*, auto">

            <Border Style="{StaticResource PageBody}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                        <navigation:PageTitle Text="Settings" />

                        <shared:Surface Style="{StaticResource Card}">
                            <GroupBox Header="Mod storage" Padding="0 16 0 16">
                                <StackPanel Orientation="Vertical">

                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                               Text="Each disk with mod folders keeps downloaded mods in a store: its own, or one on another disk." />

                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                               Margin="0 16 0 0"
                                               Visibility="{Binding HasNoVolumes, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Text="No mod folders. Connect a game first." />

                                    <ItemsControl ItemsSource="{Binding ModFolderVolumes}" Margin="0 8 0 0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type settings:VolumeAssignmentViewModel}">
                                                <StackPanel Orientation="Vertical" Margin="0 16 0 0">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding VolumeRoot}" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding ModFolderSummary}" />

                                                    <ComboBox Width="420" HorizontalAlignment="Left" Margin="0 12 0 0"
                                                              ItemsSource="{Binding Options}"
                                                              DisplayMemberPath="Description"
                                                              SelectedValuePath="VolumeRoot"
                                                              SelectedValue="{Binding ServingVolume, Mode=TwoWay}" />

                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                                               Margin="0 8 0 0"
                                                               Text="{Binding TradeOff}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </GroupBox>
                        </shared:Surface>

                        <shared:Surface Style="{StaticResource Card}"
                                        Margin="0 16 0 0"
                                        Visibility="{Binding HasStores, Converter={StaticResource BoolToVisibilityConverter}}">
                            <GroupBox Header="Stores" Padding="0 16 0 16">
                                <StackPanel Orientation="Vertical">

                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                               Margin="0 0 0 8"
                                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Text="{Binding ManagementBlockedReason}" />

                                    <ItemsControl ItemsSource="{Binding Stores}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type settings:ContentStoreViewModel}">
                                                <StackPanel Orientation="Vertical" Margin="0 0 0 16">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding VolumeRoot}" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding ServedSummary}" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding UsageSummary}" />

                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                                               Text="{Binding ReclaimSummary}"
                                                               Visibility="{Binding HasReclaimSummary, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <Label Content="Folder" Margin="0 12 0 8" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Select folder" Command="{Binding PickPathCommand}" />
                                                        <TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="8 0 0 0" />
                                                    </StackPanel>

                                                    <Label Content="Maximum size (GB)" Margin="0 12 0 8" />
                                                    <TextBox Width="120" HorizontalAlignment="Left"
                                                             Text="{Binding MaxSizeGigabytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0 4 0 0"
                                                               Text="At least the size of your largest profile" />

                                                    <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                                                        <Button Content="Verify store"
                                                                Command="{Binding DataContext.VerifyStoreCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}" />
                                                        <!-- The amount is on the button, because the
                                                             question it answers is "how do I get that
                                                             space back?" -->
                                                        <Button Content="{Binding ReclaimLabel}" Margin="8 0 0 0"
                                                                Command="{Binding DataContext.ReclaimStoreCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Vertical" Margin="0 12 0 0"
                                                                Visibility="{Binding HasQuarantine, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                                                   Text="{Binding QuarantineSummary}" />
                                                        <Button Content="Move to Recycle Bin" HorizontalAlignment="Left" Margin="0 8 0 0"
                                                                Command="{Binding DataContext.EmptyQuarantineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </GroupBox>
                        </shared:Surface>

                        <shared:Surface Style="{StaticResource Card}" Margin="0 16 0 0">
                            <GroupBox Header="Image cache" Padding="0 16 0 16">
                                <StackPanel Orientation="Vertical">

                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0 8 0 0"
                                               Text="{Binding ImageCache.UsageSummary}" />

                                    <Label Content="Folder" Margin="0 12 0 8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Select folder" Command="{Binding ImageCache.PickPathCommand}" />
                                        <TextBox Text="{Binding ImageCache.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="8 0 0 0" />
                                    </StackPanel>

                                    <Label Content="Maximum size (GB)" Margin="0 12 0 8" />
                                    <TextBox Width="120" HorizontalAlignment="Left"
                                             Text="{Binding ImageCache.MaxSizeGigabytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button Content="Empty cache" HorizontalAlignment="Left" Margin="0 12 0 0"
                                            Command="{Binding EmptyImageCacheCommand}" />

                                </StackPanel>
                            </GroupBox>
                        </shared:Surface>

                        <shared:Surface Style="{StaticResource Card}" Margin="0 16 0 0">
                            <GroupBox Header="Network" Padding="0 16 0 16">
                                <StackPanel Orientation="Vertical">

                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                               Text="Shared by all transfers. Leave empty for no limit." />

                                    <Label Content="Download limit (Mbit/s)" Margin="0 12 0 8" />
                                    <TextBox Width="120" HorizontalAlignment="Left"
                                             Text="{Binding DownloadLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Label Content="Upload limit (Mbit/s)" Margin="0 12 0 8" />
                                    <TextBox Width="120" HorizontalAlignment="Left"
                                             Text="{Binding UploadLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                </StackPanel>
                            </GroupBox>
                        </shared:Surface>

                        <shared:Surface Style="{StaticResource Card}" Margin="0 16 0 0">
                            <GroupBox Header="Application" Padding="0 16 0 16">
                                <StackPanel Orientation="Vertical">

                                    <TextBlock FontWeight="SemiBold" Text="{Binding BuildText}" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                               Margin="0 4 0 0"
                                               Text="{Binding UpdateStatusText}" />

                                    <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                                        <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
                                        <Button Content="Restart to update" Margin="8 0 0 0"
                                                Style="{DynamicResource AccentButtonStyle}"
                                                Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Command="{Binding RestartToUpdateCommand}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                                        <Button Content="Restart" Command="{Binding RestartCommand}" />
                                        <Button Content="Quit" Margin="8 0 0 0" Command="{Binding QuitCommand}" />
                                    </StackPanel>

                                </StackPanel>
                            </GroupBox>
                        </shared:Surface>

                        <shared:Surface Style="{StaticResource Card}" Margin="0 16 0 0">
                            <GroupBox Header="Background" Padding="0 16 0 16">
                                <StackPanel Orientation="Vertical">

                                    <CheckBox Content="Keep running in the tray when the window is closed"
                                              IsChecked="{Binding CloseToTray, Mode=TwoWay}" />

                                    <CheckBox Margin="0 12 0 0"
                                              Content="Start with Windows"
                                              IsEnabled="{Binding IsAutostartAvailable}"
                                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />

                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                               Margin="28 4 0 0"
                                               Text="{Binding AutostartNote}" />

                                </StackPanel>
                            </GroupBox>
                        </shared:Surface>

                        <shared:Surface Style="{StaticResource Card}" Margin="0 16 0 0">
                            <GroupBox Header="Windows notifications" Padding="0 16 0 16">
                                <StackPanel Orientation="Vertical">

                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                               Text="Shown when ModsDude is in the background. Notifications in the window always show." />

                                    <CheckBox Margin="0 12 0 0"
                                              Content="Mod folders and savegames that need attention"
                                              IsChecked="{Binding NotifyDrift, Mode=TwoWay}" />

                                    <CheckBox Margin="0 12 0 0"
                                              Content="Reminders to check in savegames"
                                              IsChecked="{Binding NotifyCheckInReminders, Mode=TwoWay}" />

                                    <CheckBox Margin="0 12 0 0"
                                              Content="Finished actions"
                                              IsChecked="{Binding NotifyFinishedActions, Mode=TwoWay}" />

                                    <CheckBox Margin="0 12 0 0"
                                              Content="Friend activity"
                                              IsChecked="{Binding NotifyFriendActivity, Mode=TwoWay}" />

                                </StackPanel>
                            </GroupBox>
                        </shared:Surface>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PageFooter}">
                <StackPanel Style="{StaticResource PageActions}">
                    <Button Width="250" Style="{DynamicResource AccentButtonStyle}"
                            Content="Save changes" Command="{Binding Path=SaveChangesCommand}" />
                </StackPanel>
            </Border>

        </Grid>
    </shared:Surface>
</shared:AppPage>
