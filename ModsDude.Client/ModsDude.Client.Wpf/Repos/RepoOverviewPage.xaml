<shared:AppPage x:Class="ModsDude.Client.Wpf.Repos.RepoOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
      xmlns:friends="clr-namespace:ModsDude.Client.Wpf.Friends"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:repos="clr-namespace:ModsDude.Client.Wpf.Repos"
      xmlns:games="clr-namespace:ModsDude.Client.Wpf.Games"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=repos:RepoOverviewPageViewModel, IsDesignTimeCreatable=False}"
      Title="RepoOverviewPage"
      FontSize="14">

    <Border Style="{StaticResource PageBody}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Overview" />

                <shared:Surface Style="{StaticResource Card}">
                    <GroupBox Header="This repo" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock FontWeight="SemiBold" Text="{Binding GameName}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0 4 0 0"
                                       Text="{Binding MembershipSummary}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasMemberSummary, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="{Binding MemberSummary}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ProfileSummary}" />
                        </StackPanel>
                    </GroupBox>
                </shared:Surface>

                <!-- The game this machine has connected for the repo, in summary. Its heading leads to
                     the game's own page, where it is configured and disconnected. -->
                <shared:Surface Style="{StaticResource Card}" Margin="0 16 0 0">
                    <GroupBox Header="This machine" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding Game.IsConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                       Text="{Binding NotConnectedStatus}" />

                            <StackPanel Orientation="Vertical"
                                        Visibility="{Binding Game.IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold">
                                        <Hyperlink Style="{StaticResource TextLink}" Command="{Binding OpenGameCommand}">
                                            <Run Text="{Binding Game.Game.Name, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <Border Margin="8 0 0 0"
                                            Style="{StaticResource SuccessStatusChip}"
                                            Visibility="{Binding Game.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Running" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding Game.Game.Problem}"
                                           Visibility="{Binding Game.Game.HasProblem, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

                                <ItemsControl Margin="0 4 0 0"
                                              Grid.IsSharedSizeScope="True"
                                              ItemsSource="{Binding Game.Game.Details}" />

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="No folders"
                                           Visibility="{Binding Game.Game.HasNoFolders, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

                                <!-- Neutral. A savegame checked out in compatibility mode is a state somebody chose,
                                     not a problem with the game. -->
                                <TextBlock Margin="0 4 0 0"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Game.Game.HoldingSummary}"
                                           Visibility="{Binding Game.Game.HasHoldingSummary, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>

                            <StackPanel Margin="0 12 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Margin="0 0 8 0"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Content="Connect game"
                                        Command="{Binding ConnectGameCommand}"
                                        Visibility="{Binding CanConnectGame, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Here as well as on the profile page because a game set to another
                                     repo's profile has no page of that profile in this repo. -->
                                <games:DeactivateGameMenu Margin="0 0 8 0"
                                                          DataContext="{Binding Game}"
                                                          Visibility="{Binding CanDeactivate, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- A game launched for the first time is how one that connects by
                                     itself is found. -->
                                <Button Margin="0 0 8 0"
                                        Content="Check again"
                                        Command="{Binding LookAgainCommand}"
                                        Visibility="{Binding CanLookAgain, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>
                </shared:Surface>

                <!-- Who else is on which of this repo's profiles. Only this repo's: somebody on
                     another repo's profile is not playing this one. -->
                <shared:Surface Style="{StaticResource Card}" Margin="0 16 0 0">
                    <GroupBox Header="Members' profiles" Padding="0 16 0 16">
                        <friends:FriendActivityList DataContext="{Binding Friends}" />
                    </GroupBox>
                </shared:Surface>

            </StackPanel>
        </ScrollViewer>
    </Border>
</shared:AppPage>
