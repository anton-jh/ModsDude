<Page x:Class="ModsDude.Client.Wpf.Repos.RepoOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:friends="clr-namespace:ModsDude.Client.Wpf.Friends"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:repos="clr-namespace:ModsDude.Client.Wpf.Repos"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=repos:RepoOverviewPageViewModel, IsDesignTimeCreatable=False}"
      Title="RepoOverviewPage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Overview" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="This repo" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding GameName}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0 4 0 0"
                                       Text="{Binding MembershipSummary}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasMemberSummary, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="{Binding MemberSummary}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ProfileSummary}" />
                        </StackPanel>
                    </GroupBox>
                </Border>

                <!-- The one place the game this machine has connected for the repo is shown and
                     managed. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="This machine" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasNoGame, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="{Binding NotConnectedStatus}" />

                            <StackPanel Orientation="Vertical"
                                        Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding Game.Name}" />

                                <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding Game.Problem}"
                                           Visibility="{Binding Game.HasProblem, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <ItemsControl Margin="0 4 0 0"
                                              Grid.IsSharedSizeScope="True"
                                              ItemsSource="{Binding Game.Folders}" />

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="No folders"
                                           Visibility="{Binding Game.HasNoFolders, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <TextBlock Margin="0 4 0 0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Game.ActiveProfileSummary}" />

                                <!-- Neutral. Holding a savegame in compatibility mode is a state somebody chose and is
                                     playing in, not a problem with the game. -->
                                <TextBlock Margin="0 4 0 0"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Game.HoldingSummary}"
                                           Visibility="{Binding Game.HasHoldingSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <TextBlock Margin="0 8 0 0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding GameError}"
                                       Visibility="{Binding HasGameError, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Margin="0 12 0 0" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Margin="0 0 8 0"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Content="Connect game"
                                        Command="{Binding ConnectGameCommand}"
                                        Visibility="{Binding CanConnectGame, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Button Margin="0 0 8 0"
                                        Content="Configure"
                                        Command="{Binding ConfigureGameCommand}"
                                        Visibility="{Binding CanManageGame, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- For managing the mods by hand for a while without ModsDude objecting.
                                     Here as well as on the profile page because a game set to another
                                     repo's profile has no page of that profile in this repo. -->
                                <StackPanel Margin="0 0 8 0"
                                            Visibility="{Binding Game.HasActiveProfile, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <ToggleButton x:Name="DeactivateToggle"
                                                  Content="Deactivate  ▾"
                                                  ToolTip="Stop ModsDude keeping this game's mod folders in step with its profile." />

                                    <Popup IsOpen="{Binding IsChecked, ElementName=DeactivateToggle, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=DeactivateToggle}"
                                           Placement="Bottom"
                                           VerticalOffset="4"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border CornerRadius="{DynamicResource OverlayCornerRadius}"
                                                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="4">
                                            <StackPanel Orientation="Vertical">
                                                <Button Width="340"
                                                        Style="{DynamicResource SubtleMenuButton}"
                                                        Command="{Binding DeactivateCommand}"
                                                        Click="CloseDeactivateMenu">
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="Deactivate, keep the mods" FontWeight="SemiBold" />
                                                        <TextBlock Text="Stop following the profile and leave the mod folders exactly as they are."
                                                                   Margin="0 2 0 0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Width="340"
                                                        Style="{DynamicResource SubtleMenuButton}"
                                                        Command="{Binding DeactivateAndClearCommand}"
                                                        Click="CloseDeactivateMenu">
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="Deactivate and clear the mods" FontWeight="SemiBold" />
                                                        <TextBlock Text="Stop following the profile and take every mod out of the mod folders. You are shown what goes first."
                                                                   Margin="0 2 0 0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <!-- Mods updated from inside the game are the commonest way a folder
                                     drifts, and a game launched for the first time is how one is
                                     found. -->
                                <Button Margin="0 0 8 0"
                                        Content="Check again"
                                        Command="{Binding CheckAgainCommand}"
                                        Visibility="{Binding CanCheckAgain, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Button Margin="0 0 8 0"
                                        Content="Disconnect"
                                        ToolTip="ModsDude stops managing this installation. Nothing on disk is changed or removed."
                                        Command="{Binding DisconnectCommand}"
                                        Visibility="{Binding CanManageGame, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>
                </Border>

                <!-- Who else is on which of this repo's profiles. Only this repo's: somebody on
                     another repo's profile is not playing this one. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Members' profiles" Padding="0 16 0 16">
                        <friends:FriendActivityList DataContext="{Binding Friends}" />
                    </GroupBox>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
