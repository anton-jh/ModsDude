<Page x:Class="ModsDude.Client.Wpf.Repos.JoinOrCreatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:repos="clr-namespace:ModsDude.Client.Wpf.Repos"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=repos:JoinOrCreatePageViewModel, IsDesignTimeCreatable=False}"
      Title="JoinOrCreatePage">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="{Binding Title}" />

                <!-- Join first: most people arrive with an invite. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="Join a repo" Padding="0 16 0 16">
                        <ContentControl Content="{Binding Join}" />
                    </GroupBox>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Create a repo" Padding="0 16 0 16">
                        <ContentControl Content="{Binding Create}" />
                    </GroupBox>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
