<shared:AppPage x:Class="ModsDude.Client.Wpf.Repos.JoinOrCreatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:repos="clr-namespace:ModsDude.Client.Wpf.Repos"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=repos:JoinOrCreatePageViewModel, IsDesignTimeCreatable=False}"
      Title="JoinOrCreatePage">

    <shared:Surface Style="{StaticResource PagePane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="{Binding Title}" />

                <!-- Join first: most people arrive with an invite. -->
                <shared:Surface Style="{StaticResource Card}">
                    <GroupBox Header="Join a repo" Padding="0 16 0 16">
                        <ContentControl Content="{Binding Join}" />
                    </GroupBox>
                </shared:Surface>

                <shared:Surface Style="{StaticResource Card}" Margin="0 16 0 0">
                    <GroupBox Header="Create a repo" Padding="0 16 0 16">
                        <ContentControl Content="{Binding Create}" />
                    </GroupBox>
                </shared:Surface>

            </StackPanel>
        </ScrollViewer>
    </shared:Surface>
</shared:AppPage>
