<Page x:Class="ModsDude.Client.Wpf.Repos.CreateRepoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:games="clr-namespace:ModsDude.Client.Wpf.Games"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:repos="clr-namespace:ModsDude.Client.Wpf.Repos"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=repos:CreateRepoPageViewModel, IsDesignTimeCreatable=False}"
      Title="CreateRepoPage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Create repo" />

                <Label Content="Name" Margin="0 0 0 12"/>
                <TextBox Width="300" Text="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

                <Label Margin="0 16 0 12" Content="Adapter" />

                <ComboBox Width="300" HorizontalAlignment="Left"
                          ItemsSource="{Binding Path=AvailableGameAdapters}"
                          SelectedValue="{Binding Path=SelectedGameAdapter}"
                          >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <games:DynamicFormEditor DataContext="{Binding BaseSettingsEditor}" Margin="0 16 0 0" />

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource PageActions}">
            <Button Content="Save" Command="{Binding Path=SubmitCommand}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Width="250" />
        </StackPanel>

    </Grid>
</Page>
