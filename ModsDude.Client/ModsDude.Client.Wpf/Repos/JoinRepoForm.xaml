<UserControl x:Class="ModsDude.Client.Wpf.Repos.JoinRepoForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:repos="clr-namespace:ModsDude.Client.Wpf.Repos"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=repos:JoinRepoFormViewModel, IsDesignTimeCreatable=False}">

    <StackPanel Orientation="Vertical">

        <Label Content="Invite code" Margin="0 0 0 8" />
        <StackPanel Orientation="Horizontal">
            <TextBox Width="300"
                     FontFamily="Consolas" FontSize="16"
                     Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Join" Margin="8 0 0 0"
                    Style="{DynamicResource AccentButtonStyle}"
                    Command="{Binding JoinCommand}" />
        </StackPanel>

        <TextBlock Margin="0 8 0 0"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding Error}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />

        <TextBlock Margin="0 8 0 0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasJoined, Converter={StaticResource BoolToVisibilityConverter}}">
            <Run Text="Already a member of" />
            <Run Text="{Binding JoinedRepoName, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>

    </StackPanel>
</UserControl>
