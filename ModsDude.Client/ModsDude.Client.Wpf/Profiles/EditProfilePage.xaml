<Page x:Class="ModsDude.Client.Wpf.Profiles.EditProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:profiles="clr-namespace:ModsDude.Client.Wpf.Profiles"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=profiles:EditProfilePageViewModel, IsDesignTimeCreatable=False}"
      Title="EditProfilePage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Manage" />

                <Label Content="Name" Margin="0 0 0 12"/>
                <TextBox Width="300" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource PageActions}">
            <Button Grid.Column="0" Width="250" Style="{DynamicResource AccentButtonStyle}"
                    Content="Save changes" Command="{Binding SaveChangesCommand}" />

            <Button Grid.Column="2" Width="250" Margin="8 0 0 0"
                    Content="Archive profile"
                    ToolTip="Takes it out of the sidebar and frees its name. Everything else stays, and it can be brought back from the Archive."
                    Command="{Binding ArchiveProfileCommand}" />
        </StackPanel>

    </Grid>
</Page>
