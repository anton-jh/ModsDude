<shared:AppPage x:Class="ModsDude.Client.Wpf.Profiles.CreateProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:profiles="clr-namespace:ModsDude.Client.Wpf.Profiles"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=profiles:CreateProfilePageViewModel, IsDesignTimeCreatable=False}"
      Title="CreateProfilePage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Create profile" />

                <Label Content="Name" Margin="0 0 0 12"/>
                <TextBox Width="300" Text="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource PageActions}">
            <Button Content="Save" Command="{Binding Path=SubmitCommand}"
                    Style="{DynamicResource AccentButtonStyle}"
                    Width="250" />
        </StackPanel>

    </Grid>
</shared:AppPage>
