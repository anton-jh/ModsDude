<Page x:Class="ModsDude.Client.Wpf.Profiles.Editor.ProfileModsEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:ModsDude.Client.Wpf.Shared.Behaviors"
      xmlns:editor="clr-namespace:ModsDude.Client.Wpf.Profiles.Editor"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ed="clr-namespace:ModsDude.Client.Core.Profiles.Editor;assembly=ModsDude.Client.Core"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfileModsEditorPage"
      PreviewKeyDown="PageKeyDown"
      d:DataContext="{d:DesignInstance Type=editor:ProfileModsEditorPageViewModel, IsDesignTimeCreatable=False}">

    <Page.Resources>

        <!-- A row's version: the box says what the row holds, one way only, and the list under it picks
             by command. It never holds a selection of its own, so it cannot show anything but the row. -->
        <DataTemplate x:Key="VersionPicker" DataType="{x:Type editor:EditorModRowViewModel}">
            <Grid Width="150" Margin="4 0" VerticalAlignment="Center">
                <ToggleButton x:Name="Box"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsEnabled="{Binding HasSeveralVersions}"
                              IsChecked="{Binding IsVersionMenuOpen, Mode=TwoWay}">
                    <!-- Greyed where there is nothing else to pick, as a disabled combo box would be: the
                         theme greys the button, not what is drawn inside it. -->
                    <Grid ColumnDefinitions="* auto">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=Box}" Value="False">
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="{Binding CurrentVersion.Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="8 0 0 0"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   FontSize="10"
                                   Text="&#xE70D;" />
                    </Grid>
                </ToggleButton>

                <Popup IsOpen="{Binding IsVersionMenuOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=Box}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       MinWidth="150">
                    <Border CornerRadius="{DynamicResource OverlayCornerRadius}"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="4">
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="Options" ItemsSource="{Binding Versions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type ed:ProfileModVersionOption}">
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Style="{DynamicResource SubtleMenuButton}"
                                                Content="{Binding Label}"
                                                ToolTip="{Binding Note}"
                                                Command="{Binding DataContext.PickVersionCommand, ElementName=Options}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <!-- Grey hint text over an empty box. Tag is the TextBox it hints for. -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Margin" Value="12 0 0 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- An attribute sort's dropdown, drawn as a sort chip: grey and saying "Attribute" while it
             holds no key, lit like a checked chip while it is the sort. -->
        <Style x:Key="SortAttributeBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0 0 6 0" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="Sort by what the mods are tagged with" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chip"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="12 5 10 5"
                                    CornerRadius="14">
                                <Grid ColumnDefinitions="* auto">
                                    <ContentPresenter x:Name="Selection"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" />
                                    <TextBlock x:Name="Placeholder"
                                               Text="Attribute"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8 0 0 0"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="10"
                                               Text="&#xE70D;" />
                                </Grid>
                            </Border>

                            <ToggleButton OverridesDefaultStyle="True"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   VerticalOffset="2"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   MinWidth="{TemplateBinding ActualWidth}">
                                <Border Background="{DynamicResource ComboBoxDropDownBackground}"
                                        BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource PopupCornerRadius}"
                                        Padding="0 4">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="SelectedItem" Value="{x:Null}" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One list's sort: name, date, an attribute, and the direction. -->
        <DataTemplate DataType="{x:Type editor:ListSortViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sort"
                           Margin="0 0 8 0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <RadioButton Style="{StaticResource FilterChip}"
                             Content="Name"
                             IsChecked="{Binding Kind, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Name}" />
                <RadioButton Style="{StaticResource FilterChip}"
                             Content="{Binding DateLabel}"
                             ToolTip="{Binding DateTooltip}"
                             IsChecked="{Binding Kind, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Date}" />
                <ComboBox Style="{StaticResource SortAttributeBox}"
                          ItemsSource="{Binding DataContext.SortAttributes, RelativeSource={RelativeSource AncestorType=Page}}"
                          SelectedItem="{Binding Attribute, Mode=TwoWay}" />
                <Button Style="{DynamicResource SubtleIconButton}"
                        ToolTip="{Binding DirectionText}"
                        Command="{Binding ToggleDirectionCommand}">
                    <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE74B;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Ascending}" Value="True">
                                        <Setter Property="Text" Value="&#xE74A;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- The box a list sits in, and the target a drag from the other list lands on. -->
        <Style x:Key="DropFrame" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Child.(editor:ModListDrag.IsOver), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyListText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- The split save button: the accent chrome split down the seam, outer corners rounded. -->
        <Style x:Key="SaveSplitPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="16 7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="4 0 0 4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="FocusRing"
                                        Margin="-14 -5"
                                        CornerRadius="4 0 0 4"
                                        BorderThickness="0"
                                        BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Summary.WillApply}" Value="False">
                                <Setter TargetName="Background" Property="CornerRadius" Value="4" />
                                <Setter TargetName="FocusRing" Property="CornerRadius" Value="4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveSplitCaret" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Background"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="0 4 4 0">
                            <Grid>
                                <Rectangle Width="1" Margin="0 7"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           Opacity="0.3" />
                                <Path x:Name="Chevron"
                                      Data="M 0 0 L 4.5 4.5 L 9 0"
                                      Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="FocusRing"
                                        CornerRadius="0 4 4 0"
                                        BorderThickness="0"
                                        BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <Grid RowDefinitions="auto auto auto *">

                <navigation:PageTitle Grid.Row="0" Text="Mods" />

                <!-- One search box over both lists. -->
                <Grid Grid.Row="1" Margin="0 0 0 12">
                    <TextBox x:Name="SearchBox"
                             PreviewKeyDown="SearchBoxKeyDown"
                             behaviors:SearchCompletion.Completer="{Binding SearchCompleter}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="Search by name, id or author - Ctrl+Space for filters"
                               Tag="{Binding ElementName=SearchBox}"
                               Style="{StaticResource Placeholder}" />
                </Grid>

                <Border Grid.Row="2"
                        Margin="0 0 0 12"
                        Padding="12 8"
                        CornerRadius="4"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Visibility="{Binding IsWaitingForSave, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="This profile is being saved. The editor opens for changes when the save is done."
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>

                <Grid Grid.Row="3" ColumnDefinitions="* 16 *">

                    <!-- What the profile does not hold: everything the enabled sources offer. -->
                    <Grid Grid.Column="0" RowDefinitions="auto auto auto * auto auto">

                        <Grid Grid.Row="0" Margin="0 0 0 8" ColumnDefinitions="auto * auto auto">

                            <CheckBox Grid.Column="0"
                                      Margin="12 0 10 0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AvailableSelection.AllShownSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      ToolTip="Select everything this list is showing" />

                            <TextBlock Grid.Column="1"
                                       Text="Not in this profile"
                                       VerticalAlignment="Center"
                                       ToolTip="What the enabled sources offer that this profile does not hold."
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}" />

                            <!-- Ignored mods: hidden until shown, dimmed then. Crossed out while hidden. -->
                            <ToggleButton Grid.Column="2"
                                          Margin="8 0 0 0"
                                          Width="Auto"
                                          MinWidth="36"
                                          Padding="8 0"
                                          Style="{DynamicResource SubtleIconToggleButton}"
                                          IsChecked="{Binding ShowIgnored, Mode=TwoWay}"
                                          ToolTip="{Binding Summary.IgnoredToggleTooltip}"
                                          ToolTipService.ShowDuration="20000">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xED1A;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowIgnored}" Value="True">
                                                        <Setter Property="Text" Value="&#xE890;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="6 0 0 0"
                                               VerticalAlignment="Center"
                                               FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Page}}"
                                               Text="{Binding Summary.IgnoredText}"
                                               Visibility="{Binding Summary.HasIgnored, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </ToggleButton>

                            <TextBlock Grid.Column="3"
                                       Margin="12 0 0 0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Summary.AvailableCountText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- The sources. A ✕ unloads one, taking everything it supplied. -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 8" IsEnabled="{Binding CanEdit}">

                            <ItemsControl ItemsSource="{Binding Sources.Chips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type editor:ModSourceViewModel}">
                                        <ToggleButton Style="{StaticResource SourceChip}"
                                                      Margin="0 0 6 6"
                                                      ToolTip="{Binding Tooltip}"
                                                      ToolTipService.ShowDuration="20000"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           MaxWidth="160"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ChipCountText}"
                                                           Margin="6 0 0 0"
                                                           Opacity="0.7"
                                                           VerticalAlignment="Center" />
                                                <Button Margin="6 0 -2 0"
                                                        Padding="2 0"
                                                        VerticalAlignment="Center"
                                                        Style="{DynamicResource SubtleIconButton}"
                                                        Width="18" Height="18"
                                                        FontSize="10"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                        Content="&#xE711;"
                                                        ToolTip="{Binding RemoveTooltip}"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Command="{Binding DataContext.Sources.UnloadCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource SourceActionChip}"
                                    Margin="0 0 6 6"
                                    Content="+ folder"
                                    ToolTip="Scanned for this session only, and never written to disk"
                                    Command="{Binding Sources.AddFolderCommand}" />

                            <Button Style="{StaticResource SourceActionChip}"
                                    Margin="0 0 6 6"
                                    Content="+ profile"
                                    ToolTip="Read another profile's list as a source, to see what it holds and this one does not"
                                    Command="{Binding Sources.AddProfileCommand}" />

                            <Button Style="{StaticResource SourceActionChip}"
                                    Margin="0 0 6 6"
                                    Content="&#xE72C;"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    ToolTip="Rescan every folder"
                                    Command="{Binding Sources.RescanAllCommand}" />
                        </WrapPanel>

                        <Grid Grid.Row="2" Margin="0 0 0 8" ColumnDefinitions="* auto">
                            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource FilterChip}"
                                             Content="All"
                                             IsChecked="{Binding AvailableFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
                                <RadioButton Style="{StaticResource FilterChip}"
                                             Content="New to the repo"
                                             ToolTip="Not registered here yet. Saving imports these."
                                             IsChecked="{Binding AvailableFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=New}" />
                                <RadioButton Style="{StaticResource FilterChip}"
                                             Content="Not settled"
                                             ToolTip="The order between this version and what the repo holds is not settled. Importing it will ask which comes first."
                                             IsChecked="{Binding AvailableFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Unordered}" />
                            </WrapPanel>

                            <ContentControl Grid.Column="1" Margin="12 0 0 0" VerticalAlignment="Top" Content="{Binding AvailableSorting}" />
                        </Grid>

                        <Grid Grid.Row="3">
                            <Border Style="{StaticResource DropFrame}">
                                <ListBox x:Name="AvailableList"
                                         Style="{StaticResource ModList}"
                                         ItemsSource="{Binding AvailableRows}"
                                         behaviors:ListSelection.Controller="{Binding AvailableSelection}"
                                         editor:ModListDrag.Kind="Available"
                                         editor:ModListDrag.DropCommand="{Binding RemoveSelectedCommand}">

                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add the selected mods" Command="{Binding AddSelectedCommand}" />
                                            <MenuItem Header="Ignore the selected mods" Command="{Binding IgnoreSelectedCommand}" />
                                            <Separator />
                                            <MenuItem Header="Select everything shown" Command="{Binding AvailableSelection.SelectAllShownCommand}" />
                                            <MenuItem Header="Clear the selection" Command="{Binding AvailableSelection.ClearSelectionCommand}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type editor:AvailableModRowViewModel}">
                                            <Grid ColumnDefinitions="* auto auto">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                                <TextBlock Grid.Column="1"
                                                           Margin="8 0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding SortCaption}"
                                                           ToolTip="{Binding SortTooltip}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding HasSortCaption, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Page}}">

                                                    <Button Margin="0 0 4 0"
                                                            ToolTip="{Binding IgnoreTooltip}"
                                                            ToolTipService.ShowDuration="20000"
                                                            Command="{Binding DataContext.ToggleIgnoreCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SubtleIconButton}">
                                                                <Setter Property="Content" Value="&#xED1A;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                        <Setter Property="Content" Value="&#xE890;" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VersionPicker}" ToolTip="Which version this would add" />

                                                    <Button Style="{DynamicResource SubtleIconButton}"
                                                            Margin="0 0 8 0"
                                                            Content="&#xE710;"
                                                            ToolTip="Add to this profile"
                                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TextBlock Text="Reading the repo and scanning the sources…"
                                       Style="{StaticResource EmptyListText}"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <Border Grid.Row="4"
                                Style="{StaticResource SelectionBar}"
                                Visibility="{Binding AvailableSelection.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid RowDefinitions="auto auto auto">

                                <Grid Grid.Row="0" ColumnDefinitions="* auto">
                                    <Button Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            Content="{Binding AvailableSelection.ActionText}"
                                            Command="{Binding AddSelectedCommand}" />
                                    <Button Grid.Column="1"
                                            Margin="8 0 0 0"
                                            Content="Clear"
                                            Command="{Binding AvailableSelection.ClearSelectionCommand}" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0 8 0 0" ColumnDefinitions="* *">
                                    <Button Grid.Column="0"
                                            Margin="0 0 4 0"
                                            HorizontalAlignment="Stretch"
                                            Content="{Binding IgnoreSelectedText}"
                                            ToolTip="Hide the picked mods from this list"
                                            Command="{Binding IgnoreSelectedCommand}" />
                                    <Button Grid.Column="1"
                                            Margin="4 0 0 0"
                                            HorizontalAlignment="Stretch"
                                            Content="{Binding UnignoreSelectedText}"
                                            ToolTip="Stop ignoring the picked mods"
                                            Command="{Binding UnignoreSelectedCommand}" />
                                </Grid>

                                <Grid Grid.Row="2"
                                      Margin="0 8 0 0"
                                      ColumnDefinitions="* auto"
                                      Visibility="{Binding AvailableSelection.HasHidden, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding AvailableSelection.HiddenText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="1"
                                            Margin="8 0 0 0"
                                            Content="{Binding AvailableSelection.DeselectHiddenText}"
                                            Command="{Binding AvailableSelection.DeselectHiddenCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="5" Margin="0 8 0 0" ColumnDefinitions="* * *">
                            <Button Grid.Column="0"
                                    Margin="0 0 4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="Add all shown"
                                    ToolTip="Add every mod the list above is showing"
                                    Command="{Binding AddAllShownCommand}" />
                            <Button Grid.Column="1"
                                    Margin="4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="Copy from a profile…"
                                    ToolTip="Take the mod list from another profile in this repo"
                                    Command="{Binding CopyFromProfileCommand}" />
                            <Button Grid.Column="2"
                                    Margin="4 0 0 0"
                                    HorizontalAlignment="Stretch"
                                    Content="Paste a list…"
                                    ToolTip="Paste mod names or ids and select everything that matches"
                                    Command="{Binding PasteListCommand}" />
                        </Grid>
                    </Grid>

                    <!-- The draft: every pin, and every saved pin it takes out. -->
                    <Grid Grid.Column="2" RowDefinitions="auto auto auto * auto auto">

                        <Grid Grid.Row="0" Margin="0 0 0 8" ColumnDefinitions="auto * auto auto">

                            <CheckBox Grid.Column="0"
                                      Margin="12 0 10 0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding PinnedSelection.AllShownSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      ToolTip="Select everything this list is showing" />

                            <TextBlock Grid.Column="1"
                                       Text="In this profile"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}" />

                            <Button Grid.Column="2"
                                    Margin="12 0 0 0"
                                    Padding="0"
                                    Style="{DynamicResource SubtleMenuButton}"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Content="{Binding Summary.ChangeSummary}"
                                    ToolTip="Show only what this draft changes"
                                    Visibility="{Binding Summary.HasModListChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding ShowChangesCommand}" />

                            <TextBlock Grid.Column="3"
                                       Margin="12 0 0 0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Summary.PinnedCountText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0 0 0 8" ColumnDefinitions="* auto">
                            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource FilterChip}"
                                             Content="All"
                                             ToolTip="The draft, with what it takes out struck through"
                                             IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
                                <RadioButton Style="{StaticResource FilterChip}"
                                             Content="Result"
                                             ToolTip="Exactly what saving would leave in the profile"
                                             IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Result}" />
                                <RadioButton Style="{StaticResource FilterChip}"
                                             Content="Changes"
                                             ToolTip="Only what differs from the saved profile"
                                             IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Changes}" />
                                <RadioButton Style="{StaticResource FilterChip}"
                                             Content="Updates"
                                             ToolTip="Mods with a newer version - in the repo, in a folder being read, or online"
                                             IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Updates}" />
                                <RadioButton Style="{StaticResource FilterChip}"
                                             Content="Locked"
                                             ToolTip="Mods held at their version, by you or by the game adapter"
                                             IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Locked}" />
                                <RadioButton Style="{StaticResource FilterChip}"
                                             Content="Not in the sources"
                                             ToolTip="Mods this profile pins that none of the enabled sources offers any version of"
                                             IsEnabled="{Binding Sources.HasEnabledSources}"
                                             IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=NotInSources}" />
                            </WrapPanel>

                            <ContentControl Grid.Column="1" Margin="12 0 0 0" VerticalAlignment="Top" Content="{Binding PinnedSorting}" />
                        </Grid>

                        <!-- The updates band: always on screen, so "no updates" is an answer too. -->
                        <Border Grid.Row="2"
                                Margin="0 0 0 8"
                                Padding="12 8"
                                CornerRadius="4"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid ColumnDefinitions="auto * auto" RowDefinitions="auto auto">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Summary.UpdateCountText}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12 0 0 0">
                                    <Button Padding="6 2"
                                            Style="{DynamicResource SubtleMenuButton}"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Content="{Binding Summary.SkippedText}"
                                            ToolTip="Locked mods are skipped. Open the list to move any of them anyway."
                                            Visibility="{Binding Summary.HasSkippedUpdates, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding ShowSkippedUpdatesCommand}" />
                                    <Button Padding="6 2"
                                            Margin="8 0 0 0"
                                            Style="{DynamicResource SubtleMenuButton}"
                                            Content="{Binding Summary.UnsettledText}"
                                            ToolTip="Their order relative to what the repo holds is not settled. Importing one will ask which comes first."
                                            Visibility="{Binding Summary.HasUnsettled, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding ShowUpdatesCommand}" />
                                    <Button Padding="6 2"
                                            Margin="8 0 0 0"
                                            Style="{DynamicResource SubtleMenuButton}"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            Content="{Binding Summary.RemoteUpdatesText}"
                                            ToolTip="Newer versions online, each linked from its mod's row. Download one, rescan, and it can be updated to like any other."
                                            Visibility="{Binding Summary.HasRemoteUpdates, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding ShowUpdatesCommand}" />
                                </StackPanel>

                                <StackPanel x:Name="UpdateSplitButton" Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="{Binding Summary.ApplyUpdatesText}"
                                            Command="{Binding ApplyAllUpdatesCommand}" />

                                    <ToggleButton x:Name="UpdateVariantButton"
                                                  Margin="2 0 0 0"
                                                  Padding="8 0"
                                                  ToolTip="Other ways to update"
                                                  Content="&#xE70D;"
                                                  FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                  FontSize="10"
                                                  Visibility="{Binding Summary.HasRepoOnlyUpdates, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <Popup IsOpen="{Binding IsChecked, ElementName=UpdateVariantButton, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=UpdateSplitButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border CornerRadius="{DynamicResource OverlayCornerRadius}"
                                                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="4">
                                            <Button Width="300"
                                                    Style="{DynamicResource SubtleMenuButton}"
                                                    Command="{Binding ApplyRepoUpdatesCommand}"
                                                    Click="CloseUpdateVariants">
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{Binding Summary.UpdateRepoOnlyText}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding UpdateRepoOnlyDescription}"
                                                               Margin="0 2 0 0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <!-- Where the online updates come from, and how current they are. -->
                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="3"
                                              Margin="0 6 0 0"
                                              ItemsSource="{Binding RemoteUpdates.Providers}"
                                              Visibility="{Binding RemoteUpdates.HasProviders, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type editor:RemoteUpdateProviderViewModel}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Margin="8 0 0 0"
                                                        Padding="6 2"
                                                        Style="{DynamicResource SubtleMenuButton}"
                                                        Content="Check again"
                                                        ToolTip="Forget what it answered and look everything up again"
                                                        Command="{Binding CheckAgainCommand}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3">
                            <Border Style="{StaticResource DropFrame}">
                                <ListBox x:Name="PinnedList"
                                         Style="{StaticResource ModList}"
                                         ItemsSource="{Binding PinnedRows}"
                                         behaviors:ListSelection.Controller="{Binding PinnedSelection}"
                                         editor:ModListDrag.Kind="Pinned"
                                         editor:ModListDrag.DropCommand="{Binding AddSelectedCommand}">

                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Take the selected mods out" Command="{Binding RemoveSelectedCommand}" />
                                            <MenuItem Header="Revert the selected mods" Command="{Binding RevertSelectedCommand}" />
                                            <Separator />
                                            <MenuItem Header="Update the selected mods" Command="{Binding UpdateSelectedCommand}" />
                                            <MenuItem Header="Lock the selected mods" Command="{Binding LockSelectedCommand}" />
                                            <MenuItem Header="Unlock the selected mods" Command="{Binding UnlockSelectedCommand}" />
                                            <Separator />
                                            <MenuItem Header="Select everything shown" Command="{Binding PinnedSelection.SelectAllShownCommand}" />
                                            <MenuItem Header="Clear the selection" Command="{Binding PinnedSelection.ClearSelectionCommand}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type editor:PinnedModRowViewModel}">
                                            <Grid ColumnDefinitions="* auto auto">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTakenOut}" Value="True">
                                                                <Setter Property="Opacity" Value="0.6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                                <TextBlock Grid.Column="1"
                                                           Margin="8 0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding SortCaption}"
                                                           ToolTip="{Binding SortTooltip}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding HasSortCaption, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Page}}">

                                                    <Button Style="{DynamicResource SubtleIconButton}"
                                                            Content="&#xE74A;"
                                                            ToolTip="{Binding UpdateTooltip}"
                                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />

                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VersionPicker}" ToolTip="Which version this profile pins" />

                                                    <!-- Open while nothing holds the pin, closed while something does, in the
                                                         accent while the adapter does - which unticking cannot release. -->
                                                    <ToggleButton ToolTip="{Binding LockTooltip}"
                                                                  IsChecked="{Binding LockedByProfile, Mode=TwoWay}"
                                                                  Visibility="{Binding IsTakenOut, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource SubtleIconToggleButton}">
                                                                <Setter Property="Content" Value="&#xE785;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                        <Setter Property="Content" Value="&#xE72E;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LockedByAdapter}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>

                                                    <Button Style="{DynamicResource SubtleIconButton}"
                                                            Content="&#xE7A7;"
                                                            ToolTip="Revert to what the saved profile holds"
                                                            Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />

                                                    <Button Margin="0 0 8 0"
                                                            Style="{DynamicResource SubtleIconButton}"
                                                            Content="&#xE738;"
                                                            ToolTip="Take out of this profile"
                                                            Visibility="{Binding IsTakenOut, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TextBlock Text="{Binding Summary.PinnedEmptyText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyListText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Summary.PinnedEmptyText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="4"
                                Style="{StaticResource SelectionBar}"
                                Visibility="{Binding PinnedSelection.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid RowDefinitions="auto auto auto">

                                <Grid Grid.Row="0" ColumnDefinitions="* auto">
                                    <Button Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            Content="{Binding PinnedSelection.ActionText}"
                                            Command="{Binding RemoveSelectedCommand}" />
                                    <Button Grid.Column="1"
                                            Margin="8 0 0 0"
                                            Content="Clear"
                                            Command="{Binding PinnedSelection.ClearSelectionCommand}" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0 8 0 0" ColumnDefinitions="* auto auto auto">
                                    <Button Grid.Column="0"
                                            Margin="0 0 4 0"
                                            HorizontalAlignment="Stretch"
                                            Content="{Binding UpdateSelectedText}"
                                            ToolTip="Move the picked mods to their newest version, leaving locked ones alone"
                                            Command="{Binding UpdateSelectedCommand}" />
                                    <Button Grid.Column="1"
                                            Margin="4 0"
                                            MinWidth="72"
                                            Content="Lock"
                                            ToolTip="Hold the picked mods at their versions in this profile"
                                            Command="{Binding LockSelectedCommand}" />
                                    <Button Grid.Column="2"
                                            Margin="4 0"
                                            MinWidth="72"
                                            Content="Unlock"
                                            ToolTip="Release this profile's own lock on the picked mods"
                                            Command="{Binding UnlockSelectedCommand}" />
                                    <Button Grid.Column="3"
                                            Margin="4 0 0 0"
                                            MinWidth="72"
                                            Content="{Binding RevertSelectedText}"
                                            ToolTip="Put the picked mods back the way the saved profile has them"
                                            Command="{Binding RevertSelectedCommand}" />
                                </Grid>

                                <Grid Grid.Row="2"
                                      Margin="0 8 0 0"
                                      ColumnDefinitions="* auto"
                                      Visibility="{Binding PinnedSelection.HasHidden, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding PinnedSelection.HiddenText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="1"
                                            Margin="8 0 0 0"
                                            Content="{Binding PinnedSelection.DeselectHiddenText}"
                                            Command="{Binding PinnedSelection.DeselectHiddenCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="5" Margin="0 8 0 0" ColumnDefinitions="* *">
                            <Button Grid.Column="0"
                                    Margin="0 0 4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="Take out everything shown"
                                    ToolTip="Take every mod the list above is showing out of this profile"
                                    Command="{Binding RemoveAllShownCommand}" />
                            <Button Grid.Column="1"
                                    Margin="4 0 0 0"
                                    HorizontalAlignment="Stretch"
                                    Content="Revert everything shown"
                                    ToolTip="Put every changed mod the list above is showing back the way the saved profile has it"
                                    Command="{Binding RevertAllShownCommand}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="auto auto auto auto *">

            <!-- Split button: Save is one click, and saving without re-applying costs opening the menu. -->
            <StackPanel x:Name="SaveSplitButton"
                        Grid.Column="0" Orientation="Horizontal" Margin="32 24 4 24">

                <Button x:Name="SaveButton"
                        MinWidth="200"
                        Style="{StaticResource SaveSplitPrimary}"
                        Content="{Binding Summary.SaveActionText}"
                        Command="{Binding SaveChangesCommand}" />

                <ToggleButton x:Name="SaveVariantButton"
                              Style="{StaticResource SaveSplitCaret}"
                              ToolTip="Other ways to save"
                              IsEnabled="{Binding IsEnabled, ElementName=SaveButton}"
                              Visibility="{Binding Summary.WillApply, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Popup IsOpen="{Binding IsChecked, ElementName=SaveVariantButton, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=SaveSplitButton}"
                       Placement="Top"
                       VerticalOffset="-6"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border CornerRadius="{DynamicResource OverlayCornerRadius}"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="4">
                        <Button Width="320"
                                Style="{DynamicResource SubtleMenuButton}"
                                Command="{Binding SaveOnlyCommand}"
                                Click="CloseSaveVariants">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Save only" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SaveOnlyDescription}"
                                           Margin="0 2 0 0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Popup>
            </StackPanel>

            <Button Grid.Column="1" Margin="4 24 4 24"
                    Content="Discard changes"
                    ToolTip="Put everything back the way the saved profile has it. You can undo this."
                    Command="{Binding DiscardChangesCommand}" />

            <StackPanel Grid.Column="2" Margin="4 24 4 24" Orientation="Horizontal">
                <Button Style="{DynamicResource SubtleIconButton}"
                        Content="&#xE7A7;"
                        ToolTip="{Binding UndoTooltip}"
                        ToolTipService.ShowOnDisabled="True"
                        Command="{Binding UndoCommand}" />
                <Button Style="{DynamicResource SubtleIconButton}"
                        Content="&#xE7A6;"
                        ToolTip="{Binding RedoTooltip}"
                        ToolTipService.ShowOnDisabled="True"
                        Command="{Binding RedoCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="12 0 16 0" VerticalAlignment="Center">

                <!-- Optional, so only there while there is something to save. MaxLength matches
                     ProfileRevision.MaximumLabelLength on the server. -->
                <Grid Width="300"
                      HorizontalAlignment="Left"
                      Visibility="{Binding Summary.HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox x:Name="VersionDescriptionBox"
                             MaxLength="100"
                             Text="{Binding VersionDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="What this save is, in the profile's history. Left empty, the history shows what changed instead."
                             ToolTipService.InitialShowDelay="200" />
                    <TextBlock Text="Version description (optional)"
                               Tag="{Binding ElementName=VersionDescriptionBox}"
                               Style="{StaticResource Placeholder}" />
                </Grid>

                <TextBlock Text="{Binding SaveBlockedReason}"
                           Margin="0 6 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding HasSaveBlockedReason, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <TextBlock Grid.Column="4"
                       Margin="0 0 32 0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="{Binding Summary.PendingText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding Summary.HasPending, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

    </Grid>

</Page>
