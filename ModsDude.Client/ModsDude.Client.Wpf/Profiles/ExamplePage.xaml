<Page x:Class="ModsDude.Client.Wpf.Profiles.ExamplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:profiles="clr-namespace:ModsDude.Client.Wpf.Profiles"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=profiles:ExamplePageViewModel, IsDesignTimeCreatable=False}"
      Title="ExamplePage"
      FontSize="14">

    <Border Padding="32" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4 0 0 0" >
        <StackPanel>
            <navigation:PageTitle Text="{Binding Subtitle}" />
        </StackPanel>
    </Border>
</Page>
