<Page x:Class="ModsDude.Client.Wpf.Profiles.ProfileOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:games="clr-namespace:ModsDude.Client.Wpf.Games"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      xmlns:profiles="clr-namespace:ModsDude.Client.Wpf.Profiles"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=profiles:ProfileOverviewPageViewModel, IsDesignTimeCreatable=False}"
      Title="ProfileOverviewPage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Overview" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="This profile" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding RepoName}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0 4 0 0"
                                       Text="{Binding ModSummary}" />
                        </StackPanel>
                    </GroupBox>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Where it is applied" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="Not applied." />

                            <ItemsControl ItemsSource="{Binding Games}"
                                          Visibility="{Binding HasGames, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type games:GameOverviewViewModel}">
                                        <StackPanel Orientation="Vertical" Margin="0 0 0 16">
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding Name}" />

                                            <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Text="{Binding Problem}"
                                                       Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <ItemsControl Margin="0 4 0 0"
                                                          Grid.IsSharedSizeScope="True"
                                                          ItemsSource="{Binding Folders}" />

                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="No folders"
                                                       Visibility="{Binding HasNoFolders, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </GroupBox>
                </Border>

                <!-- This profile's savegames, most recently played first. Each name leads to its row on
                     the repo's Saves list, which is where a savegame is checked out and in. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0"
                        Visibility="{Binding HasSavegames, Converter={StaticResource BoolToVisibilityConverter}}">
                    <GroupBox Header="Savegames" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="{Binding SavegamesNote}"
                                       Visibility="{Binding HasSavegamesNote, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ItemsControl ItemsSource="{Binding Savegames}" Grid.IsSharedSizeScope="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type profiles:ProfileSavegameRowViewModel}">
                                        <Grid Margin="0 0 0 6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" SharedSizeGroup="Name" />
                                                <ColumnDefinition Width="auto" SharedSizeGroup="Played" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Margin="0 0 24 0">
                                                <Hyperlink Style="{StaticResource TextLink}"
                                                           ToolTip="Open it on the Saves list"
                                                           Command="{Binding OpenCommand}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>

                                            <TextBlock Grid.Column="1"
                                                       Margin="0 0 24 0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding LastPlayedText}" />

                                            <TextBlock Grid.Column="2"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding HolderText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Margin="0 12 0 0"
                                    HorizontalAlignment="Left"
                                    MinWidth="110"
                                    Content="Publish a save"
                                    ToolTip="{Binding PublishToolTip}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Command="{Binding PublishCommand}"
                                    Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </GroupBox>
                </Border>

                <ContentControl Margin="0 16 0 0"
                                Content="{Binding Manage}"
                                Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}" />

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
