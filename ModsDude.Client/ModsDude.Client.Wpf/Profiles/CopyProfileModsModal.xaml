<UserControl x:Class="ModsDude.Client.Wpf.Profiles.CopyProfileModsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:profiles="clr-namespace:ModsDude.Client.Wpf.Profiles"
             mc:Ignorable="d"
             Width="520" MaxHeight="620"
             d:DataContext="{d:DesignInstance Type=profiles:CopyProfileModsModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <shared:Surface Style="{StaticResource ModalSurface}">

        <Grid RowDefinitions="auto * auto auto">

            <StackPanel Grid.Row="0" Margin="24 24 56 12">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Style="{StaticResource InsetWell}"
                    Grid.Row="1"
                    Margin="24 0"
                    MinHeight="120">
                <Grid>

                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Margin="4 6"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding EmptyText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Adding is the default and replacing is the second choice, because the two read
                 almost the same in a sentence and are very different in effect. -->
            <StackPanel Grid.Row="2" Margin="24 16 24 0">

                <RadioButton GroupName="CopyMode"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Add}">
                    <StackPanel>
                        <TextBlock Text="Add what is missing"
                                   Style="{DynamicResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Keeps the current versions of mods already here"
                                   Margin="0 2 0 0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="CopyMode"
                             Margin="0 10 0 0"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Replace}">
                    <StackPanel>
                        <TextBlock Text="Replace this list"
                                   Style="{DynamicResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Removes mods the other profile does not have"
                                   Margin="0 2 0 0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <Border Style="{StaticResource ModalFooter}"
                    Grid.Row="3"
                    Margin="0 16 0 0">

                <Grid Margin="24 16 24 20" ColumnDefinitions="* *">
                    <Button Grid.Column="0"
                            Margin="0 0 4 0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="Copy the list"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ConfirmCommand}" />

                    <Button Grid.Column="1"
                            Margin="4 0 0 0"
                            Content="Cancel"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>
        </Grid>
    </shared:Surface>

</UserControl>
