<UserControl x:Class="ModsDude.Client.Wpf.Profiles.BlockedRevisionsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:profiles="clr-namespace:ModsDude.Client.Wpf.Profiles"
             mc:Ignorable="d"
             Width="620" MaxHeight="640"
             d:DataContext="{d:DesignInstance Type=profiles:BlockedRevisionsModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <shared:Surface Style="{StaticResource ModalSurface}">

        <Grid RowDefinitions="auto * auto">

            <StackPanel Grid.Row="0" Margin="24 24 56 12">
                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 12 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="24 0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type profiles:BlockedRevisionViewModel}">
                            <Border Style="{StaticResource InsetWell}"
                                    Margin="0 0 0 12"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                    <TextBlock Text="{Binding Reason}"
                                               Margin="0 4 0 0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <!-- Links only where there is something to do. The head revision
                                         is an explanation, not a task. -->
                                    <ItemsControl ItemsSource="{Binding Savegames}"
                                                  Margin="0 8 0 0"
                                                  Visibility="{Binding HasSavegames, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type profiles:SavegameSnapshotLinkViewModel}">
                                                <TextBlock Margin="0 0 0 2">
                                                    <Hyperlink Style="{StaticResource TextLink}"
                                                               ToolTip="Open this repo's savegames"
                                                               Command="{Binding OpenCommand}">
                                                        <Run Text="{Binding Label, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Style="{StaticResource ModalFooter}"
                    Grid.Row="2"
                    Margin="0 16 0 0">
                <Button Margin="24"
                        MinWidth="120"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="OK"
                        Command="{Binding CloseCommand}" />
            </Border>
        </Grid>
    </shared:Surface>

</UserControl>
