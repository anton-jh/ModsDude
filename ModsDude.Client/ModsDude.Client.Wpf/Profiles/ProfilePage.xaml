<Page x:Class="ModsDude.Client.Wpf.Profiles.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:profiles="clr-namespace:ModsDude.Client.Wpf.Profiles"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=profiles:ProfilePageViewModel, IsDesignTimeCreatable=False}"
      Title="ProfilePage">

    <!-- The profile's name and the button that applies it are in the repo's header, above this: the
         header spans the whole repo, so it is the same one from every tab of every profile. What is
         left here is the profile's tabs and the page each opens. -->
    <Grid RowDefinitions="auto *">

        <ListBox Grid.Row="0"
                 Margin="32 4 32 4"
                 Style="{StaticResource PageTabs}"
                 ItemsSource="{Binding MenuItems}"
                 SelectedItem="{Binding NavManager.Selected, Mode=TwoWay}" />

        <Frame Grid.Row="1"
               Content="{Binding NavManager.CurrentPage}" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
