<Application x:Class="ModsDude.Client.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModsDude.Client.Wpf"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             xmlns:wvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Windows"
             xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
             xmlns:p="clr-namespace:ModsDude.Client.Wpf.View.Pages"
             xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
             xmlns:vc="clr-namespace:ModsDude.Client.Wpf.View.ValueConverters"
             xmlns:b="clr-namespace:ModsDude.Client.Wpf.View.Behaviors"
             DispatcherUnhandledException="Application_DispatcherUnhandledException"
             ThemeMode="Dark">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
                <ResourceDictionary Source="View/Resources/Controls.xaml"/>
                <ResourceDictionary Source="View/Resources/ModListItem.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type pvm:CreateRepoPageViewModel}">
                <p:CreateRepoPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:JoinRepoPageViewModel}">
                <p:JoinRepoPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:LoginPageViewModel}">
                <p:LoginPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:MainPageViewModel}">
                <p:MainPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:RepoPageViewModel}">
                <p:RepoPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:ExamplePageViewModel}">
                <p:ExamplePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:RepoAdminPageViewModel}">
                <p:RepoAdminPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:RepoOverviewPageViewModel}">
                <p:RepoOverviewPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:RepoMembersPageViewModel}">
                <p:RepoMembersPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:ProfileOverviewPageViewModel}">
                <p:ProfileOverviewPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:CreateProfilePageViewModel}">
                <p:CreateProfilePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:ProfilePageViewModel}">
                <p:ProfilePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:EditProfilePageViewModel}">
                <p:EditProfilePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:ProfileModsEditorPageViewModel}">
                <p:ProfileModsEditorPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:ProfileModsPageViewModel}">
                <p:ProfileModsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:ProfileHistoryPageViewModel}">
                <p:ProfileHistoryPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:ConnectGamePageViewModel}">
                <p:ConnectGamePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:GameSettingsPageViewModel}">
                <p:GameSettingsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:RepoSavegamesPageViewModel}">
                <p:RepoSavegamesPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:RepoModsPageViewModel}">
                <p:RepoModsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:ArchivePageViewModel}">
                <p:ArchivePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:RepoArchivePageViewModel}">
                <p:RepoArchivePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type pvm:SettingsPageViewModel}">
                <p:SettingsPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ModalViewModel}">
                <uc:Dialog />
            </DataTemplate>

            <!-- Without its own template this would fall through to the base ModalViewModel one
                 above and render as a confirmation dialog. -->
            <DataTemplate DataType="{x:Type vm:ErrorDialogViewModel}">
                <uc:ErrorDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModDetailsModalViewModel}">
                <uc:ModDetailsDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BlockedRevisionsModalViewModel}">
                <uc:BlockedRevisionsDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModDependentsModalViewModel}">
                <uc:ModDependentsDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModSourceConflictModalViewModel}">
                <uc:ModSourceConflictDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModVersionArbitrationModalViewModel}">
                <uc:ModVersionArbitrationDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModVersionReorderModalViewModel}">
                <uc:ModVersionReorderDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileLockedUpdatesModalViewModel}">
                <uc:ProfileLockedUpdatesDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CopyProfileModsModalViewModel}">
                <uc:CopyProfileModsDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PickProfileSourceModalViewModel}">
                <uc:PickProfileSourceDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PasteModListModalViewModel}">
                <uc:PasteModListDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RenameModalViewModel}">
                <uc:RenameDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UnrecognisedFilesModalViewModel}">
                <uc:UnrecognisedFilesDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileSaveAsModalViewModel}">
                <uc:ProfileSaveAsDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SavegameCheckOutModalViewModel}">
                <uc:SavegameCheckOutDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SavegameCheckInModalViewModel}">
                <uc:SavegameCheckInDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SavegamePublishModalViewModel}">
                <uc:SavegamePublishDialog />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SavegameSlotPickerModalViewModel}">
                <uc:SavegameSlotPickerDialog />
            </DataTemplate>

            <!-- One chip, three tones. Which of them a fact deserves is decided in the view model, so
                 that "this can damage a save" is never a colour somebody picked in a template. -->
            <DataTemplate DataType="{x:Type vm:SavegameChip}">
                <Border Margin="0 0 4 4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAccent}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCaution}" Value="True">
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding Text}" Style="{DynamicResource CaptionTextBlockStyle}" />
                </Border>
            </DataTemplate>

            <!-- The row for ModListItemViewModel is a template in View/Resources/ModListItem.xaml,
                 merged above. -->

            <vc:IconKindToStringConverter x:Key="IconKindToStringConverter" />
            <vc:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <vc:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

            <!-- A heading inside a sidebar list, for a list that is grouped. Deliberately quieter than
                 SidebarHeader, which names a whole list and carries an action: this one only says
                 which run of rows follows, so it is a caption and a rule and nothing else. -->
            <GroupStyle x:Key="SidebarGroupStyle">
                <!-- The theme's group container indents what is in it, which put a grouped list's pictures
                     a few pixels to the right of an ungrouped one's - and, in a rail, off the centre. The
                     heading and the rows are all this needs. -->
                <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GroupItem">
                                    <StackPanel>
                                        <ContentPresenter />
                                        <ItemsPresenter />
                                    </StackPanel>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GroupStyle.ContainerStyle>
                <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0 8 0 2">
                            <!-- Hidden rather than collapsed in a rail: the heading keeps its height, so
                                 the rows under it sit where they do at full width, and what is left is the
                                 rule - which is what still says that a new run of repos begins here. -->
                            <TextBlock Text="{Binding Name}"
                                       Margin="16 0 16 4"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0.7"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Height="1"
                                    Margin="16 0"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </GroupStyle.HeaderTemplate>
            </GroupStyle>

            <!-- The cell every row's picture sits in, and the one number that keeps it still: it is as wide as
                 a rail is, less what the list and its rows take off either side, so a glyph or a tile is drawn
                 at the same x whether the sidebar is a rail or open. Widen the rail (SidebarShell.CollapsedWidth)
                 and this has to move with it. -->
            <GridLength x:Key="SidebarIconColumn">56</GridLength>

            <Style x:Key="SidebarList" TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                <Setter Property="SelectionMode" Value="Single" />
                <!-- Selection is navigation here, so a drag down the list must not visit every item. -->
                <Setter Property="b:DragSelection.Suppressed" Value="True" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <!-- The tooltip and the enabled state live on the container rather than on the row's
                     own TextBlock, because WPF suppresses a tooltip on anything disabled unless
                     ShowOnDisabled says otherwise - and a closed entry whose explanation cannot be
                     read is worse than no explanation at all. -->
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                            <!-- The theme's row is at least 88 wide and pads itself 16 and 12 either side,
                                 which is more than a rail has, and would put the picture at a different x
                                 in a rail than open. The row lays itself out instead. -->
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate DataType="{x:Type vm:MenuItemViewModel}">
                            <Grid ClipToBounds="True">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <!-- Fluent's ListViewItem has no disabled appearance of its
                                                 own, so a closed entry would otherwise be
                                                 indistinguishable from an open one. On the row rather
                                                 than the title, so a tag dims along with it. -->
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- The picture, the title and the tag in cells of their own rather than runs of
                                     one TextBlock, so that the tag survives a name long enough to be trimmed. It
                                     is the half that says which of the two repos this is, so it must not be the
                                     half the ellipsis eats.

                                     The picture is always in the first cell, and the cell is always the same
                                     width: that is what keeps it still when the sidebar opens and closes. In a
                                     rail nothing else is drawn and the row is centred, which puts that cell in
                                     the middle of the rail; open, the row starts at the left edge, which puts it
                                     in the same place.

                                     A menu entry stays as wide as its content, so the tag follows its name
                                     immediately. A repo or a profile is different in two ways, both because its
                                     name is the one thing here that is not chosen by us and can be long. It gets
                                     two lines, in a row that is two lines tall whether or not the name needs them,
                                     so a list of them keeps one rhythm. And it fills the row, so the tag sits in
                                     the bottom-right corner rather than trailing a name that may have wrapped. -->
                                <Grid MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEntity}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter Property="MinHeight" Value="56" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource SidebarIconColumn}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- A menu entry's own glyph, dimmed a step below the title on purpose - it is
                                         there to be found at a glance, not read. -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Path=Icon}"
                                               Margin="0 8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEntity}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- What a repo or a profile is instead: a plain square with its first letter,
                                         the same at every width so that opening the sidebar only adds the name
                                         beside it. Where the game follows the profile - or where a repo's does and
                                         has drifted - the letter gives way to the status: green check, amber
                                         warning, or an arrow that turns while an apply runs. -->
                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            Margin="0 14"
                                            CornerRadius="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEntity}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasStatus, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                            <TextBlock Text="{Binding DisplayIcon}"
                                                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5 0.5"
                                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </TextBlock.RenderTransform>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SyncState}" Value="InSync">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SyncState}" Value="Drifted">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SyncState}" Value="NotApplied">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SyncState}" Value="Applying">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SpinIcon">
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                                             From="0" To="360" Duration="0:0:1.2"
                                                                                             RepeatBehavior="Forever" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="SpinIcon" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Path=Title}"
                                               Padding="0 8 12 8"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <!-- Exactly two lines' worth of room, whatever the name
                                                         needs: the block line height is what makes the cap
                                                         a number of lines rather than of pixels, and it is
                                                         what lets the trimming find the end of the second. -->
                                                    <DataTrigger Binding="{Binding IsEntity}" Value="True">
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Setter Property="LineHeight" Value="20" />
                                                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                                        <Setter Property="MaxHeight" Value="56" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- TagText carries its own leading space, so the row reads
                                         "Vanilla #1234" and the tooltip spells it the same way. -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Path=TagText}"
                                               Padding="0 8 12 8"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEntity}" Value="True">
                                                        <Setter Property="VerticalAlignment" Value="Bottom" />
                                                        <Setter Property="FontSize" Value="12" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
