<UserControl x:Class="ModsDude.Client.Wpf.Friends.FriendProfileGroupRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:account="clr-namespace:ModsDude.Client.Wpf.Account"
             xmlns:friends="clr-namespace:ModsDude.Client.Wpf.Friends"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=friends:FriendProfileGroupViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="640">

    <!-- One mod list friends are on: who, which profile, when, and the button that follows them. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ItemsControl Grid.Column="0" Margin="0 0 8 0" VerticalAlignment="Center" ItemsSource="{Binding Friends}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type friends:FriendAvatar}">
                    <Border Margin="0 0 4 0" Background="Transparent" ToolTip="{Binding Name}">
                        <account:UserAvatar Width="24" Height="24" DataContext="{Binding Avatar}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding ProfileName}" />
            <Border Margin="8 0 0 0"
                    Style="{StaticResource StatusChip}"
                    Visibility="{Binding HasRevision, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="{Binding RevisionText}" />
            </Border>
            <Border Margin="8 0 0 0"
                    Style="{StaticResource SuccessStatusChip}"
                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Text="Playing" />
            </Border>
        </StackPanel>

        <TextBlock Grid.Column="2" Margin="12 0 0 0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding LastActive}" />

        <!-- The button where following would change something, and the reason in its place where it would not. -->
        <StackPanel Grid.Column="3" Orientation="Vertical" Margin="12 0 0 0" VerticalAlignment="Center">
            <Button Style="{DynamicResource AccentButtonStyle}"
                    Content="{Binding FollowLabel}"
                    Command="{Binding FollowCommand}"
                    IsEnabled="{Binding IsIdle}"
                    Visibility="{Binding CanFollow, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock MaxWidth="220" TextWrapping="Wrap" TextAlignment="Right"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasFollowBlocked, Converter={StaticResource BoolToVisibilityConverter}}"
                       Text="{Binding FollowBlocked}" />
        </StackPanel>
    </Grid>
</UserControl>
