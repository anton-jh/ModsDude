<Page x:Class="ModsDude.Client.Wpf.Games.ConnectGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:games="clr-namespace:ModsDude.Client.Wpf.Games"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance games:ConnectGamePageViewModel, IsDesignTimeCreatable=False}"
      Title="ConnectGamePage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Connect game" />

                <TextBlock Margin="0 0 0 16"
                           TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="Points ModsDude at your installation of" />
                    <Run Text="{Binding GameName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="on this machine. It is configured once and offered under every repo about that game." />
                </TextBlock>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="Folders" Padding="0 16 0 16">
                        <games:DynamicFormEditor DataContext="{Binding LocalSettingsEditor}" />
                    </GroupBox>
                </Border>

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource PageActions}">
            <Button Width="250" Style="{DynamicResource AccentButtonStyle}"
                    Content="Connect" Command="{Binding Path=SaveChangesCommand}" />
        </StackPanel>

    </Grid>
</Page>