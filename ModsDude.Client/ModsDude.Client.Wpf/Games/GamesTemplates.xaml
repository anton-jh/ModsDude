<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:games="clr-namespace:ModsDude.Client.Wpf.Games">

    <DataTemplate DataType="{x:Type games:ConnectGamePageViewModel}">
        <games:ConnectGamePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type games:GameSettingsPageViewModel}">
        <games:GameSettingsPage />
    </DataTemplate>

    <!-- A label/value row. The label column is shared across the rows of one list, so the values line
         up; the list sets Grid.IsSharedSizeScope. -->
    <DataTemplate DataType="{x:Type games:GameDetailLine}">
        <Grid RowDefinitions="Auto, Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="GameDetailLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0 0 16 0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Label}" />
            <TextBlock Grid.Column="1"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Value}"
                       Text="{Binding Value}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding Note}"
                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
