<UserControl x:Class="ModsDude.Client.Wpf.Games.DeactivateGameMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:games="clr-namespace:ModsDude.Client.Wpf.Games"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance games:GameStatusViewModel, IsDesignTimeCreatable=False}">

    <!-- For managing the mods by hand for a while without ModsDude objecting. -->
    <StackPanel>
        <ToggleButton x:Name="DeactivateToggle"
                      Content="Deactivate  ▾" />

        <Popup IsOpen="{Binding IsChecked, ElementName=DeactivateToggle, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=DeactivateToggle}"
               Placement="Bottom"
               VerticalOffset="4"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Style="{StaticResource PopupSurface}">
                <StackPanel Orientation="Vertical">
                    <Button Width="340"
                            Style="{DynamicResource SubtleMenuButton}"
                            Command="{Binding DeactivateCommand}"
                            Click="CloseMenu">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Deactivate, keep the mods" FontWeight="SemiBold" />
                            <TextBlock Text="Stops following the profile. Mod folders stay as they are."
                                       Margin="0 2 0 0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Width="340"
                            Style="{DynamicResource SubtleMenuButton}"
                            Command="{Binding DeactivateAndClearCommand}"
                            Click="CloseMenu">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Deactivate and clear the mods" FontWeight="SemiBold" />
                            <TextBlock Text="Stops following the profile. Removes every mod from the mod folders."
                                       Margin="0 2 0 0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
