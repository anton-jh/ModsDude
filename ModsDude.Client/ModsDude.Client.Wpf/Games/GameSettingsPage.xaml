<shared:AppPage x:Class="ModsDude.Client.Wpf.Games.GameSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:games="clr-namespace:ModsDude.Client.Wpf.Games"
      xmlns:navigation="clr-namespace:ModsDude.Client.Wpf.Shell.Navigation"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance games:GameSettingsPageViewModel, IsDesignTimeCreatable=False}"
      Title="GameSettingsPage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <navigation:PageTitle Text="Configure game" BackCommand="{Binding BackCommand}" />

                <TextBlock Margin="0 0 0 24"
                           TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Summary}" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="Folders" Padding="0 16 0 16">
                        <games:DynamicFormEditor DataContext="{Binding LocalSettingsEditor}" />
                    </GroupBox>
                </Border>

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource PageActions}">
            <Button Width="250" Style="{DynamicResource AccentButtonStyle}"
                    Content="Save changes" Command="{Binding Path=SaveChangesCommand}" />
        </StackPanel>

    </Grid>
</shared:AppPage>
