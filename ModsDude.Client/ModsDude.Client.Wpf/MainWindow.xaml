<Window x:Class="ModsDude.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModsDude.Client.Wpf"
        xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
        xmlns:wvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Windows"
        xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
        xmlns:p="clr-namespace:ModsDude.Client.Wpf.View.Pages"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=wvm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="ModsDude" Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontSize="14">

    <Grid>
        <!-- The rail is a real column of the window, so the content area genuinely ends where it
             begins and nothing is ever drawn underneath it. It is Auto and collapses to nothing
             while there is nothing to say, which is most of the time.

             The expanded panel is an overlay inside column 0 instead, and that asymmetry is
             deliberate: it opens uninvited - a notice the user has not seen re-opens it - and taking
             420px out of a mod list mid-scroll would recompute every column width and re-wrap every
             row under somebody's hands. A rail appearing is 32px and stable; a panel appearing is
             sudden and temporary, so it floats and casts a shadow. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Frame Grid.Column="0"
               Content="{Binding Path=CurrentPage}"
               NavigationUIVisibility="Hidden"
               Margin="0 12 0 0"/>

        <!-- Along the top edge, and about the present rather than the past: the two notices in the
             bottom corner both report something that has already happened and both offer a way to
             deal with it, so this one is somewhere else on purpose. It survives navigation - an
             import queued on one page is still visible from another - which is the half a page's own
             progress cannot do. Nothing to dismiss: it goes when the work does. -->
        <Border Grid.Column="0"
                DataContext="{Binding BackgroundTasks}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                MinWidth="360" MaxWidth="560"
                Margin="0 4 0 0"
                Padding="16 10"
                CornerRadius="6"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.Effect>
                <DropShadowEffect Color="#66000000" BlurRadius="12" ShadowDepth="2" />
            </Border.Effect>

            <StackPanel Orientation="Vertical">

                <Grid ColumnDefinitions="* auto auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <!-- One task at a time, with the others an arrow away rather than a second bar
                         racing this one. Nothing pages itself: a task starting while somebody is
                         watching another leaves a dot here instead of taking the strip. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="12 0 0 0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="&#x2039;"
                                Padding="6 0"
                                MinWidth="0"
                                Command="{Binding PreviousCommand}"
                                IsEnabled="{Binding CanGoPrevious}" />

                        <TextBlock Text="{Binding PagerText}"
                                   Margin="6 0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <Ellipse Width="6" Height="6"
                                 Margin="0 0 6 0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                 Visibility="{Binding HasUnseen, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Button Content="&#x203a;"
                                Padding="6 0"
                                MinWidth="0"
                                Command="{Binding NextCommand}"
                                IsEnabled="{Binding CanGoNext}" />
                    </StackPanel>

                    <!-- The only control on the strip, and only for the task on screen - which is why
                         the pager beside it matters. It has to live here rather than on the page that
                         started the job: a page is rebuilt from scratch on every navigation, so the
                         Cancel somebody had disappears the moment they use the freedom this strip
                         exists to give them. It asks rather than kills - a sync stops at the next file
                         - so the entry stays up until the work unwinds, which is why the button goes
                         away on the first press rather than inviting a second.

                         Greyed rather than hidden for the second after a task ends underneath it: a
                         click aimed at work that has just finished must not land on its neighbour,
                         and a button that vanished would move everything beside it. -->
                    <Button Grid.Column="2"
                            Content="Cancel"
                            Margin="12 0 0 0"
                            Padding="10 2"
                            VerticalAlignment="Center"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsCancelEnabled}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <TextBlock Text="{Binding Detail}"
                           Margin="0 2 0 0"
                           TextTrimming="CharacterEllipsis"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ProgressBar Height="3"
                             Margin="0 8 0 0"
                             Minimum="0" Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}" />

                <!-- Only the parts that have been going long enough to be worth naming. The fast ones
                     are the count on the line above: five names cycling through one line is what this
                     replaced, and five rows cycling would be that plus a strip that changes height. -->
                <ItemsControl ItemsSource="{Binding Subtasks}"
                              Margin="0 8 0 0"
                              Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BackgroundSubtaskViewModel}">
                            <StackPanel Margin="0 0 0 6">
                                <Grid ColumnDefinitions="* auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Amount}"
                                               Margin="12 0 0 0"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding HasAmount, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>

                                <ProgressBar Height="2"
                                             Margin="0 3 0 0"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding MoreSubtasks}"
                           TextTrimming="CharacterEllipsis"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasMoreSubtasks, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- Beside the modal slot, not in it. Everything in this column has to be visible from every
             view and must not stop the user working: the drift already happened while they were in
             the game, and the background failures are things the app chose to absorb.

             A column rather than the single card that used to sit in this corner. That card
             multiplexed the mod half, the locked half, the savegame half and the shared mod cache
             into one box, showed the first drifted game and summarised the rest as "3 games have
             drifted", and closed the lists it could not fit with "2 more savegame problems here as
             well" - list items flattened into sentences because there was one card to put them in.

             It is a surface rather than cards floating on the page: with several of them the
             floating version read as debris scattered over whatever was underneath, and there was
             nowhere to put the things that belong to the column rather than to any one card. -->
        <Border Grid.Column="0"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="420"
                Margin="0 12 0 0"
                Padding="12"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderThickness="1 0 0 0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                DataContext="{Binding Notices}">

            <!--<Border.Effect>
                <DropShadowEffect Color="#50000000" BlurRadius="16" ShadowDepth="0" Direction="180" />
            </Border.Effect>-->

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsVisible}" Value="True" />
                                <Condition Binding="{Binding IsCollapsed}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The column's own header: what belongs to the list rather than to any card in it.
                 Collapsing lives here rather than on the rail's far side so that the button which
                 closes it is where the user is already looking. -->
            <Grid Grid.Row="0" ColumnDefinitions="* auto" Margin="4 0 0 8">
                <TextBlock Grid.Column="0"
                           Text="Notices"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <Button Grid.Column="1"
                        Padding="8 4"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Collapse. A notice you have not seen opens it again."
                        Command="{Binding ToggleCollapsedCommand}">
                    <TextBlock Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Top-anchored, under the header. It hung from the bottom while the cards floated on
                 the page with nothing behind them, which put one notice in the corner the single
                 card used to occupy; on a filled surface the same trick leaves a panel that is
                 mostly empty above its own contents, which reads as something that failed to
                 load. -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Top">

                <ItemsControl ItemsSource="{Binding Notices}"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NoticeViewModel}">
                            <StackPanel Margin="0 0 0 8">

                                <!-- Only above the first card of a run, and only where a game
                                     contributed more than one: three folders of one game reading as
                                     three games in trouble is the one real objection to a column. -->
                                <TextBlock Text="{Binding GroupLabel}"
                                           Margin="4 8 0 4"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding HasGroupHeading, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Border Padding="16"
                                        CornerRadius="6"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#40000000" BlurRadius="10" ShadowDepth="1" />
                                    </Border.Effect>

                                    <!-- The left edge says what is at stake, because the column is
                                         read top down and the colour is what survives a glance.
                                         Critical is the one that can cost an evening.

                                         Thickness and brush are both set by the style and neither is
                                         set on the element: a local value outranks a trigger's
                                         setter in WPF, so a BorderBrush written as an attribute here
                                         would silently win and every card would draw the same
                                         colour. -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter Property="BorderThickness" Value="4 1 1 1" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="BorderThickness" Value="4 1 1 1" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Pending">
                                                    <Setter Property="BorderThickness" Value="4 1 1 1" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel Orientation="Vertical">

                                        <Grid ColumnDefinitions="* auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Headline}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                            <!-- The whole card is the hit target for expanding, so a
                                                 collapsed one does not need aiming at. -->
                                            <Button Grid.Column="1"
                                                    Margin="8 -4 -4 0"
                                                    Padding="6 2"
                                                    VerticalAlignment="Top"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding ToggleExpandedCommand}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE70D;" />
                                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                                            <Setter Property="FontSize" Value="10" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE70E;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>

                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">

                                            <TextBlock Text="{Binding Body}"
                                                       Margin="0 8 0 0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <TextBlock Text="{Binding Footnote}"
                                                       Margin="0 8 0 0"
                                                       TextWrapping="Wrap"
                                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding HasFootnote, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <!-- Outside the collapsible half: what the last press did is
                                             the one thing a collapsed card must not swallow. -->
                                        <TextBlock Text="{Binding Status}"
                                                   Margin="0 8 0 0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <WrapPanel Orientation="Horizontal" Margin="0 12 0 0"
                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">

                                            <ItemsControl ItemsSource="{Binding Actions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:NoticeActionViewModel}">
                                                        <!-- Declared twice because a WPF style cannot set the
                                                             Style property, so the accent cannot be moved by a
                                                             trigger. Exactly one is ever visible. -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="{Binding Label}"
                                                                    Margin="0 0 8 0"
                                                                    Style="{DynamicResource AccentButtonStyle}"
                                                                    Command="{Binding InvokeCommand}"
                                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                            <Button Content="{Binding Label}"
                                                                    Margin="0 0 8 0"
                                                                    Command="{Binding InvokeCommand}"
                                                                    Visibility="{Binding IsSecondary, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="Dismiss"
                                                    Command="{Binding DismissCommand}"
                                                    Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </WrapPanel>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- The column's own footer: the tail it is holding back, and the one gesture for the
                 morning after an update-all that touched every game on the machine. -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 8 0 0">

                <Button Content="{Binding Overflow}"
                        Margin="0 0 8 0"
                        Command="{Binding ToggleShowAllCommand}"
                        Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Content="Dismiss all"
                        Command="{Binding DismissAllCommand}"
                        Visibility="{Binding CanDismissAll, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            </Grid>
        </Border>

        <!-- The rail. It is what is on screen while the column is closed, so it has to carry enough
             to decide whether to open it - which is why it says a count per severity rather than a
             total. "4 notices" answers nothing; "1 critical, 3 info" is the whole decision.

             Eye-catching by a stripe and coloured counts rather than by a tinted rail: a rail that
             goes solid red for a critical is solid grey for everything else, which spends the
             loudest thing on screen on the difference between "look now" and "look". -->
        <Button Grid.Column="1"
                Width="34"
                ToolTip="Show notices"
                Command="{Binding Notices.ToggleCollapsedCommand}"
                Margin="0 12 0 0">

            <!-- Its own template rather than the theme's. A Fluent Button lays its content out in a
                 padded, centred, corner-rounded box, which leaves the stripe floating in the middle
                 of the rail at the height of the text beside it and clips the rotated words. What
                 this needs is the whole column to paint in. -->
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1 0 0 0"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Notices.IsVisible}" Value="True" />
                                <Condition Binding="{Binding Notices.IsCollapsed}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

            <Grid DataContext="{Binding Notices}" ColumnDefinitions="4 *">

                <!-- Full height, in the worst severity's colour. The one thing visible from across
                     the room. -->
                <Rectangle Grid.Column="0"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighestSeverity}" Value="Critical">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HighestSeverity}" Value="Warning">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HighestSeverity}" Value="Pending">
                                    <Setter Property="Fill" Value="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Margin="0 12 0 0">

                    <TextBlock Text="&#xE76B;"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- Rotated rather than one glyph per line: the counts are words, and a column
                         of single letters is a puzzle. Top-to-bottom, which is the direction a rail
                         on the right edge is read in.

                         The width is explicit and is the pre-rotation one, so it is the height this
                         ends up occupying. Without it the text is measured against the rail's own
                         34px - LayoutTransform constrains the child before it turns it - and every
                         label is clipped to about "2 cri". -->
                    <ItemsControl ItemsSource="{Binding SeverityCounts}"
                                  Width="260"
                                  Margin="0 14 0 0"
                                  HorizontalAlignment="Center">
                        <ItemsControl.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </ItemsControl.LayoutTransform>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NoticeSeverityCountViewModel}">
                                <TextBlock Text="{Binding Label}"
                                           Margin="0 0 12 0"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Pending">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Button>

        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="{Binding IsModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Margin="0 12 0 0">

            <ContentControl Content="{Binding Modal}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

        </Grid>
    </Grid>

</Window>
