<Window x:Class="ModsDude.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModsDude.Client.Wpf"
        xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
        xmlns:wvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Windows"
        xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
        xmlns:p="clr-namespace:ModsDude.Client.Wpf.View.Pages"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=wvm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="ModsDude" Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontSize="14">

    <Grid>
        <Frame Content="{Binding Path=CurrentPage}"
               NavigationUIVisibility="Hidden"
               Margin="0 12 0 0"/>

        <!-- Along the top edge, and about the present rather than the past: the two notices in the
             bottom corner both report something that has already happened and both offer a way to
             deal with it, so this one is somewhere else on purpose. It survives navigation - an
             import queued on one page is still visible from another - which is the half a page's own
             progress cannot do. Nothing to dismiss: it goes when the work does. -->
        <Border DataContext="{Binding BackgroundTasks}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                MinWidth="360" MaxWidth="560"
                Margin="0 4 0 0"
                Padding="16 10"
                CornerRadius="6"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.Effect>
                <DropShadowEffect Color="#66000000" BlurRadius="12" ShadowDepth="2" />
            </Border.Effect>

            <StackPanel Orientation="Vertical">

                <Grid ColumnDefinitions="* auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <!-- A count rather than a second bar: two bars racing each other is less legible
                         than one and a number, and a second concurrent task is rare. -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Others}"
                               Margin="12 0 0 0"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding HasOthers, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <TextBlock Text="{Binding Detail}"
                           Margin="0 2 0 0"
                           TextTrimming="CharacterEllipsis"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ProgressBar Height="3"
                             Margin="0 8 0 0"
                             Minimum="0" Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}" />
            </StackPanel>
        </Border>

        <!-- Beside the modal slot, not in it. Both notices have to be visible from every view and
             must not stop the user working: the drift already happened while they were in the game,
             and the background failures are things the app chose to absorb. They stack rather than
             share the corner, with drift on top - it is the one that can cost a savegame. -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0 0 24 24"
                    MaxWidth="460">

            <Border DataContext="{Binding DriftNotification}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0 0 0 12"
                    Padding="20"
                    CornerRadius="6"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}">

                <StackPanel Orientation="Vertical">

                    <TextBlock Text="{Binding Headline}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Text="{Binding Detail}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Its own line, in its own colour: a locked map at the wrong version is not a
                         tidiness problem. -->
                    <TextBlock Text="{Binding LockedWarning}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasLockedWarning, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- The savegame half, and it can be the whole reason this notice is up: a folder
                         that matches its profile exactly is still worth warning about while it holds
                         an evening nobody else can see. Same colour as the locked warning, because it
                         is the same class of problem - something on this disk only. -->
                    <TextBlock Text="{Binding SavegameWarning}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasSavegameWarning, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="{Binding ImportPrompt}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding HasImportPrompt, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="{Binding Status}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <WrapPanel Orientation="Horizontal" Margin="0 16 0 0">

                        <!-- Review leads: what is in the folder now is usually what the user meant to
                             end up with, and re-applying before looking throws it away. -->
                        <Button Content="Review"
                                Margin="0 0 8 0"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding OpenModListCommand}"
                                Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Declared twice because a WPF style cannot set the Style property, so the
                             accent cannot be moved by a trigger. Exactly one is ever visible: the
                             plain one beside Review, and the accent one for a guest, whose notice
                             would otherwise have nothing on it that looks like the thing to do. -->
                        <Button Content="Re-apply now"
                                Margin="0 0 8 0"
                                Command="{Binding ReapplyCommand}"
                                Visibility="{Binding CanReapplyBesideReview, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Button Content="Re-apply now"
                                Margin="0 0 8 0"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding ReapplyCommand}"
                                Visibility="{Binding ReapplyIsPrimary, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Button Content="Dismiss"
                                Command="{Binding DismissCommand}" />
                    </WrapPanel>

                </StackPanel>
            </Border>

            <!-- The quiet one. No accent button and no fix to offer: it reports that something the app
                 absorbed did in fact happen, and points at the log. -->
            <Border DataContext="{Binding BackgroundProblems}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="16"
                    CornerRadius="6"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">

                <StackPanel Orientation="Vertical">

                    <TextBlock Text="{Binding Headline}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Text="{Binding Detail}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <WrapPanel Orientation="Horizontal" Margin="0 12 0 0">
                        <Button Content="Open log folder"
                                Margin="0 0 8 0"
                                Command="{Binding OpenLogCommand}" />

                        <Button Content="Dismiss"
                                Command="{Binding DismissCommand}" />
                    </WrapPanel>

                </StackPanel>
            </Border>

        </StackPanel>

        <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="{Binding IsModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Margin="0 12 0 0">

            <ContentControl Content="{Binding Modal}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

        </Grid>
    </Grid>

</Window>
