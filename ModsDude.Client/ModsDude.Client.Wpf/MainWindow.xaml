<Window x:Class="ModsDude.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModsDude.Client.Wpf"
        xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
        xmlns:wvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Windows"
        xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
        xmlns:p="clr-namespace:ModsDude.Client.Wpf.View.Pages"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=wvm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="ModsDude" Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontSize="14">

    <Grid>
        <Frame Content="{Binding Path=CurrentPage}"
               NavigationUIVisibility="Hidden"
               Margin="0 12 0 0"/>

        <!-- Beside the modal slot, not in it. Both notices have to be visible from every view and
             must not stop the user working: the drift already happened while they were in the game,
             and the background failures are things the app chose to absorb. They stack rather than
             share the corner, with drift on top - it is the one that can cost a savegame. -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0 0 24 24"
                    MaxWidth="460">

            <Border DataContext="{Binding DriftNotification}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0 0 0 12"
                    Padding="20"
                    CornerRadius="6"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}">

                <StackPanel Orientation="Vertical">

                    <TextBlock Text="{Binding Headline}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Text="{Binding Detail}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- Its own line, in its own colour: a locked map at the wrong version is not a
                         tidiness problem. -->
                    <TextBlock Text="{Binding LockedWarning}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasLockedWarning, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="{Binding ImportPrompt}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding HasImportPrompt, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="{Binding Status}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <WrapPanel Orientation="Horizontal" Margin="0 16 0 0">

                        <!-- Review leads: what is in the folder now is usually what the user meant to
                             end up with, and re-applying before looking throws it away. -->
                        <Button Content="Review"
                                Margin="0 0 8 0"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding OpenModListCommand}"
                                Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Declared twice because a WPF style cannot set the Style property, so the
                             accent cannot be moved by a trigger. Exactly one is ever visible: the
                             plain one beside Review, and the accent one for a guest, whose notice
                             would otherwise have nothing on it that looks like the thing to do. -->
                        <Button Content="Re-apply now"
                                Margin="0 0 8 0"
                                Command="{Binding ReapplyCommand}"
                                Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Button Content="Re-apply now"
                                Margin="0 0 8 0"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding ReapplyCommand}"
                                Visibility="{Binding ReapplyIsPrimary, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Button Content="Dismiss"
                                Command="{Binding DismissCommand}" />
                    </WrapPanel>

                </StackPanel>
            </Border>

            <!-- The quiet one. No accent button and no fix to offer: it reports that something the app
                 absorbed did in fact happen, and points at the log. -->
            <Border DataContext="{Binding BackgroundProblems}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="16"
                    CornerRadius="6"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">

                <StackPanel Orientation="Vertical">

                    <TextBlock Text="{Binding Headline}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Text="{Binding Detail}"
                               Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <WrapPanel Orientation="Horizontal" Margin="0 12 0 0">
                        <Button Content="Open log folder"
                                Margin="0 0 8 0"
                                Command="{Binding OpenLogCommand}" />

                        <Button Content="Dismiss"
                                Command="{Binding DismissCommand}" />
                    </WrapPanel>

                </StackPanel>
            </Border>

        </StackPanel>

        <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="{Binding IsModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Margin="0 12 0 0">

            <ContentControl Content="{Binding Modal}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

        </Grid>
    </Grid>

</Window>
