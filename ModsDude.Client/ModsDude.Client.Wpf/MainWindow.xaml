<Window x:Class="ModsDude.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModsDude.Client.Wpf"
        xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
        xmlns:wvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Windows"
        xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
        xmlns:p="clr-namespace:ModsDude.Client.Wpf.View.Pages"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=wvm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="ModsDude" Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontSize="14">

    <Grid>
        <Frame Content="{Binding Path=CurrentPage}"
               NavigationUIVisibility="Hidden"
               Margin="0 12 0 0"/>

        <!-- Along the top edge, and about the present rather than the past: the two notices in the
             bottom corner both report something that has already happened and both offer a way to
             deal with it, so this one is somewhere else on purpose. It survives navigation - an
             import queued on one page is still visible from another - which is the half a page's own
             progress cannot do. Nothing to dismiss: it goes when the work does. -->
        <Border DataContext="{Binding BackgroundTasks}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                MinWidth="360" MaxWidth="560"
                Margin="0 4 0 0"
                Padding="16 10"
                CornerRadius="6"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Border.Effect>
                <DropShadowEffect Color="#66000000" BlurRadius="12" ShadowDepth="2" />
            </Border.Effect>

            <StackPanel Orientation="Vertical">

                <Grid ColumnDefinitions="* auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <!-- A count rather than a second bar: two bars racing each other is less legible
                         than one and a number, and a second concurrent task is rare. -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Others}"
                               Margin="12 0 0 0"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding HasOthers, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <TextBlock Text="{Binding Detail}"
                           Margin="0 2 0 0"
                           TextTrimming="CharacterEllipsis"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ProgressBar Height="3"
                             Margin="0 8 0 0"
                             Minimum="0" Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}" />
            </StackPanel>
        </Border>

        <!-- Beside the modal slot, not in it. Everything in this column has to be visible from every
             view and must not stop the user working: the drift already happened while they were in
             the game, and the background failures are things the app chose to absorb.

             A column rather than the single card that used to sit in this corner. That card
             multiplexed the mod half, the locked half, the savegame half and the shared mod cache
             into one box, showed the first drifted game and summarised the rest as "3 games have
             drifted", and closed the lists it could not fit with "2 more savegame problems here as
             well" - list items flattened into sentences because there was one card to put them in.

             Overlaid rather than given a gutter, and zero-width when empty: a fixed column would
             cost horizontal space permanently in an app that is already three sidebars deep, and
             it is empty most of the time. -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Width="420"
              Margin="0 56 16 16"
              DataContext="{Binding Notices}"
              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Bottom-anchored inside its own scroller, so one notice sits in the corner where the
                 single card used to and a full column grows upward into space the page was not
                 using. -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Bottom">

                <ItemsControl ItemsSource="{Binding Notices}"
                              VerticalAlignment="Bottom">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NoticeViewModel}">
                            <StackPanel Margin="0 0 0 8">

                                <!-- Only above the first card of a run, and only where a game
                                     contributed more than one: three folders of one game reading as
                                     three games in trouble is the one real objection to a column. -->
                                <TextBlock Text="{Binding GroupLabel}"
                                           Margin="4 8 0 4"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding HasGroupHeading, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Border Padding="16"
                                        CornerRadius="6"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#40000000" BlurRadius="10" ShadowDepth="1" />
                                    </Border.Effect>

                                    <!-- The border says what is at stake, because the column is read
                                         top down and the colour is what survives a glance. Critical
                                         is the one that can cost an evening. -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel Orientation="Vertical">

                                        <Grid ColumnDefinitions="* auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Headline}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                            <!-- The whole card is the hit target for expanding, so a
                                                 collapsed one does not need aiming at. -->
                                            <Button Grid.Column="1"
                                                    Margin="8 -4 -4 0"
                                                    Padding="6 2"
                                                    VerticalAlignment="Top"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding ToggleExpandedCommand}">
                                                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE70D;" />
                                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                                            <Setter Property="FontSize" Value="10" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE70E;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>

                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">

                                            <TextBlock Text="{Binding Body}"
                                                       Margin="0 8 0 0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <TextBlock Text="{Binding Footnote}"
                                                       Margin="0 8 0 0"
                                                       TextWrapping="Wrap"
                                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding HasFootnote, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <!-- Outside the collapsible half: what the last press did is
                                             the one thing a collapsed card must not swallow. -->
                                        <TextBlock Text="{Binding Status}"
                                                   Margin="0 8 0 0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <WrapPanel Orientation="Horizontal" Margin="0 12 0 0"
                                                   Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">

                                            <ItemsControl ItemsSource="{Binding Actions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:NoticeActionViewModel}">
                                                        <!-- Declared twice because a WPF style cannot set the
                                                             Style property, so the accent cannot be moved by a
                                                             trigger. Exactly one is ever visible. -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="{Binding Label}"
                                                                    Margin="0 0 8 0"
                                                                    Style="{DynamicResource AccentButtonStyle}"
                                                                    Command="{Binding InvokeCommand}"
                                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                            <Button Content="{Binding Label}"
                                                                    Margin="0 0 8 0"
                                                                    Command="{Binding InvokeCommand}"
                                                                    Visibility="{Binding IsSecondary, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="Dismiss"
                                                    Command="{Binding DismissCommand}"
                                                    Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </WrapPanel>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- The column's own footer: the tail it is holding back, and the one gesture for the
                 morning after an update-all that touched every game on the machine. -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 8 0 0">

                <Button Content="{Binding Overflow}"
                        Margin="0 0 8 0"
                        Command="{Binding ToggleShowAllCommand}"
                        Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Content="Dismiss all"
                        Command="{Binding DismissAllCommand}"
                        Visibility="{Binding CanDismissAll, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

        </Grid>

        <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="{Binding IsModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Margin="0 12 0 0">

            <ContentControl Content="{Binding Modal}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

        </Grid>
    </Grid>

</Window>
