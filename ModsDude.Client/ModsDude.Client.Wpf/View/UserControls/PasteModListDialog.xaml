<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.PasteModListDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="560" MaxHeight="620"
             d:DataContext="{d:DesignInstance Type=vm:PasteModListModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto * auto auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 12">
                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBox Grid.Row="1"
                     x:Name="PasteBox"
                     Margin="24 0"
                     MinHeight="180"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="2" Margin="24 8 24 0">
                <TextBlock Text="{Binding CountText}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{DynamicResource BodyStrongTextBlockStyle}" />

                <TextBlock Text="{Binding Hint}"
                           Margin="0 4 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Row="3"
                    Margin="0 16 0 0"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">

                <Grid Margin="24 16 24 20" ColumnDefinitions="* *">
                    <Button Grid.Column="0"
                            Margin="0 0 4 0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="Find these mods"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ConfirmCommand}" />

                    <Button Grid.Column="1"
                            Margin="4 0 0 0"
                            Content="Cancel"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

</UserControl>
