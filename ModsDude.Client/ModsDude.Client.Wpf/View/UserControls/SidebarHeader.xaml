<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.SidebarHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
             xmlns:b="clr-namespace:ModsDude.Client.Wpf.View.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=local:SidebarHeader, IsDesignTimeCreatable=True}">

    <Grid ColumnDefinitions="* auto auto" Margin="0 32 0 0">
        <Grid.RowDefinitions>
            <!-- As tall as the buttons make it, whether or not they are drawn: a rail collapses them, and the rows
                 under this must not move up when it does. -->
            <RowDefinition Height="Auto" MinHeight="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The name of the list under it. In a rail it is what is left of the header: the heading, where the
             buttons are open. The buttons are still there in the peek. They are collapsed, and the row has a
             minimum height, so nothing below it moves.

             It is always at the left of a row that spans the whole header, and moved sideways with a transform
             to where a rail would centre it. The code-behind works that out once; it is the same open as
             collapsed, so opening the sidebar changes nothing about it. -->
        <TextBlock x:Name="TitleText"
                   Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Margin="0 0 0 4"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Opacity="0.7"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="TitleShift" X="16" />
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- Creating one of what the list below holds. It is a page like any other, so while that page
             is open the button is drawn the way a selected row is: the sidebar always says where you are,
             and this is the one place it would otherwise go quiet. The tooltip is the item's own, which
             is the reason where the membership level does not allow it - and it shows on the disabled
             button for the same reason the rows' tooltips do. -->
        <Border Grid.Column="1" Grid.Row="0"
                Margin="8 0 0 4"
                CornerRadius="4"
                VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAddSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Button Style="{StaticResource SubtleIconButton}"
                    Width="26" Height="26"
                    Command="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    IsEnabled="{Binding IsAddEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTip="{Binding AddToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTipService.InitialShowDelay="200">
                <TextBlock Text="&#xE710;" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAddEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </Border>

        <Button Grid.Column="2" Grid.Row="0"
                Margin="4 0 16 4"
                VerticalAlignment="Center"
                Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ToolTip="{Binding ActionToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ToolTipService.InitialShowDelay="200"
                Background="Transparent"
                BorderThickness="0"
                Padding="4"
                MinWidth="0"
                MinHeight="0">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <TextBlock Text="{Binding ActionIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>

        <Separator Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                   Foreground="{DynamicResource DividerStrokeColorDefaultBrush}"
                   Margin="4 4" />

    </Grid>

</UserControl>
