<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.PickProfileSourceDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="520" MaxHeight="560"
             d:DataContext="{d:DesignInstance Type=vm:PickProfileSourceModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto * auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 12">
                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="24 0"
                    MinHeight="120"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid>

                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Margin="4 6"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding EmptyText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="24 0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="0 16 0 0"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">

                <Grid Margin="24 16 24 20" ColumnDefinitions="* *">
                    <Button Grid.Column="0"
                            Margin="0 0 4 0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="Read this profile"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ConfirmCommand}" />

                    <Button Grid.Column="1"
                            Margin="4 0 0 0"
                            Content="Cancel"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

</UserControl>
