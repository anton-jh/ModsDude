<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.ModDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:b="clr-namespace:ModsDude.Client.Wpf.View.Behaviors"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="920" Height="620"
             d:DataContext="{d:DesignInstance Type=vm:ModDetailsModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            FocusManager.FocusedElement="{Binding ElementName=CloseButton}">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto * auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 16">
                <TextBlock Text="{Binding Name}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                    <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                               Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                    <TextBlock Text="•" Margin="8 0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Id}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="•" Margin="8 0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Author}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="24 0 24 0" ColumnDefinitions="400 *">

                <Grid Grid.Column="0" RowDefinitions="* auto">

                    <Border Grid.Row="0"
                            CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="No images"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasImages}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Loading…"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding IsLoadingFullImage, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <Image Source="{Binding FullImage}" Stretch="Uniform" Margin="12" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             Margin="0 12 0 0"
                             MaxHeight="96"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Images}"
                             SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasImageStrip, Converter={StaticResource BoolToVisibilityConverter}}">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModImageViewModel}">
                                <Border b:LazyLoad.Source="{Binding}"
                                        Width="64" Height="64"
                                        CornerRadius="4"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        ToolTip="{Binding Name}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <ScrollViewer Grid.Column="1"
                              Margin="24 0 0 0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding Description}"
                               TextWrapping="Wrap"
                               Margin="0 0 12 0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Margin="0 24 0 0"
                    CornerRadius="0 0 8 8"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">

                <Button x:Name="CloseButton"
                        Margin="24"
                        Width="160"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="Close"
                        Command="{Binding CloseCommand}" />
            </Border>
        </Grid>
    </Border>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}" />
        <KeyBinding Key="Return" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

</UserControl>
