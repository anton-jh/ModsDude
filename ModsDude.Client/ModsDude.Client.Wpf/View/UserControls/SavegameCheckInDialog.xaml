<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.SavegameCheckInDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="520"
             d:DataContext="{d:DesignInstance Type=vm:SavegameCheckInModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 16">

                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Text="What this version was, for the history (optional)"
                           Margin="0 16 0 4"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" />

                <!-- The mid-session backup. Without it, saving progress for the others to see is an
                     upload followed immediately by downloading what was just sent. -->
                <CheckBox Margin="0 16 0 0"
                          Content="Keep playing - keep the save and the claim"
                          IsChecked="{Binding KeepPlaying, Mode=TwoWay}" />

                <TextBlock Text="{Binding Consequence}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid Margin="24 16 24 20" ColumnDefinitions="* auto">
                    <Button Grid.Column="0"
                            Margin="0 0 8 0"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="{Binding ConfirmLabel}"
                            IsDefault="True"
                            Command="{Binding ConfirmCommand}" />

                    <Button Grid.Column="1"
                            Content="Not yet"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

</UserControl>
