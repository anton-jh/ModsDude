<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.ModVersionOrderEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModVersionOrderViewModel, IsDesignTimeCreatable=False}">

    <!-- One mod's versions, oldest first. Shared by the arbitration dialog and the manual reorder,
         because they are the same operation reached from two directions. -->
    <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ModVersionOrderEntryViewModel}">

                <Border Margin="0 2"
                        Padding="8 4"
                        CornerRadius="4"
                        BorderThickness="1">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <!-- The versions nothing could place - which is what the dialog is
                                     actually asking about, so they are the ones drawn to be found. -->
                                <DataTrigger Binding="{Binding IsUnplaceable}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid ColumnDefinitions="28 * auto auto auto">

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Position}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Style="{DynamicResource CaptionTextBlockStyle}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Version}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <TextBlock Grid.Column="2"
                                   Margin="8 0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Note}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Buttons rather than dragging: a swap with the neighbour is what keeps the
                             already-registered versions in the order the repo put them, since only a
                             movable entry ever initiates one. -->
                        <Button Grid.Column="3"
                                Style="{DynamicResource SubtleIconButton}"
                                Width="28" Height="26"
                                Content="&#xE70E;"
                                ToolTip="Move earlier"
                                IsEnabled="{Binding CanMoveUp}"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />

                        <Button Grid.Column="4"
                                Style="{DynamicResource SubtleIconButton}"
                                Width="28" Height="26"
                                Content="&#xE70D;"
                                ToolTip="Move later"
                                IsEnabled="{Binding CanMoveDown}"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
