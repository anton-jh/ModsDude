<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.SavegameSlotPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="520"
             d:DataContext="{d:DesignInstance Type=vm:SavegameSlotPickerModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 16">

                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ListBox Margin="0 16 0 0"
                         MaxHeight="260"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding Slots}"
                         SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- Headed by folder only where the game reaches more than one of them: the view
                         carries no grouping at all otherwise, so a game with one savegame folder
                         shows a plain list. -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0 8 0 2"
                                               Text="{Binding Name}"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SavegameSlotOptionViewModel}">
                            <StackPanel Margin="0 4" ToolTip="{Binding ToolTip}">
                                <TextBlock Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                <TextBlock Margin="0 2 0 0"
                                           TextWrapping="Wrap"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid Margin="24 16 24 20" ColumnDefinitions="* auto">
                    <Button Grid.Column="0"
                            Margin="0 0 8 0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="Publish this one"
                            HorizontalAlignment="Stretch"
                            IsDefault="True"
                            Command="{Binding ConfirmCommand}" />

                    <Button Grid.Column="1"
                            Content="Never mind"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

</UserControl>
