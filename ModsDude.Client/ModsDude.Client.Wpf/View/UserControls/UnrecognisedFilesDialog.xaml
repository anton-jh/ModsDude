<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.UnrecognisedFilesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="540"
             d:DataContext="{d:DesignInstance Type=vm:UnrecognisedFilesModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="* auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 20">

                <Grid ColumnDefinitions="auto *">
                    <TextBlock Grid.Column="0"
                               Text="&#xE7BA;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Margin="0 0 12 0"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Style="{StaticResource TitleTextBlockStyle}" />
                </Grid>

                <TextBlock Text="{Binding Summary}"
                           Margin="0 16 0 8"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <!-- The first ten names; the view model says how many more there are, so a long list
                     cannot push the choice below off the dialog. -->
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="12 8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Names}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding MoreText}"
                                   Margin="0 4 0 0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Nothing is deleted. Where should they go?"
                           Margin="0 16 0 8"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <RadioButton GroupName="Destination"
                             Content="The Recycle Bin, where you can restore them"
                             IsChecked="{Binding Destination, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=RecycleBin}" />

                <RadioButton GroupName="Destination"
                             Content="A folder I choose"
                             IsChecked="{Binding Destination, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Folder}" />

                <!-- Always there, so what the dialog can do is visible; picking a folder turns its own
                     radio on, which is what stops a chosen folder being ignored. -->
                <Grid Margin="28 4 0 0" ColumnDefinitions="* auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Margin="8 0 0 0"
                            Content="Browse..."
                            Command="{Binding BrowseCommand}" />
                </Grid>

                <TextBlock Margin="28 4 0 0"
                           Text="{Binding FolderProblem}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding HasFolderProblem, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid Margin="24 16 24 20" ColumnDefinitions="* *">
                    <Button Grid.Column="0"
                            Margin="0 0 4 0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="Apply the profile"
                            HorizontalAlignment="Stretch"
                            IsDefault="True"
                            Command="{Binding ConfirmCommand}" />

                    <Button Grid.Column="1"
                            Margin="4 0 0 0"
                            Content="Cancel"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

</UserControl>
