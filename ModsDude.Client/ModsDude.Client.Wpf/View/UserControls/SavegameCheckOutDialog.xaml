<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.SavegameCheckOutDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="560"
             d:DataContext="{d:DesignInstance Type=vm:SavegameCheckOutModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 16">

                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Intro}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Mods. One line where the folder is already right, which is the common case and
                     the one that must not read like a form. -->
                <StackPanel Margin="0 20 0 0"
                            Visibility="{Binding ShowModsSection, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="Mods"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <TextBlock Margin="0 4 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding Mods.Text}" />

                    <!-- Named rather than counted. This is the moment a map at the wrong version stops
                         being untidy and starts being a damaged save. -->
                    <TextBlock Margin="0 4 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="{Binding Mods.LockedText}"
                               Visibility="{Binding Mods.HasLocked, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Margin="0 4 0 0"
                               TextWrapping="Wrap"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding Mods.Consequence}"
                               Visibility="{Binding Mods.HasConsequence, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- Instance. Absent where the repo offers one - there is nothing to ask. -->
                <StackPanel Margin="0 20 0 0"
                            Visibility="{Binding ShowInstanceSection, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="Where"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <ComboBox Margin="0 4 0 0"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Instances}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedInstance, Mode=TwoWay}" />
                </StackPanel>

                <!-- Slot. Shown on every check-out: the remembered one pre-selects it, it never
                     decides it. -->
                <StackPanel Margin="0 20 0 0">

                    <TextBlock Text="Slot"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <TextBlock Margin="0 4 0 0"
                               TextWrapping="Wrap"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding SlotNote}"
                               Visibility="{Binding HasSlotNote, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- The pre-selected row and a way to change it. -->
                    <Grid Margin="0 8 0 0"
                          ColumnDefinitions="* auto"
                          Visibility="{Binding ShowPreselection, Converter={StaticResource BoolToVisibilityConverter}}">

                        <StackPanel Grid.Column="0" DataContext="{Binding SelectedSlot}">
                            <TextBlock Text="{Binding Label}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}" />

                            <TextBlock Margin="0 2 0 0"
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Detail}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                VerticalAlignment="Top"
                                Style="{DynamicResource SubtleMenuButton}"
                                Content="Change"
                                Command="{Binding ChangeSlotCommand}" />
                    </Grid>

                    <ListBox Margin="0 8 0 0"
                             MaxHeight="220"
                             HorizontalContentAlignment="Stretch"
                             ItemsSource="{Binding Slots}"
                             SelectedItem="{Binding SelectedSlot, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding ShowAllSlots, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SavegameSlotOptionViewModel}">
                                <StackPanel Margin="0 4" ToolTip="{Binding ToolTip}">
                                    <TextBlock Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                    <TextBlock Margin="0 2 0 0"
                                               TextWrapping="Wrap"
                                               Text="{Binding Detail}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <!-- A refused row says so in its own colour rather
                                                         than looking like every other option and then
                                                         refusing the button. -->
                                                    <DataTrigger Binding="{Binding IsRefused}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0 8 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="{Binding SlotWarning}"
                               Visibility="{Binding HasSlotWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!-- Revision. Absent where the save's own revision is the profile's current one. -->
                <StackPanel Margin="0 20 0 0"
                            Visibility="{Binding ShowRevisionSection, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="Revision"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <TextBlock Margin="0 4 0 0"
                               TextWrapping="Wrap"
                               Text="{Binding Revision.Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Revision.IsCaution}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid Margin="24 16 24 20" RowDefinitions="auto auto">

                    <!-- The one action a refused slot offers. Not a warning: checking that savegame in
                         is what makes this possible, and it is a thing to do rather than to read. -->
                    <Button Grid.Row="0"
                            Margin="0 0 0 8"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="{Binding BlockedActionLabel}"
                            Command="{Binding CheckInBlockingSavegameCommand}"
                            Visibility="{Binding IsSlotRefused, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Grid Grid.Row="1" ColumnDefinitions="* auto">
                        <Button Grid.Column="0"
                                Margin="0 0 8 0"
                                HorizontalAlignment="Stretch"
                                Style="{DynamicResource AccentButtonStyle}"
                                Content="{Binding ConfirmLabel}"
                                IsDefault="True"
                                Command="{Binding ConfirmCommand}" />

                        <Button Grid.Column="1"
                                Content="Never mind"
                                Command="{Binding CancelCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

</UserControl>
