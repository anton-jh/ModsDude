<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- The links on a toast: the accent rather than the text colour, because here they are the
             one thing on the card that can be pressed. -->
        <Style x:Key="ToastLink" TargetType="Hyperlink" BasedOn="{StaticResource TextLink}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <!-- A column pinned to the bottom edge, newest at the bottom. Nothing behind the cards takes
         clicks: this has no background, so the page underneath stays usable around them. -->
    <ItemsControl ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="16 0 16 20"
                  Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                <Border MinWidth="260" MaxWidth="560"
                        Margin="0 4 0 0"
                        Padding="16 10 10 10"
                        CornerRadius="6"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        MouseEnter="OnToastMouseEnter"
                        MouseLeave="OnToastMouseLeave">
                    <Border.Effect>
                        <DropShadowEffect Color="#66000000" BlurRadius="12" ShadowDepth="2" />
                    </Border.Effect>

                    <!-- The left edge says how much it matters, as on the notice cards. Both values
                         are set by the style and neither on the element: a local value would outrank
                         the trigger. -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter Property="BorderThickness" Value="4 1 1 1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid ColumnDefinitions="* auto auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Message}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding Actions}"
                                      Margin="16 0 0 0"
                                      VerticalAlignment="Center"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ToastActionViewModel}">
                                    <TextBlock Margin="0 0 12 0">
                                        <Hyperlink Style="{StaticResource ToastLink}"
                                                   Command="{Binding InvokeCommand}">
                                            <Run Text="{Binding Label, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Column="2"
                                Margin="8 0 0 0"
                                Padding="6"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="Dismiss"
                                Command="{Binding DismissCommand}">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
