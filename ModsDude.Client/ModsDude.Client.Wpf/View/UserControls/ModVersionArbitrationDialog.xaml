<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.ModVersionArbitrationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="640" MaxHeight="700"
             d:DataContext="{d:DesignInstance Type=vm:ModVersionArbitrationModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto * auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 12">
                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 12 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="24 0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Mods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModVersionArbitrationItemViewModel}">
                            <StackPanel Margin="0 0 0 20">
                                <TextBlock Text="{Binding Name}"
                                           Margin="0 0 0 6"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                <local:ModVersionOrderEditor DataContext="{Binding Order}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Margin="0 16 0 0"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">

                <Grid RowDefinitions="auto auto" Margin="24 16 24 20">

                    <!-- Said here rather than left for the button to imply: skipping costs the mods
                         in this dialog and nothing else, and someone importing two thousand of them
                         should not have to guess that. -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding SkipMessage}"
                               TextWrapping="Wrap"
                               Margin="0 0 0 12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Grid Grid.Row="1" ColumnDefinitions="* *">
                        <Button Grid.Column="0"
                                Margin="0 0 4 0"
                                Style="{DynamicResource AccentButtonStyle}"
                                Content="Use this order"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ConfirmCommand}" />

                        <Button Grid.Column="1"
                                Margin="4 0 0 0"
                                Content="Skip these mods"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SkipCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Esc" Command="{Binding SkipCommand}" />
    </UserControl.InputBindings>

</UserControl>
