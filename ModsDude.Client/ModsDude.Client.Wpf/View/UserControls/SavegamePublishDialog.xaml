<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.SavegamePublishDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="520"
             d:DataContext="{d:DesignInstance Type=vm:SavegamePublishModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 16">

                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Text="What everybody else will see it called"
                           Margin="0 16 0 4"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" />

                <!-- Every profile in the repo, and no mod list as an explicit choice. It is asked
                     rather than derived because nothing moves a savegame between profiles afterwards,
                     and because the game's active one is only the likeliest answer. -->
                <TextBlock Text="Which mod list this savegame follows"
                           Margin="0 16 0 4"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Profiles}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />

                <!-- The number this declares. Shown rather than implied: the bytes predate ModsDude,
                     so nothing observed which mods were in the folder while this savegame was played. -->
                <TextBlock Text="{Binding RevisionText}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasRevisionText, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Superseding, inline rather than as a second dialog: a confirmation that appears
                     after the button is one that gets clicked through. -->
                <TextBlock Text="{Binding SupersedeNotice}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Visibility="{Binding HasSupersedeNotice, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="{Binding MismatchNotice}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding HasMismatchNotice, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="What this first version was, for the history (optional)"
                           Margin="0 16 0 4"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid Margin="24 16 24 20" ColumnDefinitions="* *">
                    <Button Grid.Column="0"
                            Margin="0 0 4 0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="Publish it"
                            HorizontalAlignment="Stretch"
                            IsDefault="True"
                            Command="{Binding ConfirmCommand}" />

                    <Button Grid.Column="1"
                            Margin="4 0 0 0"
                            Content="Never mind"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

</UserControl>
