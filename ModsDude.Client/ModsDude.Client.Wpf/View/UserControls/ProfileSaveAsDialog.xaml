<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.ProfileSaveAsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             Width="480"
             d:DataContext="{d:DesignInstance Type=vm:ProfileSaveAsModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 16">
                <TextBlock Text="Name the new profile"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBox Margin="0 16 0 0"
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <Grid Margin="24 16 24 20" ColumnDefinitions="* *">
                    <Button Grid.Column="0"
                            Margin="0 0 4 0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="Create it"
                            HorizontalAlignment="Stretch"
                            IsDefault="True"
                            Command="{Binding ConfirmCommand}" />

                    <Button Grid.Column="1"
                            Margin="4 0 0 0"
                            Content="Never mind"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

    <UserControl.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

</UserControl>
