<UserControl x:Class="ModsDude.Client.Wpf.View.UserControls.SidebarMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="240">

    <!-- A "⋯" over a sidebar list, for everything that list leads to that is not one of its rows, and for
         refreshing it. No heading: the list's own group headings say what it holds.

         The button sits in the column the rows' pictures do - centred on the rail, at the same x open as
         collapsed - so it does not jump when the sidebar opens, and a peek opens with it under the pointer.
         The code-behind sizes the column from the shell's rail width, the way SidebarHeader places its
         heading. -->
    <Grid Margin="0 20 0 4" MinHeight="30">

        <Border x:Name="Column"
                Width="60"
                HorizontalAlignment="Left">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Drawn the way a selected row is while one of the menu's pages is open, so the sidebar
                     still says where you are. -->
                <Border CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ToggleButton x:Name="MenuButton"
                                  Width="36" Height="30"
                                  FontSize="20"
                                  Content="&#xE712;"
                                  ToolTip="{Binding MenuToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  ToolTipService.InitialShowDelay="200">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource SubtleIconToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingChanges, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </Border>

                <!-- Changes waiting on the server. The refresh that brings them in is the menu's first entry.
                     Off the centre by the glyph's own size rather than in the button's corner, so it sits on
                     the dots' shoulder instead of floating above them. -->
                <Ellipse Width="6" Height="6"
                         Margin="28 0 0 14"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                         IsHitTestVisible="False"
                         Visibility="{Binding HasPendingChanges, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Popup IsOpen="{Binding IsChecked, ElementName=MenuButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=MenuButton}"
               Placement="Bottom"
               VerticalOffset="4"
               StaysOpen="False"
               AllowsTransparency="True">

            <!-- Its data context is this control, set in the code-behind: a popup is a window of its own, and
                 a binding looking for this control from in here has no tree to climb. -->
            <Border x:Name="MenuPanel"
                    Width="260"
                    CornerRadius="{DynamicResource OverlayCornerRadius}"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="4"
                    ButtonBase.Click="OnEntryClick">
                <StackPanel Orientation="Vertical">

                    <!-- Refresh, and what it would bring in where the server has said. -->
                    <Button x:Name="RefreshEntry" Style="{DynamicResource SubtleMenuButton}">
                        <Grid ColumnDefinitions="auto *" RowDefinitions="auto auto">
                            <TextBlock Grid.Column="0" Grid.Row="0"
                                       Text="&#xE72C;"
                                       Width="16"
                                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Margin="10 0 0 0">
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6"
                                         Margin="6 0 0 0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                         Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Margin="10 2 0 0"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding PendingChangesText}"
                                       Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>

                    <Border Height="1"
                            Margin="4"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MenuItemViewModel}">
                                <!-- The entry's own availability and reason, as a sidebar row would draw them. -->
                                <Button Style="{DynamicResource SubtleMenuButton}"
                                        IsEnabled="{Binding IsAvailable}"
                                        ToolTip="{Binding UnavailableReason}"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTipService.InitialShowDelay="200">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}"
                                                   Width="16"
                                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="10 0 0 0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
