<Page x:Class="ModsDude.Client.Wpf.View.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:ProfilePageViewModel, IsDesignTimeCreatable=False}"
      Title="ProfilePage">

    <!-- The profile's name and the button that applies it are in the repo's header, above this: the
         header spans the whole repo, so it is the same one from every page of every profile. What is
         left here is the profile's own menu and the page it opens. -->
    <Grid ColumnDefinitions="200 *">

        <!-- The same surface and edge as the repo's sidebar beside it, which is a SidebarShell; this one does
             not collapse, so it is drawn here rather than by one. -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarSurfaceBrush}" />
        <Border Grid.Column="0"
                Width="1"
                HorizontalAlignment="Right"
                IsHitTestVisible="False"
                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <ListView Grid.Column="0"
                  VerticalAlignment="Top"
                  Style="{StaticResource SidebarList}"
                  ItemsSource="{Binding Path=MenuItems}"
                  SelectedItem="{Binding Path=NavManager.Selected, Mode=TwoWay}" />

        <Frame Grid.Column="1"
               Content="{Binding NavManager.CurrentPage}" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
