<Page x:Class="ModsDude.Client.Wpf.View.Pages.ConnectGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ModsDude.Client.Wpf.View.Pages"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance pvm:ConnectGamePageViewModel, IsDesignTimeCreatable=False}"
      Title="ConnectGamePage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <uc:PageTitle Text="Connect game" />

                <!-- Said rather than asked. The game is called what the adapter calls it, and one is
                     configured once per machine, so there is nothing a typed name could
                     distinguish. -->
                <TextBlock Margin="0 0 0 16"
                           TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="Points ModsDude at your installation of" />
                    <Run Text="{Binding GameName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="on this machine. It is configured once and offered under every repo about that game." />
                </TextBlock>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="Game adapter settings" Padding="0 16 0 16">
                        <uc:DynamicFormEditor DataContext="{Binding LocalSettingsEditor}" />
                    </GroupBox>
                </Border>

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource PageActions}">
            <Button Grid.Column="0" Width="250" Style="{DynamicResource AccentButtonStyle}"
                    Content="Save changes" Command="{Binding Path=SaveChangesCommand}" />
        </StackPanel>

    </Grid>
</Page>