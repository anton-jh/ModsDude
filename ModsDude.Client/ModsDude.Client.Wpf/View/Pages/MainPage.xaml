<Page x:Class="ModsDude.Client.Wpf.View.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=pvm:MainPageViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      FontSize="14">

    <Grid ColumnDefinitions="200 *">

        <Grid Grid.Column="0" RowDefinitions="auto auto * auto">

            <ListView Grid.Row="0"
                      Style="{StaticResource SidebarList}"
                      ItemsSource="{Binding Path=MenuItems}"
                      SelectedItem="{Binding Path=NavManager.Selected, Mode=TwoWay}"
                      />

            <uc:SidebarHeader Grid.Row="1" Title="My repos" Command="{Binding LoadReposCommand}" ActionIcon="&#xE72C;" />

            <ListView Grid.Row="2"
                      Style="{StaticResource SidebarList}"
                      ItemsSource="{Binding Path=Repos}"
                      SelectedItem="{Binding Path=NavManager.Selected, Mode=TwoWay}"
                      />

            <!-- The only account control there is. Signing out has no state worth reaching, so the
                 panel says who you are and offers to be somebody else instead. -->
            <Border Grid.Row="3"
                    DataContext="{Binding Account}"
                    Margin="8 12 8 8"
                    Padding="12"
                    CornerRadius="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel Orientation="Vertical">

                    <TextBlock Text="Signed in as"
                               FontSize="12"
                               Opacity="0.7"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0 4 0 0">

                        <!-- The same colour their teammates see beside their name. Held back until
                             the server has answered, rather than drawn in a colour about to change. -->
                        <Border Width="24" Height="24" CornerRadius="12"
                                VerticalAlignment="Center"
                                Background="{Binding AvatarColor}"
                                Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Initial}"
                                       Foreground="White" FontWeight="SemiBold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="{Binding DisplayName}"
                                   Margin="8 0 0 0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="200"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>

                    <Button Content="Switch user"
                            Margin="0 12 0 0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding SwitchUserCommand}" />

                </StackPanel>
            </Border>
        </Grid>

        <Frame Grid.Column="1"
               Content="{Binding NavManager.CurrentPage}" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
