<Page x:Class="ModsDude.Client.Wpf.View.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      xmlns:b="clr-namespace:ModsDude.Client.Wpf.View.Behaviors"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=pvm:MainPageViewModel, IsDesignTimeCreatable=False}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      FontSize="14">

    <!-- The sidebar is a rail while a repo is open - the repo's own sidebar is the one in use then - and
         a hover shows it in full over the top of the page. See SidebarShell. -->
    <uc:SidebarShell Style="{StaticResource SidebarShellStyle}"
                     IsCollapsed="{Binding IsSidebarCollapsed}">

        <uc:SidebarShell.SidebarTemplate>
            <DataTemplate>
                <!-- The repos and nothing above them: every other place the shell leads to is behind the
                     "⋯", or the account card's gear. No "Repos" heading - the sidebar holds nothing else,
                     and the games the list is grouped by are the headings. -->
                <Grid x:Name="SidebarRoot" RowDefinitions="auto * auto">

                    <uc:SidebarMenu Grid.Row="0"
                                    Items="{Binding HeaderMenuItems}"
                                    Command="{Binding OpenCommand}"
                                    IsSelected="{Binding IsHeaderMenuSelected}"
                                    MenuToolTip="{Binding MenuToolTip}"
                                    RefreshCommand="{Binding LoadReposCommand}"
                                    HasPendingChanges="{Binding HasPendingRepoChanges}"
                                    PendingChangesText="{Binding PendingRepoChangesText}" />

                    <!-- Grouped by game rather than one flat column: a local installation belongs to a game, so two
                         repos for different games have nothing in common that the sidebar was saying they
                         did. ReposView is the same entries with one heading per game - see
                         MainPageViewModel.ReposView for why it groups and deliberately does not sort. -->
                    <ListView Grid.Row="1"
                              Style="{StaticResource SidebarList}"
                              ItemsSource="{Binding Path=ReposView}"
                              SelectedItem="{Binding Path=NavManager.Selected, Mode=TwoWay}"
                              >
                        <ListView.GroupStyle>
                            <StaticResource ResourceKey="SidebarGroupStyle" />
                        </ListView.GroupStyle>
                    </ListView>

                    <!-- Who you are, and the way to the account page - name, picture, password and switching
                         user - and to this machine's settings. There is no signing out: it has no state worth
                         reaching. In a rail it is the avatar alone, with who it is in a tooltip; the rest is a
                         hover away. -->
                    <Border Grid.Row="2"
                            DataContext="{Binding Account}"
                            CornerRadius="4"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="200">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Margin" Value="8 12 8 8" />
                                <Setter Property="Padding" Value="12" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Margin" Value="4 12 4 8" />
                                        <Setter Property="Padding" Value="4 8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Vertical">

                            <TextBlock Text="Signed in as"
                                       FontSize="12"
                                       Opacity="0.7"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid ColumnDefinitions="auto * auto" Margin="0 4 0 0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- What their teammates see beside their name. Held back until the server
                                     has answered, rather than drawn in a colour about to change. -->
                                <Grid Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <uc:UserAvatar Width="24" Height="24" FontSize="12"
                                                   DataContext="{Binding Avatar}" />
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Margin="8 0 0 0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- This machine's settings. On the card because they are the user's own
                                     rather than a place in the app, like the account page below. Drawn
                                     selected while open, as the header's buttons are. The command is the
                                     shell's, which owns navigation; the card's own context is the account. -->
                                <Border Grid.Column="2"
                                        Margin="8 0 0 0"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsSettingsSelected, ElementName=SidebarRoot}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Width="28" Height="28"
                                            FontSize="14"
                                            Content="&#xE713;"
                                            ToolTip="Settings"
                                            ToolTipService.InitialShowDelay="200"
                                            Command="{Binding DataContext.OpenSettingsCommand, ElementName=SidebarRoot}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SubtleIconButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSettingsSelected, ElementName=SidebarRoot}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Border>
                            </Grid>

                            <Button Content="Account"
                                    Margin="0 12 0 0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding OpenCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=(b:Sidebar.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </uc:SidebarShell.SidebarTemplate>

        <Frame Content="{Binding NavManager.CurrentPage}" NavigationUIVisibility="Hidden" />
    </uc:SidebarShell>
</Page>
