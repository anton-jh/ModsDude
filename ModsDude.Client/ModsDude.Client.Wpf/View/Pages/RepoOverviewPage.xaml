<Page x:Class="ModsDude.Client.Wpf.View.Pages.RepoOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:RepoOverviewPageViewModel, IsDesignTimeCreatable=False}"
      Title="RepoOverviewPage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <TextBlock Style="{DynamicResource TitleTextBlockStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding RepoName}" />
                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                           Text="Overview"
                           Margin="0 8 0 36" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="This repo" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Game}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0 4 0 0"
                                       Text="{Binding MembershipSummary}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasMemberSummary, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="{Binding MemberSummary}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ProfileSummary}" />
                        </StackPanel>
                    </GroupBox>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Game instances" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Visibility="{Binding HasNoInstances, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="No game on this machine is connected to this repo yet. Use 'Connect game' to point one at its mod folder." />

                            <ItemsControl ItemsSource="{Binding Instances}"
                                          Visibility="{Binding HasInstances, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InstanceOverviewViewModel}">
                                        <StackPanel Orientation="Vertical" Margin="0 0 0 16">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ModFolder}"
                                                       Text="{Binding ModFolder}" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding ActiveProfileSummary}" />
                                            <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding DriftSummary}"
                                                       Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </GroupBox>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Sync" Padding="0 16 0 16">
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="Nothing syncs yet. When it does, each instance's drift from its profile and the time it last synced will be shown here." />
                    </GroupBox>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
