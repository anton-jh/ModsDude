<Page x:Class="ModsDude.Client.Wpf.View.Pages.ProfileModsEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ModsDude.Client.Wpf.View.Pages"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      xmlns:b="clr-namespace:ModsDude.Client.Wpf.View.Behaviors"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfileModsEditorPage"
      PreviewKeyDown="PageKeyDown"
      d:DataContext="{d:DesignInstance Type=pvm:ProfileModsEditorPageViewModel, IsDesignTimeCreatable=False}">

    <Page.Resources>

        <!-- One entry of a row's version selector: the version, starred where saving imports it, with
             the words behind the star. Null where there is nothing to say, which shows no tooltip at
             all and leaves the selector's own. -->
        <DataTemplate x:Key="VersionOptionTemplate" DataType="{x:Type vm:ProfileModVersionOption}">
            <TextBlock Text="{Binding Label}" ToolTip="{Binding Note}" />
        </DataTemplate>

        <!-- The save button and its variant caret are one control, so the accent chrome lives here
             once and is split down the seam: only the outer corners round, and the halves meet on a
             hairline instead of the gap that made them read as two buttons. -->
        <Style x:Key="SaveSplitPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="16 7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="4 0 0 4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Drawn over the content rather than as the border's own stroke, so
                                     taking focus does not nudge the label sideways. -->
                                <Border x:Name="FocusRing"
                                        Margin="-14 -5"
                                        CornerRadius="4 0 0 4"
                                        BorderThickness="0"
                                        BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                            </Trigger>
                            <!-- With nothing to apply to there is no caret beside it, so it rounds
                                 on both sides again. -->
                            <DataTrigger Binding="{Binding WillApply}" Value="False">
                                <Setter TargetName="Background" Property="CornerRadius" Value="4" />
                                <Setter TargetName="FocusRing" Property="CornerRadius" Value="4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The other half. A drawn chevron rather than a glyph: an icon font that is missing is not
             an error, it just renders as a stray mark in the middle of the button. -->
        <Style x:Key="SaveSplitCaret" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Background"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="0 4 4 0">
                            <Grid>
                                <Rectangle Width="1" Margin="0 7"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                           Opacity="0.3" />
                                <Path x:Name="Chevron"
                                      Data="M 0 0 L 4.5 4.5 L 9 0"
                                      Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="FocusRing"
                                        CornerRadius="0 4 4 0"
                                        BorderThickness="0"
                                        BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <!-- Held down for as long as the menu it opened is up. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The container for a row in either list. It draws two different things that a plain list
             would draw as one: what is *picked*, which is a property of the row and survives the
             search, and which row is *current*, which is the framework's and is only a focus ring.
             Explorer draws the same distinction, and for the same reason - the arrow keys have to be
             able to move without that meaning the set has changed. -->
        <Style x:Key="ModRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <!-- The accent at low opacity rather than a named fill: it reads as a
                                 selection in both themes, and it is the one colour on the row that
                                 cannot be confused with the hover state under it. -->
                            <Border x:Name="Fill"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Opacity="0" />

                            <Rectangle x:Name="Bar"
                                       Width="3"
                                       Margin="0 6"
                                       RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}" />

                            <ContentPresenter />

                            <Border x:Name="Focus"
                                    BorderThickness="0"
                                    BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.16" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Both lists, which have to behave identically: taking mods out of a profile is the same
             job as putting them in, seen from the other side.
             SelectionMode stays Single on purpose. The list's own selection is only ever the current
             item - what is picked lives on the rows, because a list control drops from its selection
             whatever the collection view filters out, and that would mean one more character in the
             search box quietly discarding the set being assembled. See ListSelection. -->
        <Style x:Key="ModList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModRow}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <!-- The review of the draft. Rows there are read, and reverted one at a time, rather than
             picked - so nothing about a row is selectable or focusable, and the container is only a
             place for the shared row to sit. -->
        <Style x:Key="ReviewRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReviewList" TargetType="ListBox" BasedOn="{StaticResource ModList}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ReviewRow}" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizingWhenGrouping" Value="True" />
        </Style>

        <!-- The box a list sits in, which is also the target a drag from the other list lands on.
             Nothing here is ordered, so a drop has no position to mean and the whole box lights up
             rather than a line between two rows. -->
        <Style x:Key="ListFrame" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        </Style>

        <!-- The strip under a list while something is picked. Absent at zero, so the lists keep
             their height until there is something to say. -->
        <Style x:Key="SelectionBar" TargetType="Border">
            <Setter Property="Margin" Value="0 8 0 0" />
            <Setter Property="Padding" Value="10 8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

    </Page.Resources>

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <Grid RowDefinitions="auto auto *">

                <uc:PageTitle Grid.Row="0" Text="Mods" />

                <!-- One search box over both lists. A mod is only ever on one side, so a box that
                     reached only the left one answered half the question - and the half it could
                     not answer was "is this already in the profile?". Same shape as the repo mods
                     page, which has the same two lists and the same question. -->
                <StackPanel Grid.Row="1" Margin="0 0 0 12"
                            Visibility="{Binding IsReviewing, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                <Grid>

                    <!-- No clear button of its own. The Fluent theme's TextBox template draws one,
                         and a second hand-rolled one sat exactly on top of it - two buttons, the
                         upper one hiding the lower. Theirs empties the box, which is the whole of
                         what ours did, so it is the one that stays. Escape still empties it too;
                         see SearchBoxKeyDown. -->
                    <TextBox x:Name="SearchBox"
                             PreviewKeyDown="SearchBoxKeyDown"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             VerticalAlignment="Center" />

                    <!-- Watches the box rather than the view model: the binding above delays pushing
                         the text through, so anything driven off SearchText stays a beat behind what
                         has actually been typed. -->
                    <TextBlock Text="Search by name, id or author"
                               Margin="12 0 0 0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>

                </StackPanel>

                <!-- What the draft would change, in the lists' place while it is being reviewed or
                     while a save that imports is running. Independent of the sources, the filters
                     and the search: it is read from the draft, so it is every change and only those. -->
                <Grid Grid.Row="2" RowDefinitions="auto *"
                      Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel Grid.Row="0" Margin="0 0 0 8">
                        <TextBlock Text="Changes since the saved profile"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Style="{DynamicResource BodyStrongTextBlockStyle}" />

                        <TextBlock Margin="0 2 0 0"
                                   Text="{Binding ChangeSummary}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Margin="0 2 0 0"
                                   Text="{Binding PendingText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource ListFrame}">
                        <ListBox Style="{StaticResource ReviewList}"
                                 ItemsSource="{Binding ChangesView}">

                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="16 14 16 6" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Style="{DynamicResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Margin="6 0 0 0"
                                                           Text="{Binding ItemCount}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DraftChangeViewModel}">
                                    <Grid ColumnDefinitions="* auto">

                                        <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                        <!-- The way back. What moved is on the row itself, so its divider
                                             runs the full width. The revert is a write, so it is under
                                             the same IsEnabled as every other control that changes the
                                             draft. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Page}}">

                                            <Button Margin="0 0 8 0"
                                                    Style="{DynamicResource SubtleIconButton}"
                                                    Content="&#xE7A7;"
                                                    ToolTip="Take this change back"
                                                    Command="{Binding DataContext.RevertChangeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="* 16 *"
                      Visibility="{Binding IsReviewing, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                    <!-- The available side: registered mods and local candidates in one list, so a
                         mod can be added and imported without a detour to the management page. -->
                    <Grid Grid.Column="0" RowDefinitions="auto auto auto * auto auto">

                        <Grid Grid.Row="0" Margin="0 0 0 8" ColumnDefinitions="auto * auto auto auto">

                            <!-- Selecting everything the list is showing, which is what the search
                                 and the chips below exist to define. Three-valued because a
                                 part-selected list is the state it spends most of its time in, and
                                 a two-state box would have to round that to a lie. -->
                            <CheckBox Grid.Column="0"
                                      Margin="12 0 10 0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AvailableSelection.AllShownSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      ToolTip="Select everything this list is showing" />

                            <TextBlock Grid.Column="1"
                                       Text="Not in this profile"
                                       VerticalAlignment="Center"
                                       ToolTip="Registered in this repo or found on this computer, and not pinned here."
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}" />

                            <!-- Says why the top of this list is not alphabetical: what the draft has
                                 taken out of the profile is back here, and looks exactly like a mod
                                 that was never in it. The count is also the control that hides them -
                                 clicking it is what flips ShowRemovals, the same shape as the updates
                                 band's skipped-locked count opening its own list. -->
                            <Button Grid.Column="2"
                                    Margin="12 0 0 0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource SubtleMenuButton}"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Content="{Binding RemovalText}"
                                    ToolTip="{Binding RemovalToggleTooltip}"
                                    Visibility="{Binding HasRemovals, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding ToggleRemovalsCommand}" />

                            <!-- Shows or hides what is ignored: mods somebody ignored in this profile,
                                 and other versions of mods it locks. A filter over the list rather
                                 than a source chip - it never adds a row the sources did not offer -
                                 so it sits with the list's count. Crossed out while they are hidden,
                                 open while they are shown, which is the row's own eye read the same
                                 way. -->
                            <ToggleButton Grid.Column="3"
                                          Margin="8 0 0 0"
                                          Width="Auto"
                                          MinWidth="36"
                                          Padding="8 0"
                                          Style="{DynamicResource SubtleIconToggleButton}"
                                          IsChecked="{Binding ShowIgnored, Mode=TwoWay}"
                                          ToolTip="{Binding IgnoredToggleTooltip}"
                                          ToolTipService.ShowDuration="20000">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xED1A;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowIgnored}" Value="True">
                                                        <Setter Property="Text" Value="&#xE890;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="6 0 0 0"
                                               VerticalAlignment="Center"
                                               FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Page}}"
                                               Text="{Binding IgnoredText}"
                                               Visibility="{Binding HasIgnored, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </ToggleButton>

                            <TextBlock Grid.Column="4"
                                       Margin="12 0 0 0"
                                       VerticalAlignment="Center"
                                       Text="{Binding AvailableCountText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- The sources, as a row of chips directly above the filter chips. This
                             used to be a 270px pane under the bulk moves; it is now about 32px, and
                             nothing about it is behind a click - which is what an empty left list
                             needs from the one control that explains it.
                             Every source, the repo included, is a filter over one list, and the
                             chips say so by all looking the same. -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 8">

                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ModSourceViewModel}">
                                        <ToggleButton Style="{StaticResource SourceChip}"
                                                      Margin="0 0 6 6"
                                                      ToolTip="{Binding Tooltip}"
                                                      ToolTipService.ShowDuration="20000"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Page}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           MaxWidth="160"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ChipCountText}"
                                                           Margin="6 0 0 0"
                                                           Opacity="0.7"
                                                           VerticalAlignment="Center" />

                                                <!-- Session-scoped chips carry their own ⨯: a folder
                                                     off a USB stick and a profile being diffed
                                                     against both stop existing when the page does,
                                                     and switching one off is not the same as being
                                                     done with it. -->
                                                <Button Margin="6 0 -2 0"
                                                        Padding="2 0"
                                                        VerticalAlignment="Center"
                                                        Style="{DynamicResource SubtleIconButton}"
                                                        Width="18" Height="18"
                                                        FontSize="10"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                        Content="&#xE711;"
                                                        ToolTip="{Binding RemoveTooltip}"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource SourceActionChip}"
                                    Margin="0 0 6 6"
                                    Content="+ folder"
                                    ToolTip="Scanned for this session only, and never written to disk"
                                    Command="{Binding AddSourceCommand}" />

                            <Button Style="{StaticResource SourceActionChip}"
                                    Margin="0 0 6 6"
                                    Content="+ profile"
                                    ToolTip="Read another profile's list as a source, to see what it holds and this one does not"
                                    Command="{Binding AddProfileSourceCommand}" />

                            <Button Style="{StaticResource SourceActionChip}"
                                    Margin="0 0 6 6"
                                    Content="&#xE72C;"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    ToolTip="Rescan every folder"
                                    Command="{Binding RescanAllCommand}" />
                        </WrapPanel>

                        <!-- Chips rather than a dropdown: they compose with the search into one
                             well-defined set, and every bulk action and count on this side is
                             stated against that set. -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 8">
                            <RadioButton GroupName="AvailableFilter"
                                         Style="{StaticResource FilterChip}"
                                         Content="All"
                                         IsChecked="{Binding AvailableFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
                            <RadioButton GroupName="AvailableFilter"
                                         Style="{StaticResource FilterChip}"
                                         Content="New to the repo"
                                         ToolTip="Found on this computer and not registered here. Saving imports these."
                                         IsChecked="{Binding AvailableFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=New}" />
                            <RadioButton GroupName="AvailableFilter"
                                         Style="{StaticResource FilterChip}"
                                         Content="Taken out"
                                         ToolTip="Mods this draft has removed from the profile"
                                         IsChecked="{Binding AvailableFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TakenOut}" />
                            <RadioButton GroupName="AvailableFilter"
                                         Style="{StaticResource FilterChip}"
                                         Content="Not settled"
                                         ToolTip="The order between this version and what the repo holds is not settled. Importing it will ask which comes first."
                                         IsChecked="{Binding AvailableFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Unordered}" />
                        </StackPanel>

                        <Border Grid.Row="3">

                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ListFrame}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(b:ModListDrag.IsOver), ElementName=AvailableList}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>

                                <!-- Virtualized with recycling: a mod folder can easily hold a few
                                     thousand archives. -->
                                <ListBox x:Name="AvailableList"
                                         Style="{StaticResource ModList}"
                                         ItemsSource="{Binding AvailableView}"
                                         b:ListSelection.Controller="{Binding AvailableSelection}"
                                         b:ModListDrag.Kind="Available"
                                         b:ModListDrag.DropCommand="{Binding RemoveSelectedCommand}">

                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add the selected mods" Command="{Binding AddSelectedCommand}" />
                                            <Separator />
                                            <MenuItem Header="Select everything shown" Command="{Binding SelectAllShownAvailableCommand}" />
                                            <MenuItem Header="Clear the selection" Command="{Binding ClearAvailableSelectionCommand}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>

                                    <!-- The shared row, plus a version selector and the one action
                                         this list adds - structurally identical to the pinned list's
                                         template now that both sides are a selector over one shared
                                         mod row. The inner presenter picks up the implicit template,
                                         so a mod looks the same here as it does everywhere else. -->
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProfileModRowViewModel}">
                                            <Grid ColumnDefinitions="* auto">

                                                <!-- Dimmed where the row is only here because ignored mods
                                                     are being shown. -->
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Page}}">

                                                    <!-- Ignore this mod in this profile, or stop. The glyph is
                                                         what pressing it would do: crossed out to hide, open
                                                         to bring back. It stays here, greyed and saying why,
                                                         for the rows it cannot act on - a pinned mod cannot be
                                                         ignored, and a version of a locked one already is. -->
                                                    <Button Margin="0 0 4 0"
                                                            IsEnabled="{Binding CanToggleIgnore}"
                                                            ToolTip="{Binding IgnoreTooltip}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            ToolTipService.ShowDuration="20000"
                                                            Command="{Binding DataContext.ToggleIgnoreCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SubtleIconButton}">
                                                                <Setter Property="Content" Value="&#xED1A;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IgnoreState}" Value="Ignored">
                                                                        <Setter Property="Content" Value="&#xE890;" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- The list is keyed by mod, so which version the
                                                         + or the ⬆ would add is a choice on the row -
                                                         the same reason the right list carries one. -->
                                                    <ComboBox Width="150"
                                                              Margin="4 0"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{Binding Versions}"
                                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                              ItemTemplate="{StaticResource VersionOptionTemplate}"
                                                              IsEnabled="{Binding HasSeveralVersions}"
                                                              ToolTip="Which version this would add" />

                                                    <!-- One verb applied to the profile, and which one
                                                         depends on what it already has of that mod: +
                                                         where it is absent, and a pin move where it is
                                                         not. Keyed on MovesPin rather than on
                                                         IsUpdateRow, because this row's own selector
                                                         reaches versions that are older than the pin
                                                         and versions the ordering cannot place against
                                                         it - neither is an update, and both still move
                                                         the pin, so a + labelled "Add to this profile"
                                                         over one of those said the wrong thing about
                                                         what pressing it does.
                                                         Two buttons rather than a retemplated one;
                                                         both run the same command, and the page decides
                                                         which of the two moves it turns out to be. -->
                                                    <Button Style="{DynamicResource SubtleIconButton}"
                                                            Margin="0 0 8 0"
                                                            Content="&#xE710;"
                                                            ToolTip="Add to this profile"
                                                            Visibility="{Binding Item.MovesPin, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />

                                                    <!-- The arrow says which way the pin goes: up for an update, and the
                                                         neutral glyph for any other move. The tooltip goes with
                                                         it, so an up arrow never sits over a move that is not
                                                         an update. -->
                                                    <Button Margin="0 0 8 0"
                                                            Visibility="{Binding Item.MovesPin, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SubtleIconButton}">
                                                                <Setter Property="Content" Value="&#xE72C;" />
                                                                <Setter Property="ToolTip" Value="Move this profile's pin to this version" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Item.IsUpdateRow}" Value="True">
                                                                        <Setter Property="Content" Value="&#xE74A;" />
                                                                        <Setter Property="ToolTip" Value="Update this profile's pin to this version" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Reading the repo and scanning the sources…"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <!-- Only while something is picked. What it says it will move is everything
                             selected, including rows the search is hiding - so it says how many
                             those are and offers to put them down, rather than acting on mods
                             nobody can see. -->
                        <Border Grid.Row="4"
                                Style="{StaticResource SelectionBar}"
                                Visibility="{Binding AvailableSelection.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid RowDefinitions="auto auto auto">

                                <Grid Grid.Row="0" ColumnDefinitions="* auto">
                                    <Button Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            Content="{Binding AvailableSelection.ActionText}"
                                            ToolTip="Mods whose pin is locked are left where they are. Unlock one on the right, or move it there, to change it."
                                            ToolTipService.ShowOnDisabled="True"
                                            Command="{Binding AddSelectedCommand}" />
                                    <Button Grid.Column="1"
                                            Margin="8 0 0 0"
                                            Content="Clear"
                                            Command="{Binding ClearAvailableSelectionCommand}" />
                                </Grid>

                                <!-- Ignoring the picked mods, or bringing them back. Each says how many of
                                     the picked rows it will take, and is greyed where it would take none:
                                     pinned mods, and versions of locked ones, are not the selection's to
                                     ignore. -->
                                <Grid Grid.Row="1" Margin="0 8 0 0" ColumnDefinitions="* *">
                                    <Button Grid.Column="0"
                                            Margin="0 0 4 0"
                                            HorizontalAlignment="Stretch"
                                            Content="{Binding IgnoreSelectedText}"
                                            ToolTip="Hide the picked mods from this list. Pinned mods and mods already ignored are left alone."
                                            ToolTipService.ShowOnDisabled="True"
                                            Command="{Binding IgnoreSelectedCommand}" />
                                    <Button Grid.Column="1"
                                            Margin="4 0 0 0"
                                            HorizontalAlignment="Stretch"
                                            Content="{Binding UnignoreSelectedText}"
                                            ToolTip="Stop ignoring the picked mods that somebody ignored. Other versions of locked mods stay ignored while the lock does."
                                            ToolTipService.ShowOnDisabled="True"
                                            Command="{Binding UnignoreSelectedCommand}" />
                                </Grid>

                                <Grid Grid.Row="2"
                                      Margin="0 8 0 0"
                                      ColumnDefinitions="* auto"
                                      Visibility="{Binding AvailableSelection.HasHidden, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding AvailableSelection.HiddenText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="1"
                                            Margin="8 0 0 0"
                                            Content="{Binding AvailableSelection.DeselectHiddenText}"
                                            Command="{Binding DeselectHiddenAvailableCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- The bulk moves, against the list they read rather than in the save bar:
                             what they take is what is on screen above them, and the search and the
                             chips are how a subset of it is picked. -->
                        <Grid Grid.Row="5" Margin="0 8 0 0" RowDefinitions="auto auto" ColumnDefinitions="* *">
                            <Button Grid.Row="0" Grid.Column="0"
                                    Margin="0 0 4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="Add all shown new"
                                    ToolTip="Add every mod the list above is showing that this profile has never held"
                                    Command="{Binding AddAllShownNewCommand}" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Margin="4 0 0 0"
                                    HorizontalAlignment="Stretch"
                                    Content="Restore removed"
                                    ToolTip="Put back everything this draft has taken out, at the version and lock the profile still holds"
                                    Command="{Binding RestoreRemovedCommand}" />

                            <!-- The two ways of not picking mods one at a time at all. Under the
                                 left list because both of them bring things into the profile, and
                                 next to the bulk moves because they answer the same question. -->
                            <Button Grid.Row="1" Grid.Column="0"
                                    Margin="0 8 4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="Copy from a profile…"
                                    ToolTip="Take the mod list from another profile in this repo"
                                    Command="{Binding CopyFromProfileCommand}" />
                            <Button Grid.Row="1" Grid.Column="1"
                                    Margin="4 8 0 0"
                                    HorizontalAlignment="Stretch"
                                    Content="Paste a list…"
                                    ToolTip="Paste mod names or ids and select everything that matches"
                                    Command="{Binding PasteListCommand}" />
                        </Grid>
                    </Grid>

                    <!-- The profile itself. Updates live here rather than on the left, so a mod with
                         a newer version is never on both sides at once. -->
                    <Grid Grid.Column="2" RowDefinitions="auto auto auto * auto auto">

                        <Grid Grid.Row="0" Margin="0 0 0 8" ColumnDefinitions="auto * auto">

                            <CheckBox Grid.Column="0"
                                      Margin="12 0 10 0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding PinnedSelection.AllShownSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      ToolTip="Select everything this list is showing" />

                            <TextBlock Grid.Column="1"
                                       Text="In this profile"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="{Binding PinnedCountText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0 0 0 8" ColumnDefinitions="* auto">
                            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                            <RadioButton GroupName="PinnedFilter"
                                         Style="{StaticResource FilterChip}"
                                         Content="All"
                                         IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
                            <RadioButton GroupName="PinnedFilter"
                                         Style="{StaticResource FilterChip}"
                                         Content="Updates"
                                         ToolTip="Mods with a newer version - in the repo, in a folder being read, or online"
                                         IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Updates}" />
                            <RadioButton GroupName="PinnedFilter"
                                         Style="{StaticResource FilterChip}"
                                         Content="Locked"
                                         ToolTip="Mods held at their version, by you or by the game adapter"
                                         IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Locked}" />

                            <!-- The mirror of the left list's diff view. With another profile as the
                                 only enabled source this is exactly what this profile holds and that
                                 one does not, and "Take out everything shown" is under the list.
                                 Disabled while nothing is enabled, where it would select the whole
                                 profile and mean nothing. -->
                            <RadioButton GroupName="PinnedFilter"
                                         Style="{StaticResource FilterChip}"
                                         Content="Not in the sources"
                                         ToolTip="Mods this profile pins that none of the enabled sources offers any version of"
                                         IsEnabled="{Binding HasEnabledSources}"
                                         IsChecked="{Binding PinnedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=NotInSources}" />
                            </WrapPanel>

                            <!-- How the list is ordered. Not a filter and not a setting, so it sits apart
                                 from the chips and is not remembered: it changes what order the same
                                 mods are in and nothing about which ones. The arrow reverses it, and
                                 each sort opens in the direction somebody reaching for it wants. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12 0 0 0" VerticalAlignment="Top">
                                <TextBlock Text="Sort"
                                           Margin="0 0 8 0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <RadioButton GroupName="PinnedSort"
                                             Style="{StaticResource FilterChip}"
                                             Content="Name"
                                             IsChecked="{Binding PinnedSort, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Name}" />
                                <RadioButton GroupName="PinnedSort"
                                             Style="{StaticResource FilterChip}"
                                             Content="Date added"
                                             ToolTip="When the mod entered the profile, or last moved to another version"
                                             IsChecked="{Binding PinnedSort, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DateAdded}" />
                                <Button Style="{DynamicResource SubtleIconButton}"
                                        ToolTip="{Binding PinnedSortDirectionText}"
                                        Command="{Binding TogglePinnedSortDirectionCommand}">
                                    <Button.Content>
                                        <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE74B;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PinnedSortAscending}" Value="True">
                                                            <Setter Property="Text" Value="&#xE74A;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- The batch action applies to unlocked mods only, and says how many it
                             left alone. The skipped count is a link to the same dialog the per-row
                             change opens, reached deliberately rather than fired at every save. -->
                        <!-- Always on screen, including at zero. "Are there updates?" is a question
                             people come to this page to answer, and a section that is absent when
                             the answer is no never answers it - it just leaves them looking. It also
                             keeps the list below from moving as the count changes. -->
                        <Border Grid.Row="2"
                                Margin="0 0 0 8"
                                Padding="12 8"
                                CornerRadius="4"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Grid ColumnDefinitions="auto * auto">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="{Binding UpdateCountText}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12 0 0 0">
                                    <Button Padding="6 2"
                                            Style="{DynamicResource SubtleMenuButton}"
                                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                            Content="{Binding SkippedText}"
                                            ToolTip="Locked mods are skipped. Open the list to move any of them anyway."
                                            Visibility="{Binding HasSkippedUpdates, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding ShowSkippedUpdatesCommand}" />

                                    <!-- Not counted as updates, and this is the whole job of saying
                                         why - a link to the filter that isolates them, exactly as the
                                         skipped-locked count opens its own list. -->
                                    <Button Padding="6 2"
                                            Margin="8 0 0 0"
                                            Style="{DynamicResource SubtleMenuButton}"
                                            Content="{Binding AmbiguousText}"
                                            ToolTip="Their order relative to what the repo holds is not settled. Importing one will ask which comes first."
                                            Visibility="{Binding HasAmbiguousVersions, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding ShowAmbiguousVersionsCommand}" />

                                    <!-- Newer versions ModHub has, beside the ones here rather than
                                         added into them: Update all cannot take one until its file
                                         has been downloaded. A link to the Updates filter, where each
                                         row carries its own link to the page. -->
                                    <Button Padding="6 2"
                                            Margin="8 0 0 0"
                                            Style="{DynamicResource SubtleMenuButton}"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            Content="{Binding RemoteUpdatesText}"
                                            ToolTip="Newer versions online, each linked from its mod's row. Download one, rescan Downloads, and it can be updated to like any other."
                                            Visibility="{Binding HasRemoteUpdates, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding ShowRemoteUpdatesCommand}" />
                                </StackPanel>

                                <!-- A split button carrying the same split the sentence on the left
                                     does: the primary takes everything that is newer, wherever the
                                     file is, and the caret takes only the half that costs no
                                     upload. -->
                                <StackPanel x:Name="UpdateSplitButton"
                                            Grid.Column="2" Orientation="Horizontal">

                                    <Button x:Name="UpdateAllButton"
                                            Content="{Binding ApplyUpdatesText}"
                                            Command="{Binding ApplyAllUpdatesCommand}" />

                                    <!-- Its own enabled condition rather than the primary's: there
                                         can be a free half of a mixed set and there can equally be
                                         none, which is exactly when the menu is worth opening. -->
                                    <ToggleButton x:Name="UpdateVariantButton"
                                                  Margin="2 0 0 0"
                                                  Padding="8 0"
                                                  ToolTip="Other ways to update"
                                                  Content="&#xE70D;"
                                                  FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                  FontSize="10"
                                                  Visibility="{Binding HasRepoOnlyUpdates, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <Popup IsOpen="{Binding IsChecked, ElementName=UpdateVariantButton, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=UpdateSplitButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True">

                                        <Border CornerRadius="{DynamicResource OverlayCornerRadius}"
                                                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="4">
                                            <Button Width="300"
                                                    Style="{DynamicResource SubtleMenuButton}"
                                                    Command="{Binding ApplyRepoUpdatesCommand}"
                                                    Click="CloseUpdateVariants">
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{Binding UpdateRepoOnlyText}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding UpdateRepoOnlyDescription}"
                                                               Margin="0 2 0 0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3">

                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ListFrame}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=(b:ModListDrag.IsOver), ElementName=PinnedList}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>

                                <ListBox x:Name="PinnedList"
                                         Style="{StaticResource ModList}"
                                         ItemsSource="{Binding PinnedView}"
                                         b:ListSelection.Controller="{Binding PinnedSelection}"
                                         b:ModListDrag.Kind="Pinned"
                                         b:ModListDrag.DropCommand="{Binding AddSelectedCommand}">

                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Take the selected mods out" Command="{Binding RemoveSelectedCommand}" />
                                            <Separator />
                                            <MenuItem Header="Update the selected mods" Command="{Binding UpdateSelectedCommand}" />
                                            <MenuItem Header="Lock the selected mods" Command="{Binding LockSelectedCommand}" />
                                            <MenuItem Header="Unlock the selected mods" Command="{Binding UnlockSelectedCommand}" />
                                            <Separator />
                                            <MenuItem Header="Select everything shown" Command="{Binding SelectAllShownPinnedCommand}" />
                                            <MenuItem Header="Clear the selection" Command="{Binding ClearPinnedSelectionCommand}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ProfileModRowViewModel}">
                                            <Grid ColumnDefinitions="* auto auto">

                                                <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                                <!-- The date the list is sorted by, so the order can be
                                                     read off it. Only under a date sort, and outside
                                                     the enabled group below: it is reading, and a save
                                                     greying it out would hide the very thing the list
                                                     is ordered by. -->
                                                <TextBlock Grid.Column="1"
                                                           Margin="8 0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding SortCaption}"
                                                           ToolTip="{Binding SortTooltip}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding HasSortCaption, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <!-- Everything on this row that can change the draft,
                                                     under one IsEnabled. The list itself stays live -
                                                     IsEnabled on a ListBox stops the mouse wheel
                                                     along with everything else, and reading is not
                                                     writing. -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Page}}">

                                                    <Button Style="{DynamicResource SubtleIconButton}"
                                                            Content="&#xE74A;"
                                                            ToolTip="{Binding UpdateTooltip}"
                                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />

                                                    <!-- The list is keyed by mod, so which version
                                                         it holds is a choice on the row. -->
                                                    <ComboBox Width="150"
                                                              Margin="4 0"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{Binding Versions}"
                                                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                              ItemTemplate="{StaticResource VersionOptionTemplate}"
                                                              IsEnabled="{Binding HasSeveralVersions}"
                                                              ToolTip="Which version this profile pins" />

                                                    <!-- The one lock on this row, and it says what holds the pin
                                                         rather than only what the user set: an open padlock
                                                         while nothing does, a closed one while something
                                                         does, and the accent on it while the game adapter
                                                         is what does - the toggle can only ever set the
                                                         user's own lock, so a padlock in the accent is one
                                                         that unticking will not release. The shared row's
                                                         own padlock is off on this list, because it drew
                                                         the same glyph for the adapter's lock a few pixels
                                                         to the left of this one and the two were read as
                                                         one thing. -->
                                                    <ToggleButton ToolTip="{Binding LockTooltip}"
                                                                  IsChecked="{Binding LockedByProfile, Mode=TwoWay}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource SubtleIconToggleButton}">
                                                                <Setter Property="Content" Value="&#xE785;" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                        <Setter Property="Content" Value="&#xE72E;" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LockedByAdapter}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>

                                                    <Button Margin="0 0 8 0"
                                                            Style="{DynamicResource SubtleIconButton}"
                                                            Content="&#xE738;"
                                                            ToolTip="Take out of this profile"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Two messages, because the box is empty for two different
                                     reasons now that the search reaches this side. -->
                                <TextBlock Text="Nothing in this profile matches the search and the filter."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                                        <Condition Binding="{Binding HasPinnedMods}" Value="True" />
                                                        <Condition Binding="{Binding HasVisiblePinnedMods}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="Nothing in this profile yet.&#x0a;Add mods from the list on the left."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                                        <Condition Binding="{Binding HasPinnedMods}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- The mirror of the bar under the left list, and deliberately so: taking
                             mods out has to cost exactly what putting them in costs. -->
                        <Border Grid.Row="4"
                                Style="{StaticResource SelectionBar}"
                                Visibility="{Binding PinnedSelection.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid RowDefinitions="auto auto auto">

                                <Grid Grid.Row="0" ColumnDefinitions="* auto">
                                    <Button Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            Content="{Binding PinnedSelection.ActionText}"
                                            Command="{Binding RemoveSelectedCommand}" />
                                    <Button Grid.Column="1"
                                            Margin="8 0 0 0"
                                            Content="Clear"
                                            Command="{Binding ClearPinnedSelectionCommand}" />
                                </Grid>

                                <!-- The three things a picked pin can have done to it that are not
                                     taking it out. Locked rows are skipped by the update rather than
                                     asked about, exactly as the batch action above does it. -->
                                <!-- The update button takes what the other two leave, because its label grows to name
                                     the locked pins it skips and the other two are one word each. -->
                                <Grid Grid.Row="1" Margin="0 8 0 0" ColumnDefinitions="* auto auto">
                                    <Button Grid.Column="0"
                                            Margin="0 0 4 0"
                                            HorizontalAlignment="Stretch"
                                            Content="{Binding UpdateSelectedText}"
                                            ToolTip="Move the selected mods to the newest version the repo holds, leaving locked ones alone"
                                            Command="{Binding UpdateSelectedCommand}" />
                                    <Button Grid.Column="1"
                                            Margin="4 0"
                                            MinWidth="72"
                                            HorizontalAlignment="Stretch"
                                            Content="Lock"
                                            ToolTip="Hold the selected mods at their versions in this profile"
                                            Command="{Binding LockSelectedCommand}" />
                                    <Button Grid.Column="2"
                                            Margin="4 0 0 0"
                                            MinWidth="72"
                                            HorizontalAlignment="Stretch"
                                            Content="Unlock"
                                            ToolTip="Release this profile's own lock on the selected mods"
                                            Command="{Binding UnlockSelectedCommand}" />
                                </Grid>

                                <Grid Grid.Row="2"
                                      Margin="0 8 0 0"
                                      ColumnDefinitions="* auto"
                                      Visibility="{Binding PinnedSelection.HasHidden, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="{Binding PinnedSelection.HiddenText}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="1"
                                            Margin="8 0 0 0"
                                            Content="{Binding PinnedSelection.DeselectHiddenText}"
                                            Command="{Binding DeselectHiddenPinnedCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Button Grid.Row="5"
                                Margin="0 8 0 0"
                                HorizontalAlignment="Stretch"
                                Content="Take out everything shown"
                                ToolTip="Take every mod the list above is showing out of this profile"
                                Command="{Binding RemoveAllShownCommand}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Vertical">

            <Grid ColumnDefinitions="auto auto auto * auto">

                <!-- Split button: the primary action is one click, and the variant costs opening the
                     dropdown. A checkbox would be persistent visible state, and one left ticked turns
                     a per-save decision into a standing mode. -->
                <StackPanel x:Name="SaveSplitButton"
                            Grid.Column="0" Orientation="Horizontal" Margin="32 24 4 24">

                    <Button x:Name="SaveButton"
                            MinWidth="200"
                            Style="{StaticResource SaveSplitPrimary}"
                            Content="{Binding SaveActionText}"
                            Command="{Binding SaveChangesCommand}" />

                    <!-- Follows the primary half rather than carrying its own condition: everything
                         behind the caret is a way of doing the save that is greyed out next to it, so
                         a live caret over a dead menu would be an invitation to nothing. -->
                    <ToggleButton x:Name="SaveVariantButton"
                                  Style="{StaticResource SaveSplitCaret}"
                                  ToolTip="Other ways to save"
                                  IsEnabled="{Binding IsEnabled, ElementName=SaveButton}"
                                  Visibility="{Binding WillApply, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Opens upwards, because the button sits on the bottom edge of the page, and
                         hangs off the pair rather than off the caret alone so a menu wider than the
                         caret still starts at an edge that is there in the layout. Declared inline
                         like the row menus, which is what keeps the data context. -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=SaveVariantButton, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SaveSplitButton}"
                           Placement="Top"
                           VerticalOffset="-6"
                           StaysOpen="False"
                           AllowsTransparency="True">

                        <Border CornerRadius="{DynamicResource OverlayCornerRadius}"
                                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="4">
                            <Button Width="320"
                                    Style="{DynamicResource SubtleMenuButton}"
                                    Command="{Binding SaveOnlyCommand}"
                                    Click="CloseSaveVariants">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Save only" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SaveOnlyDescription}"
                                               Margin="0 2 0 0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </Popup>
                </StackPanel>

                <Button Grid.Column="1" Margin="4 24 4 24"
                        Content="Discard changes" Command="{Binding DiscardChangesCommand}" />

                <!-- The way into what the save will do, and back out of it. With the buttons rather
                     than past the text field: it is one more thing to press about the save, and
                     absent while there is nothing to review. -->
                <Button Grid.Column="2" Margin="4 24 4 24"
                        Content="{Binding ReviewButtonText}"
                        Command="{Binding ToggleReviewCommand}"
                        Visibility="{Binding HasModListChanges, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Grid.Column="3" Margin="12 0 16 0" VerticalAlignment="Center">

                    <!-- Only while there is something to save: a box that is always there is a field
                         the page is asking to have filled in, and this one is genuinely optional. On
                         the Save row because it is part of pressing Save, and is worded as what the
                         save is called - Fusion 360's "version description", because this is the same
                         gesture and somebody will recognise it.
                         MaxLength matches ProfileRevision.MaximumLabelLength, which the server refuses
                         beyond - stopping it here means the refusal is never reached. -->
                    <Grid Width="300"
                          HorizontalAlignment="Left"
                          Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox x:Name="VersionDescriptionBox"
                                 MaxLength="100"
                                 Text="{Binding VersionDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="What this save is, in the profile's history. Left empty, the history shows what changed instead."
                                 ToolTipService.InitialShowDelay="200" />

                        <TextBlock Text="Version description (optional)"
                                   Margin="12 0 0 0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=VersionDescriptionBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Why Save is greyed, named rather than merely stated: the answer is "wait for
                         that one", and only the name says which. A draft with nothing to import is
                         a revision write and saves perfectly well beside an import into the same
                         repo, so this is only ever about the half that has to upload. -->
                    <TextBlock Text="{Binding SaveBlockedReason}"
                               Margin="0 6 0 0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasSaveBlockedReason, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <Button Grid.Column="4" Margin="4 24 32 24"
                        Content="Stop saving"
                        Command="{Binding StopSavingCommand}"
                        Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

        </StackPanel>

    </Grid>

</Page>
