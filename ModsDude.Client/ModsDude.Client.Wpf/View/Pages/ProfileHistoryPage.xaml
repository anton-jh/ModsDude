<Page x:Class="ModsDude.Client.Wpf.View.Pages.ProfileHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      xmlns:b="clr-namespace:ModsDude.Client.Wpf.View.Behaviors"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:ProfileHistoryPageViewModel, IsDesignTimeCreatable=False}"
      Title="ProfileHistoryPage"
      FontSize="14">

    <Page.Resources>

        <!-- A small label on a revision row. Neutral unless a trigger says otherwise. -->
        <Style x:Key="RevisionChip" TargetType="Border">
            <Setter Property="Margin" Value="6 0 0 0" />
            <Setter Property="Padding" Value="6 1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

    </Page.Resources>

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <Grid RowDefinitions="auto auto *">

            <uc:PageTitle Grid.Row="0" Text="History" />

            <TextBlock Grid.Row="1"
                       Margin="0 0 0 12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                       Text="Every save this profile has had, newest first. Pick one to see what it pinned. Restoring copies an old list back to the front - nothing in between is deleted, so a restore can itself be undone." />

            <Grid Grid.Row="2" ColumnDefinitions="400 *">

                <!-- The revisions, with the profile editor's selection: click, ctrl/shift-click, the
                     arrow keys, and a box for all of them. One pick is a revision to read; several
                     are a set to delete. -->
                <Grid Grid.Column="0" Margin="0 0 12 0" RowDefinitions="auto * auto">

                    <Grid Grid.Row="0" Margin="0 0 0 8" MinHeight="32" ColumnDefinitions="auto * auto">

                        <CheckBox Grid.Column="0"
                                  Margin="13 0 10 0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Selection.AllShownSelected, Mode=TwoWay}"
                                  ToolTip="Select every revision"
                                  Visibility="{Binding CanPrune, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Grid.Column="1"
                                   Text="Revisions"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Style="{DynamicResource BodyStrongTextBlockStyle}" />

                        <!-- The pruning gesture, as opposed to the list's: the box above picks the
                             current revision too, and ones a savegame keeps. -->
                        <Button Grid.Column="2"
                                Padding="8 2"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Content="Select deletable"
                                ToolTip="Selects every revision that can be deleted: all but the current one and those a savegame snapshot was played on."
                                Command="{Binding SelectDeletableCommand}"
                                Visibility="{Binding CanPrune, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <Border Grid.Row="1"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <Grid RowDefinitions="* auto">

                            <!-- Scrolled by the pixel: a row is three or four lines tall, and a list of
                                 fifty does not need the virtualization that scrolling by the row buys. -->
                            <ListBox Grid.Row="0"
                                     Style="{StaticResource ModList}"
                                     ItemsSource="{Binding Revisions}"
                                     ScrollViewer.CanContentScroll="False"
                                     b:ListSelection.Controller="{Binding Selection}">

                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Restore this"
                                                  Command="{Binding RestoreCommand}"
                                                  Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <MenuItem Header="Save as…"
                                                  Command="{Binding SaveAsCommand}"
                                                  Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Separator Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <MenuItem Header="Delete the selected revisions"
                                                  Command="{Binding PruneCommand}"
                                                  Visibility="{Binding CanPrune, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <MenuItem Header="Select every deletable revision"
                                                  Command="{Binding SelectDeletableCommand}"
                                                  Visibility="{Binding CanPrune, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Separator Visibility="{Binding CanPrune, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <MenuItem Header="Select everything" Command="{Binding SelectAllCommand}" />
                                        <MenuItem Header="Clear the selection" Command="{Binding ClearSelectionCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>

                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProfileRevisionViewModel}">
                                        <Border Padding="0 10 12 10"
                                                BorderThickness="0 0 0 1"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                Background="Transparent">
                                            <Grid ColumnDefinitions="auto auto *">

                                                <!-- Whether this one can be deleted, for whoever may
                                                     delete: a box where it can, and a padlock saying
                                                     why where it cannot. Both in the same column, so
                                                     the answer reads straight down the list. The
                                                     checkbox's own minimum width, because its box is
                                                     drawn a little past a 20px layout slot and gets
                                                     clipped there. The padlock sits over the box. -->
                                                <Grid Grid.Column="0"
                                                      Width="30"
                                                      Margin="12 0 0 0"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding DataContext.CanPrune, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibilityConverter}}">

                                                    <CheckBox HorizontalAlignment="Left"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Visibility="{Binding CanPrune, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <TextBlock Width="20"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Center"
                                                               Background="Transparent"
                                                               Text="&#xE72E;"
                                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               ToolTip="{Binding KeptBecause}"
                                                               ToolTipService.InitialShowDelay="200"
                                                               Visibility="{Binding CanPrune, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                </Grid>

                                                <!-- How it came about. The current list's is filled
                                                     with the accent, so the head is findable at a
                                                     glance in a list of restores and edits. -->
                                                <Border Grid.Column="1"
                                                        Width="32" Height="32"
                                                        VerticalAlignment="Top"
                                                        CornerRadius="16"
                                                        ToolTip="{Binding OriginTooltip}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Margin" Value="12 0 12 0" />
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <!-- Closer behind the checkbox slot, which
                                                                     already ends in the box's own spacing. -->
                                                                <DataTrigger Binding="{Binding DataContext.CanPrune, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                    <Setter Property="Margin" Value="4 0 12 0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHead}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               Text="{Binding OriginGlyph}"
                                                               FontFamily="{DynamicResource SymbolThemeFontFamily}" />
                                                </Border>

                                                <StackPanel Grid.Column="2">

                                                    <Grid ColumnDefinitions="* auto auto">
                                                        <TextBlock Grid.Column="0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                                        <!-- What keeps it, said on the row itself for
                                                             everybody - somebody who cannot prune still
                                                             wants to know a save was played on this. -->
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource RevisionChip}"
                                                                ToolTip="{Binding PlayedOnTooltip}"
                                                                ToolTipService.InitialShowDelay="200"
                                                                Visibility="{Binding IsPlayedOn, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Margin="0 0 4 0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="11"
                                                                           Text="&#xE74E;"
                                                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="{Binding PlayedOnText}"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           Style="{DynamicResource CaptionTextBlockStyle}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Which one a sync would actually install.
                                                             Without it the top row and the current list
                                                             are only the same thing by coincidence of
                                                             ordering. -->
                                                        <Border Grid.Column="2"
                                                                Style="{StaticResource RevisionChip}"
                                                                Background="{DynamicResource AccentFillColorSecondaryBrush}"
                                                                Visibility="{Binding IsHead, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="Current"
                                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                                       Style="{DynamicResource CaptionTextBlockStyle}" />
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Margin="0 2 0 0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding Summary}" />

                                                    <TextBlock Margin="0 4 0 0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Style="{DynamicResource CaptionTextBlockStyle}">
                                                        <Run Text="{Binding When, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding Author, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding ModCountText, Mode=OneWay}" />
                                                    </TextBlock>

                                                    <!-- Where retention has dated this revision. -->
                                                    <StackPanel Margin="0 4 0 0"
                                                                Orientation="Horizontal"
                                                                Background="Transparent"
                                                                ToolTip="{Binding DeletionTooltip}"
                                                                ToolTipService.InitialShowDelay="300"
                                                                Visibility="{Binding HasDeletion, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Margin="0 0 4 0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Text="&#xE823;"
                                                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <TextBlock Text="{Binding DeletionText}"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                   Style="{DynamicResource CaptionTextBlockStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="1"
                                       Margin="12 8"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       Text="Older revisions than these exist and are not shown here yet."
                                       Visibility="{Binding HasOlder, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Only for whoever may delete, and only while something is picked. The button
                         counts what a delete would take, and the line under it names what it would
                         leave - so a selection with the current revision in it is never a surprise. -->
                    <Border Grid.Row="2"
                            Style="{StaticResource SelectionBar}"
                            Visibility="{Binding ShowsSelectionBar, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid RowDefinitions="auto auto" ColumnDefinitions="* auto auto">

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Selection.SelectedText}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <Button Grid.Row="0" Grid.Column="1"
                                    Margin="8 0 0 0"
                                    Content="Clear"
                                    Command="{Binding ClearSelectionCommand}" />

                            <Button Grid.Row="0" Grid.Column="2"
                                    Margin="8 0 0 0"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Content="{Binding Selection.ActionText}"
                                    ToolTip="Deletes the selected revisions that can go. This cannot be undone."
                                    Command="{Binding PruneCommand}" />

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                                        Margin="0 6 0 0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding HasKept, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Margin="0 1 6 0"
                                           VerticalAlignment="Top"
                                           FontSize="11"
                                           Text="&#xE72E;"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock MaxWidth="330"
                                           TextWrapping="Wrap"
                                           Text="{Binding KeptText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Style="{DynamicResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- What it pinned. -->
                <Grid Grid.Column="1" RowDefinitions="auto *">

                    <!-- The pane's title, and what can be done with the revision it shows, next to
                         it rather than under the list: Restore and Save as are about this one
                         revision, and the bar under the list is about the whole selection.
                         Two views of one pane, too: "what did it hold" and "what changed" are asked
                         about the same revision seconds apart, so a comparison you have to navigate
                         away to see makes it two acts of memory instead of one. -->
                    <Grid Grid.Row="0" Margin="0 0 0 8" MinHeight="32" ColumnDefinitions="* auto auto auto auto">

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Style="{DynamicResource BodyStrongTextBlockStyle}"
                                   Text="{Binding SelectedTitle}" />

                        <RadioButton Grid.Column="1"
                                     Margin="8 0 0 0"
                                     MinWidth="0"
                                     VerticalAlignment="Center"
                                     Content="Contents"
                                     GroupName="HistoryPane"
                                     IsChecked="{Binding ShowContents, Mode=OneWay}"
                                     Command="{Binding ShowContentsViewCommand}"
                                     Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <RadioButton Grid.Column="2"
                                     Margin="12 0 0 0"
                                     MinWidth="0"
                                     VerticalAlignment="Center"
                                     Content="Changes"
                                     GroupName="HistoryPane"
                                     IsChecked="{Binding ShowChanges, Mode=OneWay}"
                                     Command="{Binding ShowChangesViewCommand}"
                                     Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <StackPanel Grid.Column="3"
                                    Margin="16 0 0 0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding ShowsRevisionActions, Converter={StaticResource BoolToVisibilityConverter}}">

                            <Button Style="{DynamicResource AccentButtonStyle}"
                                    Content="Restore this"
                                    ToolTip="Copies this revision's mod list back to the front as a new revision."
                                    Command="{Binding RestoreCommand}" />

                            <Button Margin="8 0 0 0"
                                    Content="Save as…"
                                    ToolTip="Creates a new profile that starts as a copy of this revision."
                                    Command="{Binding SaveAsCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <Grid>

                            <Grid RowDefinitions="auto *"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">

                                <!-- Which pair is being compared. Defaults to the revision before the
                                     selected one, so this pane and that row's own summary counts are
                                     describing the same thing until somebody asks otherwise. -->
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Margin="16 12"
                                            Visibility="{Binding ShowChanges, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <TextBlock Text="Compared with"
                                               VerticalAlignment="Center"
                                               Margin="0 0 8 0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <ComboBox Width="220"
                                              ItemsSource="{Binding ComparisonTargets}"
                                              SelectedItem="{Binding ComparedWith, Mode=TwoWay}"
                                              DisplayMemberPath="Title" />
                                </StackPanel>

                                <Grid Grid.Row="1"
                                      Visibility="{Binding ShowContents, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <!-- The same row as everywhere else, rendered by the implicit
                                         ModListItemViewModel template in App.xaml. -->
                                    <ItemsControl ItemsSource="{Binding Mods}"
                                                  VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer CanContentScroll="True"
                                                              Focusable="False"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PinnedModViewModel}">
                                                <Grid ColumnDefinitions="* auto">
                                                    <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                                    <TextBlock Grid.Column="1"
                                                               Margin="0 0 12 0"
                                                               VerticalAlignment="Center"
                                                               Text="&#xE72E;"
                                                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               ToolTip="{Binding LockNote}" ToolTipService.InitialShowDelay="200"
                                                               Visibility="{Binding IsLockedByProfile, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Reading this revision…"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsLoadingMods, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>

                                <Grid Grid.Row="1"
                                      Visibility="{Binding ShowChanges, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <ItemsControl ItemsSource="{Binding Changes}"
                                                  VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer CanContentScroll="True"
                                                              Focusable="False"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ProfileModChangeViewModel}">
                                                <Grid ColumnDefinitions="* auto auto">

                                                    <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                                    <!-- The version transition, in the form somebody reads
                                                         a diff in. Empty where only the lock moved, which
                                                         the chip beside it says instead. -->
                                                    <TextBlock Grid.Column="1"
                                                               Margin="0 0 8 0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Transition}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding HasTransition, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <Border Grid.Column="2"
                                                            Margin="0 0 12 0"
                                                            Padding="8 2"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="3"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                        <TextBlock Text="{Binding KindText}"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Style="{DynamicResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Comparing…"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsLoadingChanges, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <TextBlock Text="{Binding NoChangesText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasNoChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Grid>

                            <!-- Several picked: no one revision to show, so what the set is instead -
                                 and, for whoever may delete, how much of it a delete would take. What it would
                                 leave, and why, is under the list beside the button. -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="420"
                                        Visibility="{Binding ShowsSeveral, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="32"
                                           Text="&#xE762;"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Margin="0 12 0 0"
                                           HorizontalAlignment="Center"
                                           Text="{Binding SeveralTitle}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}" />
                                <TextBlock Margin="0 4 0 0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="{Binding SeveralText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Text="Pick a revision to see what it pinned."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding ShowsNothing, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Page>
