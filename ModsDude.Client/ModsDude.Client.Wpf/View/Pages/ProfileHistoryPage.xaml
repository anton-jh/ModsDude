<Page x:Class="ModsDude.Client.Wpf.View.Pages.ProfileHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:ProfileHistoryPageViewModel, IsDesignTimeCreatable=False}"
      Title="ProfileHistoryPage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <Grid RowDefinitions="auto auto auto auto *">

            <TextBlock Grid.Row="0"
                       Style="{DynamicResource TitleTextBlockStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding ProfileName}" />
            <TextBlock Grid.Row="1"
                       Style="{DynamicResource SubtitleTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                       Text="History"
                       Margin="0 8 0 24" />

            <TextBlock Grid.Row="2"
                       Margin="0 0 0 12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                       Text="Every save this profile has had, newest first. Pick one to see what it pinned. Restoring copies an old list back to the front - nothing in between is deleted, so a restore can itself be undone." />

            <Border Grid.Row="3"
                    Margin="0 0 0 12"
                    Padding="12 8"
                    CornerRadius="4"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding Status}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>

            <Grid Grid.Row="4" ColumnDefinitions="380 *">

                <!-- The revisions. -->
                <Border Grid.Column="0"
                        Margin="0 0 12 0"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Grid RowDefinitions="* auto auto">

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding Revisions}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfileRevisionViewModel}">
                                    <Grid Margin="0 4" ColumnDefinitions="* auto">

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Margin="0 2 0 0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Summary}" />

                                            <TextBlock Margin="0 2 0 0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Style="{DynamicResource CaptionTextBlockStyle}">
                                                <Run Text="{Binding When, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding Author, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding ModCountText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Which one a sync would actually install. Without it the
                                             top row and the current list are only the same thing by
                                             coincidence of ordering. -->
                                        <Border Grid.Column="1"
                                                Margin="8 0 0 0"
                                                Padding="8 2"
                                                VerticalAlignment="Top"
                                                CornerRadius="3"
                                                Background="{DynamicResource AccentFillColorSecondaryBrush}"
                                                Visibility="{Binding IsHead, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Current"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                       Style="{DynamicResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="1"
                                   Margin="12 4"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Text="Older revisions than these exist and are not shown here yet."
                                   Visibility="{Binding HasOlder, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Border Grid.Row="2"
                                BorderThickness="0 1 0 0"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="12" ColumnDefinitions="* *">
                                <Button Grid.Column="0"
                                        Margin="0 0 4 0"
                                        HorizontalAlignment="Stretch"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Content="Restore this"
                                        ToolTip="Copies this revision's mod list back to the front as a new revision."
                                        Command="{Binding RestoreCommand}" />

                                <Button Grid.Column="1"
                                        Margin="4 0 0 0"
                                        HorizontalAlignment="Stretch"
                                        Content="Save as…"
                                        ToolTip="Creates a new profile that starts as a copy of this revision."
                                        Command="{Binding SaveAsCommand}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- What it pinned. -->
                <Border Grid.Column="1"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Grid RowDefinitions="auto auto *">

                        <!-- Two views of one pane. "What did it hold" and "what changed" are asked
                             about the same revision seconds apart, so a comparison you have to
                             navigate away to see makes it two acts of memory instead of one. -->
                        <Grid Grid.Row="0" Margin="16 12" ColumnDefinitions="* auto auto">

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"
                                       Text="{Binding SelectedTitle}" />

                            <RadioButton Grid.Column="1"
                                         Margin="8 0 0 0"
                                         Content="Contents"
                                         GroupName="HistoryPane"
                                         IsChecked="{Binding ShowContents, Mode=OneWay}"
                                         Command="{Binding ShowContentsViewCommand}" />

                            <RadioButton Grid.Column="2"
                                         Margin="12 0 0 0"
                                         Content="Changes"
                                         GroupName="HistoryPane"
                                         IsChecked="{Binding ShowChanges, Mode=OneWay}"
                                         Command="{Binding ShowChangesViewCommand}" />
                        </Grid>

                        <!-- Which pair is being compared. Defaults to the revision before the
                             selected one, so this pane and that row's own summary counts are
                             describing the same thing until somebody asks otherwise. -->
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="16 0 16 12"
                                    Visibility="{Binding ShowChanges, Converter={StaticResource BoolToVisibilityConverter}}">

                            <TextBlock Text="Compared with"
                                       VerticalAlignment="Center"
                                       Margin="0 0 8 0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <ComboBox Width="220"
                                      ItemsSource="{Binding ComparisonTargets}"
                                      SelectedItem="{Binding ComparedWith, Mode=TwoWay}"
                                      DisplayMemberPath="Title" />
                        </StackPanel>

                        <Grid Grid.Row="2"
                              Visibility="{Binding ShowContents, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- The same row as everywhere else, rendered by the implicit
                                 ModListItemViewModel template in App.xaml. -->
                            <ItemsControl ItemsSource="{Binding Mods}"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True"
                                                      Focusable="False"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PinnedModViewModel}">
                                        <Grid ColumnDefinitions="* auto">
                                            <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                            <TextBlock Grid.Column="1"
                                                       Margin="0 0 12 0"
                                                       VerticalAlignment="Center"
                                                       Text="&#xE72E;"
                                                       FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       ToolTip="{Binding LockNote}" ToolTipService.InitialShowDelay="200"
                                                       Visibility="{Binding IsLockedByProfile, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Reading this revision…"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding IsLoadingMods, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <Grid Grid.Row="2"
                              Visibility="{Binding ShowChanges, Converter={StaticResource BoolToVisibilityConverter}}">

                            <ItemsControl ItemsSource="{Binding Changes}"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True"
                                                      Focusable="False"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ProfileModChangeViewModel}">
                                        <Grid ColumnDefinitions="* auto auto">

                                            <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                            <!-- The version transition, in the form somebody reads
                                                 a diff in. Empty where only the lock moved, which
                                                 the chip beside it says instead. -->
                                            <TextBlock Grid.Column="1"
                                                       Margin="0 0 8 0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Transition}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasTransition, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Border Grid.Column="2"
                                                    Margin="0 0 12 0"
                                                    Padding="8 2"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="3"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding KindText}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Style="{DynamicResource CaptionTextBlockStyle}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Comparing…"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding IsLoadingChanges, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock Text="{Binding NoChangesText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasNoChanges, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Page>
