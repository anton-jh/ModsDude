<Page x:Class="ModsDude.Client.Wpf.View.Pages.RepoSavegamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:RepoSavegamesPageViewModel, IsDesignTimeCreatable=False}"
      Title="RepoSavegamesPage"
      FontSize="14">

    <Page.Resources>

        <!-- A snapshot: something the savegame still has, and the only kind of row the buttons under
             the list can act on. It gets the height, the weight and a solid marker, because picking
             one out of an evening's worth of claim rows is what somebody opens this panel to do. -->
        <DataTemplate x:Key="TimelineSnapshotRow" DataType="{x:Type vm:SavegameTimelineEntryViewModel}">
            <Grid Margin="14 10" ColumnDefinitions="20 * auto">

                <!-- The spine. Solid here and hollow on an event row, which is the distinction at a
                     glance from across the panel, before any of the words are read. -->
                <Ellipse Grid.Column="0"
                         Width="9" Height="9"
                         Margin="0 5 0 0"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Fill="{DynamicResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Style="{DynamicResource BodyStrongTextBlockStyle}" />

                    <TextBlock Margin="0 2 0 0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding Detail}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Margin="0 2 0 0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Style="{DynamicResource CaptionTextBlockStyle}">
                        <Run Text="{Binding Who, Mode=OneWay}" />
                        <Run Text="·" />
                        <Run Text="{Binding AgoText, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Where retention has dated this snapshot. -->
                    <TextBlock Margin="0 2 0 0"
                               Text="{Binding DeletionText}"
                               ToolTip="{Binding DeletionTooltip}"
                               ToolTipService.InitialShowDelay="300"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Visibility="{Binding HasDeletion, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <Border Grid.Column="2"
                        Margin="8 0 0 0"
                        VerticalAlignment="Top"
                        Style="{StaticResource StatusChip}"
                        Background="{DynamicResource AccentFillColorSecondaryBrush}"
                        Visibility="{Binding IsHead, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Current"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                               Style="{DynamicResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- A claim taken or a claim ended: something that merely happened to the save. One line,
             half the height and none of the weight, so a run of them reads as a margin note beside
             the snapshots rather than competing with them. -->
        <DataTemplate x:Key="TimelineEventRow" DataType="{x:Type vm:SavegameTimelineEntryViewModel}">
            <Grid Margin="14 5" ColumnDefinitions="20 auto * auto">

                <Ellipse Grid.Column="0"
                         Width="7" Height="7"
                         Margin="1 0 0 0"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Fill="Transparent"
                         Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                         StrokeThickness="1.2" />

                <!-- Struck through once the claim is over. The check-out keeps its own date and its
                     own row that way, instead of being restamped or reworded by something that
                     happened to it hours later. Foreground is a setter rather than an attribute so
                     the trigger can win - a local value would outrank it. -->
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding Title}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2"
                           Margin="8 0 0 0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Detail}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Grid.Column="3"
                           Margin="12 0 0 0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Style="{DynamicResource CaptionTextBlockStyle}">
                    <Run Text="{Binding Who, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding AgoText, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- The container both lists on this page use, which is where the rules that have to hold for
             every row live: the hairline between rows, the hover, and the two accents that say which
             row is selected. Same shape as the mod rows - a divider and a subtle fill - so a list in
             this app looks like a list, and so the saves and their history read as one surface rather
             than as two controls that happen to sit side by side.

             It knows nothing about what a row contains: the padding belongs to the row templates,
             because a save is four lines and a claim is one. -->
        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                BorderThickness="0 0 0 1"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <Grid>
                                <!-- The accent at low opacity rather than a named fill, so it reads as
                                     a selection in both themes and cannot be mistaken for the hover
                                     underneath it. -->
                                <Border x:Name="Fill"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        Opacity="0" />

                                <Rectangle x:Name="Bar"
                                           Width="3"
                                           Margin="0 4"
                                           RadiusX="1.5" RadiusY="1.5"
                                           HorizontalAlignment="Left"
                                           Visibility="Collapsed"
                                           Fill="{DynamicResource AccentFillColorDefaultBrush}" />

                                <ContentPresenter />

                                <Border x:Name="Focus"
                                        BorderThickness="0"
                                        BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.16" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <Grid RowDefinitions="auto auto *">

            <uc:PageTitle Grid.Row="0" Text="Saves" />

            <StackPanel Grid.Row="1" Margin="0 0 0 12" HorizontalAlignment="Left">
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                           Text="Every save in this repo, and which profile each one follows. One person holds a save at a time and hands it back explicitly - so checking one out stops anybody else taking it until you check it in. Taking a copy stops nobody." />

                <!-- What the repo's saves add up to. Kept apart from the sentence above, which is about
                     how saves work and does not change, because this is the number somebody comes to
                     check when deciding what to prune. -->
                <TextBlock Margin="0 6 0 0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding StatisticsText}"
                           Visibility="{Binding HasStatistics, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="420 *">

                <!-- The saves. -->
                <Border Grid.Column="0"
                        Margin="0 0 12 0"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Grid RowDefinitions="auto * auto auto">

                        <!-- Past savegames are hidden by default: they stay findable without filling a
                             list somebody opened to find the one they are playing tonight. The count
                             is said out loud, because a filter nobody can see is a list that is
                             quietly wrong. -->
                        <Grid Grid.Row="0" Margin="12 10 12 4" ColumnDefinitions="auto *">
                            <CheckBox Grid.Column="0"
                                      Content="Show past savegames"
                                      ToolTip="Savegames their profile has moved on from. They are still playable, and their mod list does not move."
                                      IsChecked="{Binding ShowPastSavegames, Mode=TwoWay}" />

                            <TextBlock Grid.Column="1"
                                       Margin="8 0 0 0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{Binding HiddenPastText}"
                                       Visibility="{Binding HasHiddenPast, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Savegames}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Padding="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource ListRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SavegameListItemViewModel}">

                                    <!-- The inset the container no longer provides, and it clears the
                                         selection bar rather than sitting under it. -->
                                    <Grid ColumnDefinitions="auto * auto">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Margin" Value="12 10" />
                                                <Style.Triggers>
                                                    <!-- A past savegame hangs under its profile's current one. -->
                                                    <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                        <Setter Property="Margin" Value="36 10 12 10" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <!-- The elbow that says "under the row above": a line down from the
                                             row's top edge to the title, then across. Drawn into the row's
                                             own margin, so the past row's content is what moves right and the
                                             connector needs no column of its own. -->
                                        <Border Grid.ColumnSpan="3"
                                                Width="14" Height="24"
                                                Margin="-22 -10 0 0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                CornerRadius="0 0 0 5"
                                                BorderThickness="1.5 0 0 1.5"
                                                BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                Visibility="{Binding IsPast, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Top">

                                            <!-- Which numbered slot it is in on this machine, first and
                                                 loudest: in a game with twenty slots it is often how a
                                                 player picks this save out of the list. Absent where the
                                                 game does not number its slots or the save is not here. -->
                                            <uc:SlotBadge Margin="0 0 10 0"
                                                          Number="{Binding HoldSlotNumber}" />

                                            <!-- Whoever holds it, drawn the same way they are drawn in the
                                                 member list. An identity, not a warning. -->
                                            <Border Width="28" Height="28"
                                                    Margin="0 0 10 0"
                                                    CornerRadius="14"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding HolderColor}"
                                                    ToolTip="{Binding HolderTag}"
                                                    Visibility="{Binding HasHolder, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding HolderInitial}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="White"
                                                           Style="{DynamicResource BodyStrongTextBlockStyle}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Past rows are dimmed as well as indented: the profile has moved on
                                             from them, so they should recede behind the one it is following.
                                             Only this column - the buttons stay at full strength, because a
                                             past savegame is still playable. -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                            <Setter Property="Opacity" Value="0.7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Margin="0 2 0 0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding ProfileName}" />

                                            <TextBlock Margin="0 2 0 0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                                       Text="{Binding Summary}" />

                                            <!-- What the game says about the head snapshot, recorded
                                                 by whoever checked it in. The half of the row that
                                                 is about the save rather than about sharing it. -->
                                            <TextBlock Margin="0 2 0 0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding GameSummary}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                                       Text="{Binding GameSummary}"
                                                       Visibility="{Binding HasGameSummary, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <ItemsControl Margin="0 6 0 0" ItemsSource="{Binding Chips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <!-- Which of the game's savegame folders the copy is in,
                                                 on the rare rows where that is not obvious. This is
                                                 what the game's own slot list used to be a page of,
                                                 and for a game reaching one folder it says nothing
                                                 at all. -->
                                            <TextBlock Margin="0 4 0 0"
                                                       TextWrapping="Wrap"
                                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding HoldNote}"
                                                       Visibility="{Binding HasHoldNote, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- Coloured, unlike the line above it, because this one
                                                 is a save nothing on this machine can open rather
                                                 than a fact about which folder it is in. -->
                                            <TextBlock Margin="0 4 0 0"
                                                       TextWrapping="Wrap"
                                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Text="{Binding UnreachableHoldNote}"
                                                       Visibility="{Binding HasUnreachableHoldNote, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- Why Check out is greyed out, where it is. Tertiary
                                                 rather than caution: nothing is wrong with the save,
                                                 another one simply has the mod folder. -->
                                            <TextBlock Margin="0 2 0 0"
                                                       TextWrapping="Wrap"
                                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding BlockedReason}"
                                                       Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <!-- No Apply profile button: where the mod folder is not on the
                                             list the save runs on, Check out and Take a copy each ask
                                             to activate it first. Check out is not offered to a guest -
                                             a control leading to a refusal is worse than one never
                                             offered - and carries its own reason when disabled.

                                             An accent primary and ordinary buttons, which is the
                                             pairing the snapshot footer already uses. Not SubtleMenuButton:
                                             that one is transparent until hovered, which is right for the
                                             page's own menu verbs - Rename, Archive, Refresh - where the
                                             surrounding chrome says a control is there. Out here each
                                             button is alone against a row of prose, and one that reads as
                                             text until the pointer finds it is one nobody knows to press. -->
                                        <StackPanel Grid.Column="2"
                                                    Margin="8 0 0 0"
                                                    MinWidth="140"
                                                    VerticalAlignment="Top">

                                            <!-- Exactly one accent button, and which one is the whole
                                                 of what the row is for: a save you are holding on this
                                                 machine is one you have come here to hand back, not one
                                                 to take again. -->
                                            <Button Content="Check in"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{DynamicResource AccentButtonStyle}"
                                                    ToolTip="{Binding CheckInToolTip}"
                                                    Command="{Binding CheckInCommand}"
                                                    Visibility="{Binding CanCheckIn, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Button Content="{Binding CheckOutLabel}"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{DynamicResource AccentButtonStyle}"
                                                    ToolTip="{Binding CheckOutToolTip}"
                                                    Command="{Binding CheckOutCommand}"
                                                    Visibility="{Binding ChecksOutAsPrimary, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- The other way out of a hold, immediately below the
                                                 first: Check in mints a snapshot, Discard mints
                                                 nothing and recycles the copy. The choice between
                                                 them is about what happened while you had the save,
                                                 so they belong on the same row rather than a page
                                                 apart - which is where Discard used to live. -->
                                            <Button Margin="0 4 0 0"
                                                    Content="Discard"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip="{Binding DiscardToolTip}"
                                                    Command="{Binding DiscardCommand}"
                                                    Visibility="{Binding CanDiscard, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- Only where the folder holding the copy has gone out
                                                 of the game's settings, which is the one state
                                                 nothing else gets out of. A hold whose savegame the
                                                 repo deleted never reaches a row at all - it is
                                                 dropped on sight. -->
                                            <Button Margin="0 4 0 0"
                                                    Content="Stop tracking"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip="{Binding DisconnectToolTip}"
                                                    Command="{Binding DisconnectCommand}"
                                                    Visibility="{Binding CanDisconnect, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- The same command again, quietly, beside Check in. It is
                                                 how a held save moves to another slot without being
                                                 handed back first. -->
                                            <Button Margin="0 4 0 0"
                                                    Content="{Binding CheckOutLabel}"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip="{Binding CheckOutToolTip}"
                                                    Command="{Binding CheckOutCommand}"
                                                    Visibility="{Binding ChecksOutAsSecondary, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Button Margin="0 4 0 0"
                                                    Content="Take a copy"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip="{Binding TakeCopyToolTip}"
                                                    Command="{Binding TakeCopyCommand}" />

                                            <!-- Only on a past savegame, and the other end of the swap a
                                                 publish performs. It displaces somebody's current
                                                 savegame, so it asks first. -->
                                            <Button Margin="0 4 0 0"
                                                    Content="Make current"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip="Puts this savegame back in its profile's current slot, so it follows the mod list again. Whichever savegame is there becomes past."
                                                    Command="{Binding MakeCurrentCommand}"
                                                    Visibility="{Binding CanMakeCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="1"
                                   Margin="16"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding EmptyText}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Grid.Row="2"
                                   Margin="12 4"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Reading the repo's saves…"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Border Grid.Row="3"
                                BorderThickness="0 1 0 0"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Margin="12">
                                <Button Style="{DynamicResource SubtleMenuButton}"
                                        Content="Refresh"
                                        Command="{Binding RefreshCommand}" />

                                <!-- Where a repo's first savegame comes from, which is why it sits
                                     under the list that is empty and saying so. It asks which save
                                     on this disk it is about, then the publish dialog asks the
                                     rest. -->
                                <Button Margin="8 0 0 0"
                                        Style="{DynamicResource SubtleMenuButton}"
                                        Content="Publish a save"
                                        ToolTip="Takes a save already on this machine and makes a savegame of it in this repo."
                                        Command="{Binding PublishSaveCommand}"
                                        Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Its history: snapshots and checkouts as one column. -->
                <Border Grid.Column="1"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Grid RowDefinitions="auto * auto auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">

                        <Grid Grid.Row="0" Margin="16 12" ColumnDefinitions="* auto">
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"
                                       Text="{Binding SelectedTitle}" />

                            <!-- Into the profile's own history, where two revisions can be compared
                                 properly. Repeating a cut-down comparison here would be a second
                                 answer to keep true. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{DynamicResource SubtleMenuButton}"
                                        Content="See the profile's history"
                                        ToolTip="Opens this save's profile, where any two revisions can be compared."
                                        Command="{Binding CompareRevisionsCommand}" />

                                <!-- A name and nothing else. A savegame cannot be moved between
                                     profiles, so there is no second field to grow here. -->
                                <Button Style="{DynamicResource SubtleMenuButton}"
                                        Content="Rename"
                                        ToolTip="Changes what everybody in this repo sees this save called. Its history and whoever holds it are untouched."
                                        Command="{Binding RenameSavegameCommand}"
                                        Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- The only way a savegame goes away. It keeps its snapshots and
                                     whoever holds it; it leaves this list and frees its name. -->
                                <Button Style="{DynamicResource SubtleMenuButton}"
                                        Content="Archive"
                                        ToolTip="Moves it to the repo's Archive. Nothing about the save changes and it can be brought back."
                                        Command="{Binding ArchiveSavegameCommand}"
                                        Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Timeline}"
                                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                     BorderThickness="0"
                                     Padding="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ItemContainerStyle="{StaticResource ListRow}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>

                                    <!-- Which of the two row designs a row gets. The template is chosen
                                         by a setter rather than an attribute, because a local value on
                                         the element would outrank the trigger and every row would come
                                         out an event. -->
                                    <DataTemplate DataType="{x:Type vm:SavegameTimelineEntryViewModel}">
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="ContentTemplate" Value="{StaticResource TimelineEventRow}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSnapshot}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource TimelineSnapshotRow}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Reading this save's history…"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding IsLoadingTimeline, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <!-- What the selected entry was, and the two things that can be done with it. -->
                        <Border Grid.Row="2"
                                BorderThickness="0 1 0 0"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="16 12" DataContext="{Binding SelectedEntry}">

                                <TextBlock Text="{Binding Title}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                <!-- What the row said, repeated here because a claim row has nothing
                                     else to show in this panel - no size, no revision, no details. -->
                                <TextBlock Margin="0 4 0 0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Detail}"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <TextBlock Margin="0 4 0 0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding Who, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding WhenText, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Margin="0 2 0 0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SizeText}"
                                           Visibility="{Binding HasSize, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- The recorded truth about which mod list this was played on.
                                     Anything read out of the save file itself is display-only. -->
                                <TextBlock Margin="0 2 0 0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding RevisionText}"
                                           Visibility="{Binding HasRevision, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- The date, and here in the panel the reason too, since there is
                                     room for it and a tooltip is easy to miss. -->
                                <TextBlock Margin="0 2 0 0"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding DeletionText}"
                                           Visibility="{Binding HasDeletion, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <TextBlock Margin="0 2 0 0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           Text="{Binding DeletionTooltip}"
                                           Visibility="{Binding HasDeletion, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Whatever the adapter chose to record about this snapshot. Labels
                                     and values both come from it, so nothing here knows what a map
                                     is - see SavegameDetail. -->
                                <ItemsControl Margin="0 6 0 0"
                                              ItemsSource="{Binding Details}"
                                              Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="110 *" Margin="0 0 0 2">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Style="{DynamicResource CaptionTextBlockStyle}" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Style="{DynamicResource CaptionTextBlockStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Margin="0 2 0 0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           Text="{Binding Label}"
                                           Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <!-- The two verbs sit on the entry rather than on the row, because which
                             snapshot they act on is what the timeline selection decides. -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    Margin="16 12 16 12"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVisibilityConverter}}">

                            <Button Margin="0 0 8 0"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Content="Check this snapshot out"
                                    ToolTip="An older snapshot is copied forward as the newest one first, so nothing in between is deleted."
                                    Command="{Binding CheckOutSnapshotCommand}"
                                    Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <Button Margin="0 0 8 0"
                                    Content="Take a copy of this snapshot"
                                    ToolTip="Writes it into a slot and claims nothing. Whoever holds the save keeps holding it."
                                    Command="{Binding TakeCopySnapshotCommand}" />

                            <!-- Admin only, and never the current snapshot. Also the way an old
                                 profile revision stops being blocked from pruning. -->
                            <Button Content="Delete this snapshot"
                                    ToolTip="Removes this copy for good. The current snapshot and the others stay."
                                    Command="{Binding DeleteSnapshotCommand}"
                                    Visibility="{Binding CanPruneSnapshots, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Page>
