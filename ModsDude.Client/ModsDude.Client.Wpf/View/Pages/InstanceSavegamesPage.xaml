<Page x:Class="ModsDude.Client.Wpf.View.Pages.InstanceSavegamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:InstanceSavegamesPageViewModel, IsDesignTimeCreatable=False}"
      Title="InstanceSavegamesPage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <Grid RowDefinitions="auto auto auto auto auto *">

            <TextBlock Grid.Row="0"
                       Style="{DynamicResource TitleTextBlockStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding InstanceName}" />
            <TextBlock Grid.Row="1"
                       Style="{DynamicResource SubtitleTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                       Text="Saves"
                       Margin="0 8 0 24" />

            <TextBlock Grid.Row="2"
                       Margin="0 0 0 8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Every place this installation can hold a save, and what is in each one. A slot is occupied by ModsDude only while a save is checked out - checking one in frees it again." />

            <TextBlock Grid.Row="3"
                       Margin="0 0 0 12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                       Text="{Binding ActiveProfileText}" />

            <Border Grid.Row="4"
                    Margin="0 0 0 12"
                    Padding="12 8"
                    CornerRadius="4"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding Status}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>

            <Border Grid.Row="5"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Grid RowDefinitions="* auto">

                    <ItemsControl Grid.Row="0"
                                  ItemsSource="{Binding Slots}"
                                  Margin="4">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SavegameSlotRowViewModel}">
                                <Border Margin="8 6"
                                        Padding="12"
                                        CornerRadius="4"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="400">
                                    <Grid ColumnDefinitions="* auto">

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Style="{DynamicResource BodyStrongTextBlockStyle}" />

                                                <ContentPresenter Margin="8 0 0 0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding Chip}" />
                                            </StackPanel>

                                            <TextBlock Margin="0 4 0 0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Detail}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Margin="12 0 0 0"
                                                    VerticalAlignment="Center">

                                            <!-- Publish is only ever offered on bytes nobody has
                                                 claimed. An empty slot has nothing to publish and a
                                                 checked-out one is checked in, not published again. -->
                                            <Button Content="Publish this save"
                                                    Style="{DynamicResource AccentButtonStyle}"
                                                    ToolTip="Uploads it as a savegame of its own. It stays where it is, checked out to you."
                                                    Command="{Binding PublishCommand}"
                                                    Visibility="{Binding CanPublish, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Button Content="Check in"
                                                    Style="{DynamicResource AccentButtonStyle}"
                                                    ToolTip="Uploads what is here as a new version, and frees the slot unless you keep playing."
                                                    Command="{Binding CheckInCommand}"
                                                    Visibility="{Binding CanCheckIn, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Button Margin="8 0 0 0"
                                                    Content="Discard"
                                                    Style="{DynamicResource SubtleMenuButton}"
                                                    ToolTip="Hands the claim back without minting a version. The local copy goes to the Recycle Bin."
                                                    Command="{Binding DiscardCommand}"
                                                    Visibility="{Binding CanDiscard, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="0"
                               Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="{Binding Problem}"
                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Grid.Row="0"
                               Margin="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="This installation reports no savegame slots."
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Border Grid.Row="1"
                            BorderThickness="0 1 0 0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <Button Style="{DynamicResource SubtleMenuButton}"
                                    Content="Re-read the slots"
                                    Command="{Binding RefreshCommand}" />

                            <TextBlock Margin="12 0 0 0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Reading the savegame folder…"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Page>
