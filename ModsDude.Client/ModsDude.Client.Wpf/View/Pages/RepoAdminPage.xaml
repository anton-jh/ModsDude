<Page x:Class="ModsDude.Client.Wpf.View.Pages.RepoAdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:RepoAdminPageViewModel, IsDesignTimeCreatable=False}"
      Title="RepoAdminPage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <StackPanel Orientation="Vertical" Style="{StaticResource PageColumn}">

                <uc:PageTitle Text="Admin" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="Basics" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">
                            <Label Content="Name" Margin="0 0 0 12"/>
                            <TextBox Width="300" Text="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </GroupBox>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Game adapter settings" Padding="0 16 0 16">
                        <uc:DynamicFormEditor DataContext="{Binding BaseSettingsEditor}" />
                    </GroupBox>
                </Border>

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource PageActions}">
            <Button Grid.Column="0" Width="250" Style="{DynamicResource AccentButtonStyle}"
                    Content="Save changes" Command="{Binding Path=SaveChangesCommand}" />

            <Button Grid.Column="2" Width="250" Margin="8 0 0 0"
                    Content="Archive repo"
                    ToolTip="Takes it out of everybody's sidebar and frees its name. It can be brought back from the Archive."
                    Command="{Binding Path=ArchiveRepoCommand}" />
        </StackPanel>

    </Grid>
</Page>
