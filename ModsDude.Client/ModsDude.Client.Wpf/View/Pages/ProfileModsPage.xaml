<Page x:Class="ModsDude.Client.Wpf.View.Pages.ProfileModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:ProfileModsPageViewModel, IsDesignTimeCreatable=False}"
      Title="ProfileModsPage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <Grid RowDefinitions="auto auto auto *">

            <TextBlock Grid.Row="0"
                       Style="{DynamicResource TitleTextBlockStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding ProfileName}" />
            <TextBlock Grid.Row="1"
                       Style="{DynamicResource SubtitleTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                       Text="Mods"
                       Margin="0 8 0 24" />

            <TextBlock Grid.Row="2"
                       Margin="0 0 0 12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Text="What this profile pins, and what syncing it puts in your mod folder. Guests cannot change the list - ask an admin for a higher membership level to edit it." />

            <Border Grid.Row="3"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Grid>

                    <!-- The same row as the repo's mod list and the editor, rendered by the implicit
                         ModListItemViewModel template in App.xaml - so the name still opens the
                         details dialog and the icon still loads the same way. What this page adds
                         to the end of the row is what the editor puts there as controls and a
                         reader can only be told. -->
                    <ItemsControl ItemsSource="{Binding Mods}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True"
                                              Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PinnedModViewModel}">
                                <Grid ColumnDefinitions="* auto">

                                    <ContentPresenter Grid.Column="0" Content="{Binding Item}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0 0 12 0">

                                        <!-- The profile's own lock, where the editor has its toggle.
                                             The adapter's is a fact about the version and already
                                             has its own icon inside the row. -->
                                        <TextBlock Margin="0 0 4 0"
                                                   VerticalAlignment="Center"
                                                   Text="&#xE72E;"
                                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   ToolTip="{Binding LockNote}" ToolTipService.InitialShowDelay="200"
                                                   Visibility="{Binding IsLockedByProfile, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Reading what this profile pins…"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Text="This profile pins no mods yet.&#x0a;Syncing it would empty the mod folder."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLoading}" Value="False" />
                                            <Condition Binding="{Binding HasNoMods}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Page>
