<Page x:Class="ModsDude.Client.Wpf.View.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:GamePageViewModel, IsDesignTimeCreatable=False}"
      Title="GamePage">

    <Grid ColumnDefinitions="260 *">

        <Grid Grid.Column="0" RowDefinitions="auto auto *">

            <ListView Grid.Row="0"
                      Style="{StaticResource SidebarList}"
                      ItemsSource="{Binding Path=MenuItems}"
                      SelectedItem="{Binding Path=NavManager.Selected, Mode=TwoWay}" />

            <!-- The game's own state, on its own page: which profile it follows, whether the
                 folder still matches, and the one action that fixes it. -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="12 16 12 0">

                <TextBlock Text="Active profile"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Disabled while a savegame with a profile is checked out here. Every switch in the
                     app applies first, a held savegame refuses that apply, and a dropdown whose every
                     other entry leads to a refusal is worse than one that says so and does not open. -->
                <ComboBox Margin="0 4 0 0"
                          ItemsSource="{Binding Profiles}"
                          DisplayMemberPath="Label"
                          IsEnabled="{Binding CanChooseProfile}"
                          ToolTip="{Binding ProfileLock}"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />

                <TextBlock Margin="0 6 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ProfileLock}"
                           Visibility="{Binding HasProfileLock, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Text="The profile this game followed is gone - it was deleted, or you were removed from its repo. Pick another one."
                           Visibility="{Binding HasDanglingActiveProfile, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Reads 'Re-apply rev 4' while a past savegame is held: applying the profile's
                     latest is exactly what the apply table refuses there, and repairing folder drift
                     back to that revision is the whole of what this button still does. -->
                <Button Margin="0 8 0 0"
                        HorizontalAlignment="Stretch"
                        Style="{DynamicResource AccentButtonStyle}"
                        Content="{Binding ActivationLabel}"
                        Command="{Binding ApplyCommand}" />

                <!-- Neutral. Holding a past savegame is a state somebody chose and is playing in, not a
                     problem with the game. -->
                <TextBlock Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding HoldingStatus}"
                           Visibility="{Binding HasHoldingStatus, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Margin="0 12 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding DriftNote}" />

                <TextBlock Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Text="{Binding LockedWarning}"
                           Visibility="{Binding HasLockedWarning, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                           Text="{Binding ApplyStatus}"
                           Visibility="{Binding HasApplyStatus, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Margin="0 8 0 0"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource SubtleMenuButton}"
                        Content="Re-check"
                        Command="{Binding RecheckCommand}" />

                <TextBlock Margin="0 12 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding ModFolder}" />
            </StackPanel>
        </Grid>

        <Frame
            Grid.Column="1"
            Content="{Binding NavManager.CurrentPage}" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
