<Page x:Class="ModsDude.Client.Wpf.View.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:GamePageViewModel, IsDesignTimeCreatable=False}"
      Title="GamePage">

    <Grid ColumnDefinitions="260 *">

        <Grid Grid.Column="0" RowDefinitions="auto auto *">

            <ListView Grid.Row="0"
                      Style="{StaticResource SidebarList}"
                      ItemsSource="{Binding Path=MenuItems}"
                      SelectedItem="{Binding Path=NavManager.Selected, Mode=TwoWay}" />

            <!-- What this installation is, rather than what to do with it: which profile it follows,
                 what it is holding, and a line for each folder it reaches. Activating a profile is
                 on the profile's own page, which is the end of it where the choice belongs. -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="12 16 12 0">

                <TextBlock TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ActiveProfileNote}" />

                <!-- Neutral. Holding a past savegame is a state somebody chose and is playing in, not a
                     problem with the game. -->
                <TextBlock Margin="0 8 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding HoldingStatus}"
                           Visibility="{Binding HasHoldingStatus, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- One block per folder, because each of them matches its profile or does not on its
                     own. The heading is absent for a game with one folder, which is nearly all of
                     them. -->
                <ItemsControl Margin="0 12 0 0"
                              ItemsSource="{Binding Targets}"
                              Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type pvm:GameTargetRow}">
                            <StackPanel Orientation="Vertical" Margin="0 0 0 12">
                                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Name}"
                                           Visibility="{Binding HasName, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <TextBlock TextWrapping="Wrap"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding DriftNote}" />

                                <TextBlock Margin="0 4 0 0"
                                           TextWrapping="Wrap"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding LockedWarning}"
                                           Visibility="{Binding HasLockedWarning, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <TextBlock Margin="0 4 0 0"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{DynamicResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           ToolTip="{Binding Path}"
                                           Text="{Binding Path}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0 12 0 0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding NoTargetsNote}"
                           Visibility="{Binding HasNoTargetsNote, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Margin="0 4 0 0"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource SubtleMenuButton}"
                        Content="Re-check"
                        Command="{Binding RecheckCommand}" />
            </StackPanel>
        </Grid>

        <Frame
            Grid.Column="1"
            Content="{Binding NavManager.CurrentPage}" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
