<Page x:Class="ModsDude.Client.Wpf.View.Pages.RepoModsImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ModsDude.Client.Wpf.View.Pages"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance pvm:RepoModsImportPageViewModel, IsDesignTimeCreatable=False}"
      Title="RepoModsImportPage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <Grid RowDefinitions="auto auto auto *">

                <TextBlock Grid.Row="0"
                           Style="{DynamicResource TitleTextBlockStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding RepoName}" />
                <TextBlock Grid.Row="1"
                           Style="{DynamicResource SubtitleTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                           Text="Mods | Import"
                           Margin="0 8 0 24" />

                <Grid Grid.Row="2" Margin="0 0 0 12" ColumnDefinitions="280 auto auto * auto">

                    <Grid Grid.Column="0">
                        <!-- Right padding keeps the text from running under the clear button. The
                             rest matches the theme's own TextBox padding. -->
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 Padding="10 5 32 6"
                                 VerticalAlignment="Center" />

                        <!-- Watches the box rather than the view model: the binding above delays
                             pushing the text through, so anything driven off SearchText stays a
                             beat behind what has actually been typed. -->
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="Search by name, id or author"
                                   Margin="12 0 0 0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Watches the box for the same reason the placeholder does, so it turns
                             up on the keystroke rather than 150ms later. -->
                        <Button x:Name="ClearSearchButton"
                                Width="24" Height="24"
                                FontSize="12"
                                Margin="0 0 4 0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="&#xE10A;"
                                ToolTip="Clear search"
                                Command="{Binding ClearSearchCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubtleIconButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Button Grid.Column="1" Margin="12 0 0 0" Content="Select all" Command="{Binding SelectAllCommand}" />
                    <Button Grid.Column="2" Margin="8 0 0 0" Content="Select none" Command="{Binding SelectNoneCommand}" />

                    <TextBlock Grid.Column="4"
                               VerticalAlignment="Center"
                               Text="{Binding CountText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasMods, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <Border Grid.Row="3"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Grid>

                        <!-- One row per mod, rendered by the implicit ModListItemViewModel template
                             in App.xaml. Virtualized with recycling: a mod folder can easily hold a
                             few thousand archives. -->
                        <ItemsControl ItemsSource="{Binding ModsView}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True"
                                                  Focusable="False"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Scanning installed mods…"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Text" Value="None of the local instances has any mods installed." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasInstances}" Value="False">
                                            <Setter Property="Text" Value="This repo has no local instances yet.&#x0a;Add one to import the mods it has installed." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="No mods match the search."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasMods}" Value="True" />
                                                <Condition Binding="{Binding HasVisibleMods}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Grid>
                </Border>

            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" >
            <Button Grid.Column="0" Width="250" Margin="32 24 4 24" Style="{DynamicResource AccentButtonStyle}"
                    Content="{Binding ImportButtonText}" Command="{Binding ImportCommand}" />
        </StackPanel>

    </Grid>
</Page>
