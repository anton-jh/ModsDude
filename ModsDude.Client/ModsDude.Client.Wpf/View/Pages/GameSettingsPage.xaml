<Page x:Class="ModsDude.Client.Wpf.View.Pages.GameSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ModsDude.Client.Wpf.View.Pages"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance pvm:GameSettingsPageViewModel, IsDesignTimeCreatable=False}"
      Title="GameSettingsPage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <StackPanel Orientation="Vertical">

                <TextBlock Style="{DynamicResource TitleTextBlockStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding RepoName}" />
                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                           Text="{Binding GameName}"
                           Margin="0 8 0 36" />

                <!-- The settings are the whole of what a machine decides about a game: every folder
                     it reaches falls out of them, and its name comes from the adapter. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="Game adapter settings" Padding="0 16 0 16">
                        <uc:DynamicFormEditor DataContext="{Binding LocalSettingsEditor}" />
                    </GroupBox>
                </Border>

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" >
            <Button Grid.Column="0" Width="250" Margin="32 24 4 24" Style="{DynamicResource AccentButtonStyle}"
                    Content="Save changes" Command="{Binding Path=SaveChangesCommand}" />

            <Button Grid.Column="2" Width="250" Margin="4 24 32 24"
                    Content="Disconnect game" Command="{Binding Path=DeleteCommand}" />
        </StackPanel>

    </Grid>
</Page>
