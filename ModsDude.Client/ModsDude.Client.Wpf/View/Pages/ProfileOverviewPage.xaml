<Page x:Class="ModsDude.Client.Wpf.View.Pages.ProfileOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:ProfileOverviewPageViewModel, IsDesignTimeCreatable=False}"
      Title="ProfileOverviewPage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <uc:PageTitle Text="Overview" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="This profile" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding RepoName}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0 4 0 0"
                                       Text="{Binding ModSummary}" />
                        </StackPanel>
                    </GroupBox>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Where it is applied" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="Not applied." />

                            <ItemsControl ItemsSource="{Binding Games}"
                                          Visibility="{Binding HasGames, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameOverviewViewModel}">
                                        <StackPanel Orientation="Vertical" Margin="0 0 0 16">
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding Name}" />

                                            <!-- A line per folder, each with its own drift: a game
                                                 whose server folder drifted and whose client folder
                                                 did not has to say which. -->
                                            <ItemsControl ItemsSource="{Binding Folders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GameFolderLine}">
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Text}"
                                                                       Text="{Binding Text}" />
                                                            <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding Drift}"
                                                                       Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="No mod folder configured"
                                                       Visibility="{Binding HasNoFolders, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </GroupBox>
                </Border>

                <!-- Which savegame this profile is following. The savegames themselves stay on the one
                     repo-level list, so the past ones are a count and a link into that list rather
                     than a second list of rows to keep true. -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0"
                        Visibility="{Binding HasSavegames, Converter={StaticResource BoolToVisibilityConverter}}">
                    <GroupBox Header="Savegames" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="{Binding CurrentSavegame}" />

                            <!-- Archiving deliberately does not release a profile's slot, so this is a
                                 state somebody can be stuck in. The three ways out are named. -->
                            <TextBlock Margin="0 8 0 0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="{Binding ArchivedWarning}"
                                       Visibility="{Binding HasArchivedWarning, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- The Saves list's own flows for this profile's savegame. Publish is always
                                 here; Check in and Check out only where there is a current savegame, and
                                 greyed with the reason in the tooltip where this machine cannot do them. -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 12 0 0"
                                        Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="{Binding CheckOutLabel}"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        MinWidth="110"
                                        ToolTip="{Binding CheckOutToolTip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding CheckOutCommand}"
                                        Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Button Content="Check in"
                                        Margin="8 0 0 0"
                                        MinWidth="110"
                                        ToolTip="{Binding CheckInToolTip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding CheckInCommand}"
                                        Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Button Content="Publish a save"
                                        MinWidth="110"
                                        ToolTip="{Binding PublishToolTip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Command="{Binding PublishCommand}">
                                    <Button.Style>
                                        <!-- Beside the other two where they are there, and first where
                                             it is the only one. -->
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Margin" Value="8 0 0 0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCurrent}" Value="False">
                                                    <Setter Property="Margin" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <Button Margin="0 8 0 0"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource SubtleMenuButton}"
                                    Content="{Binding PastSavegamesText}"
                                    ToolTip="Opens the repo's saves list with past savegames showing."
                                    Command="{Binding ShowPastSavegamesCommand}"
                                    Visibility="{Binding HasPastSavegames, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </GroupBox>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
