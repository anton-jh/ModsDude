<Page x:Class="ModsDude.Client.Wpf.View.Pages.ProfileOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:ProfileOverviewPageViewModel, IsDesignTimeCreatable=False}"
      Title="ProfileOverviewPage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <TextBlock Style="{DynamicResource TitleTextBlockStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding ProfileName}" />
                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                           Text="Overview"
                           Margin="0 8 0 36" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16">
                    <GroupBox Header="This profile" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding RepoName}" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0 4 0 0"
                                       Text="{Binding ModSummary}" />
                        </StackPanel>
                    </GroupBox>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Where it is applied" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Visibility="{Binding HasNoInstances, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="No game instance on this machine is set to this profile. Pick it on an instance to make that instance's mod folder match this profile." />

                            <ItemsControl ItemsSource="{Binding Instances}"
                                          Visibility="{Binding HasInstances, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InstanceOverviewViewModel}">
                                        <StackPanel Orientation="Vertical" Margin="0 0 0 16">
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ModFolder}"
                                                       Text="{Binding ModFolder}" />
                                            <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding DriftSummary}"
                                                       Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </GroupBox>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0">
                    <GroupBox Header="Sync" Padding="0 16 0 16">
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                   Text="Applying this profile happens on an instance's own Sync page, which shows what would change before anything does. How far each instance above has drifted, and when it last synced, will be summarised here." />
                    </GroupBox>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
