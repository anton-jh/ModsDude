<Page x:Class="ModsDude.Client.Wpf.View.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance pvm:SettingsPageViewModel, IsDesignTimeCreatable=False}"
      Title="SettingsPage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">

                    <uc:PageTitle Text="Settings" />

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="16">
                        <GroupBox Header="Mod storage" Padding="0 16 0 16">
                            <StackPanel Orientation="Vertical">

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Text="Downloaded mods are kept in a content store shared by every repo and game on this machine. Each disk holding mod folders is served by one store - its own, or one on another disk." />

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Margin="0 16 0 0"
                                           Visibility="{Binding HasNoVolumes, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="Connect a game first - stores are configured for the disks your mod folders are on." />

                                <ItemsControl ItemsSource="{Binding ModFolderVolumes}" Margin="0 8 0 0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VolumeAssignmentViewModel}">
                                            <StackPanel Orientation="Vertical" Margin="0 16 0 0">
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Text="{Binding VolumeRoot}" />
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding ModFolderSummary}" />

                                                <ComboBox Width="420" HorizontalAlignment="Left" Margin="0 12 0 0"
                                                          ItemsSource="{Binding Options}"
                                                          DisplayMemberPath="Description"
                                                          SelectedValuePath="VolumeRoot"
                                                          SelectedValue="{Binding ServingVolume, Mode=TwoWay}" />

                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                                           Margin="0 8 0 0"
                                                           Text="{Binding TradeOff}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </GroupBox>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0 16 0 0"
                            Visibility="{Binding HasStores, Converter={StaticResource BoolToVisibilityConverter}}">
                        <GroupBox Header="Stores" Padding="0 16 0 16">
                            <StackPanel Orientation="Vertical">

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Margin="0 0 0 8"
                                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="{Binding ManagementBlockedReason}" />

                                <ItemsControl ItemsSource="{Binding Stores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContentStoreViewModel}">
                                            <StackPanel Orientation="Vertical" Margin="0 0 0 16">
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Text="{Binding VolumeRoot}" />
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding ServedSummary}" />
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding UsageSummary}" />

                                                <!-- What could be freed, said against the button that
                                                     frees it. The size line above used to end with
                                                     "7.6 GB of it reclaimable", which named a number
                                                     with no route to it - and the nearest button was
                                                     the one that would not free that number. -->
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                                           Text="{Binding ReclaimSummary}"
                                                           Visibility="{Binding HasReclaimSummary, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <Label Content="Folder" Margin="0 12 0 8" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Pick folder" Command="{Binding PickPathCommand}" />
                                                    <TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="8 0 0 0" />
                                                </StackPanel>

                                                <Label Margin="0 12 0 8">
                                                    Maximum size (GB). Must not be smaller than the largest profile you want to apply, if using hardlinks.
                                                </Label>
                                                <TextBox Width="120" HorizontalAlignment="Left"
                                                         Text="{Binding MaxSizeGigabytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                                                <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                                                    <!-- Two buttons, not three. "Sweep to limit" used
                                                         to sit here, which asked the user to keep a
                                                         promise the app makes - and was only ever
                                                         pressed by the ones who noticed it. Staying
                                                         inside the limit is automatic now. -->
                                                    <Button Content="Verify integrity"
                                                            Command="{Binding DataContext.VerifyStoreCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                    <!-- The amount is on the button, because the
                                                         question it answers is "how do I get that
                                                         space back?" -->
                                                    <Button Content="{Binding ReclaimLabel}" Margin="8 0 0 0"
                                                            Command="{Binding DataContext.ReclaimStoreCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>

                                                <!-- The check used to draw its own progress line and
                                                     its own Stop here. Both are the shell strip's
                                                     now: it is where every other long job in the app
                                                     reports, it has a Cancel of its own, and a pass
                                                     that runs for minutes should not lose its
                                                     progress the moment somebody navigates away. -->

                                                <StackPanel Orientation="Vertical" Margin="0 12 0 0"
                                                            Visibility="{Binding HasQuarantine, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                                               Text="{Binding QuarantineSummary}" />
                                                    <Button Content="Delete rescued files" HorizontalAlignment="Left" Margin="0 8 0 0"
                                                            Command="{Binding DataContext.EmptyQuarantineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </GroupBox>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0 16 0 0">
                        <GroupBox Header="Image cache" Padding="0 16 0 16">
                            <StackPanel Orientation="Vertical">

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0 8 0 0"
                                           Text="{Binding ImageCache.UsageSummary}" />

                                <Label Content="Folder" Margin="0 12 0 8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Pick folder" Command="{Binding ImageCache.PickPathCommand}" />
                                    <TextBox Text="{Binding ImageCache.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="8 0 0 0" />
                                </StackPanel>

                                <Label Content="Maximum size (GB)" Margin="0 12 0 8" />
                                <TextBox Width="120" HorizontalAlignment="Left"
                                         Text="{Binding ImageCache.MaxSizeGigabytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Content="Empty cache" HorizontalAlignment="Left" Margin="0 12 0 0"
                                        Command="{Binding EmptyImageCacheCommand}" />

                            </StackPanel>
                        </GroupBox>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0 16 0 0">
                        <GroupBox Header="Network" Padding="0 16 0 16">
                            <StackPanel Orientation="Vertical">

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Text="Caps on how fast mods and savegames move to and from storage, shared by everything transferring at once. Leave a box empty for no limit. A change applies to transfers already running as soon as it is saved." />

                                <Label Content="Download limit (Mbit/s)" Margin="0 12 0 8" />
                                <TextBox Width="120" HorizontalAlignment="Left"
                                         Text="{Binding DownloadLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Label Content="Upload limit (Mbit/s)" Margin="0 12 0 8" />
                                <TextBox Width="120" HorizontalAlignment="Left"
                                         Text="{Binding UploadLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            </StackPanel>
                        </GroupBox>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0 16 0 0">
                        <GroupBox Header="Background" Padding="0 16 0 16">
                            <StackPanel Orientation="Vertical">

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Text="ModsDude can keep running in the notification area when its window is closed, so it can go on watching your mod folders while you play. Quit it from the tray icon's menu." />

                                <CheckBox Margin="0 12 0 0"
                                          Content="Closing the window keeps ModsDude running in the tray"
                                          IsChecked="{Binding CloseToTray, Mode=TwoWay}" />

                                <CheckBox Margin="0 12 0 0"
                                          Content="Show Windows notifications when ModsDude is not in front"
                                          IsChecked="{Binding Notifications, Mode=TwoWay}" />

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Margin="28 4 0 0"
                                           Text="For drift and savegames that need attention, and for what a finished action would otherwise tell a window nobody is looking at. Clicking one opens ModsDude." />

                                <CheckBox Margin="0 12 0 0"
                                          Content="Start ModsDude when I sign in to Windows"
                                          IsEnabled="{Binding IsAutostartAvailable}"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Margin="28 4 0 0"
                                           Text="{Binding AutostartNote}" />

                            </StackPanel>
                        </GroupBox>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Width="250" Margin="32 24" Style="{DynamicResource AccentButtonStyle}"
                    Content="Save changes" Command="{Binding Path=SaveChangesCommand}" />
        </StackPanel>

    </Grid>
</Page>
