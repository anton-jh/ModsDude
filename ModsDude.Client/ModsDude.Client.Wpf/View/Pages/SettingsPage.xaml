<Page x:Class="ModsDude.Client.Wpf.View.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance pvm:SettingsPageViewModel, IsDesignTimeCreatable=False}"
      Title="SettingsPage">

    <Grid RowDefinitions="*, auto">

        <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">

                    <TextBlock Style="{DynamicResource TitleTextBlockStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="ModsDude" />
                    <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                               Text="Settings"
                               Margin="0 8 0 36" />

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="16">
                        <GroupBox Header="Mod storage" Padding="0 16 0 16">
                            <StackPanel Orientation="Vertical">

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Text="Downloaded mods are kept in a content store shared by every repo and game on this machine. Each disk holding mod folders is served by one store - its own, or one on another disk." />

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Margin="0 16 0 0"
                                           Visibility="{Binding HasNoVolumes, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="Connect a game first - stores are configured for the disks your mod folders are on." />

                                <ItemsControl ItemsSource="{Binding ModFolderVolumes}" Margin="0 8 0 0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VolumeAssignmentViewModel}">
                                            <StackPanel Orientation="Vertical" Margin="0 16 0 0">
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Text="{Binding VolumeRoot}" />
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding InstanceSummary}" />

                                                <ComboBox Width="420" HorizontalAlignment="Left" Margin="0 12 0 0"
                                                          ItemsSource="{Binding Options}"
                                                          DisplayMemberPath="Description"
                                                          SelectedValuePath="VolumeRoot"
                                                          SelectedValue="{Binding ServingVolume, Mode=TwoWay}" />

                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                                           Margin="0 8 0 0"
                                                           Text="{Binding TradeOff}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </GroupBox>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0 16 0 0"
                            Visibility="{Binding HasStores, Converter={StaticResource BoolToVisibilityConverter}}">
                        <GroupBox Header="Stores" Padding="0 16 0 16">
                            <StackPanel Orientation="Vertical">

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Margin="0 0 0 8"
                                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="{Binding ManagementBlockedReason}" />

                                <ItemsControl ItemsSource="{Binding Stores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ContentStoreViewModel}">
                                            <StackPanel Orientation="Vertical" Margin="0 0 0 16">
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Text="{Binding VolumeRoot}" />
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding ServedSummary}" />
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding UsageSummary}" />

                                                <Label Content="Folder" Margin="0 12 0 8" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Pick folder" Command="{Binding PickPathCommand}" />
                                                    <TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="8 0 0 0" />
                                                </StackPanel>

                                                <Label Content="Maximum size (GB)" Margin="0 12 0 8" />
                                                <TextBox Width="120" HorizontalAlignment="Left"
                                                         Text="{Binding MaxSizeGigabytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                                                    <Button Content="Sweep to limit"
                                                            Command="{Binding DataContext.SweepStoreCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Empty store" Margin="8 0 0 0"
                                                            Command="{Binding DataContext.EmptyStoreCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>

                                                <StackPanel Orientation="Vertical" Margin="0 12 0 0"
                                                            Visibility="{Binding HasQuarantine, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                                               Text="{Binding QuarantineSummary}" />
                                                    <Button Content="Delete rescued files" HorizontalAlignment="Left" Margin="0 8 0 0"
                                                            Command="{Binding DataContext.EmptyQuarantineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </GroupBox>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0 16 0 0">
                        <GroupBox Header="Mod images" Padding="0 16 0 16">
                            <StackPanel Orientation="Vertical">

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                           Text="Mod icons and store images are kept in one cache for the whole machine, shared by every repo and disk. Everything in it can be fetched again, so it is emptied oldest-first once it reaches its limit." />

                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0 8 0 0"
                                           Text="{Binding ImageCache.UsageSummary}" />

                                <Label Content="Folder" Margin="0 12 0 8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Pick folder" Command="{Binding ImageCache.PickPathCommand}" />
                                    <TextBox Text="{Binding ImageCache.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="8 0 0 0" />
                                </StackPanel>

                                <Label Content="Maximum size (GB)" Margin="0 12 0 8" />
                                <TextBox Width="120" HorizontalAlignment="Left"
                                         Text="{Binding ImageCache.MaxSizeGigabytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Content="Empty cache" HorizontalAlignment="Left" Margin="0 12 0 0"
                                        Command="{Binding EmptyImageCacheCommand}" />

                            </StackPanel>
                        </GroupBox>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Width="250" Margin="32 24" Style="{DynamicResource AccentButtonStyle}"
                    Content="Save changes" Command="{Binding Path=SaveChangesCommand}" />
        </StackPanel>

    </Grid>
</Page>
