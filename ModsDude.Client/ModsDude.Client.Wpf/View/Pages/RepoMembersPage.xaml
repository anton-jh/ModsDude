<Page x:Class="ModsDude.Client.Wpf.View.Pages.RepoMembersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pvm="clr-namespace:ModsDude.Client.Wpf.ViewModel.Pages"
      xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=pvm:RepoMembersPageViewModel, IsDesignTimeCreatable=False}"
      Title="RepoMembersPage"
      FontSize="14">

    <Border CornerRadius="4 0 0 4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <TextBlock Style="{DynamicResource TitleTextBlockStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding RepoName}" />
                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                           Text="Members"
                           Margin="0 8 0 36" />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Visibility="{Binding CanInvite, Converter={StaticResource BoolToVisibilityConverter}}">
                    <GroupBox Header="Add a member" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="Look somebody up by the exact username they signed up with." />

                            <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                                <TextBox Width="300"
                                         Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Search" Margin="8 0 0 0" Command="{Binding SearchCommand}" />
                            </StackPanel>

                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                       Margin="0 12 0 0"
                                       Visibility="{Binding HasSearchMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Text="{Binding SearchMessage}" />

                            <StackPanel Orientation="Horizontal" Margin="0 12 0 0"
                                        Visibility="{Binding CanAddMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                           Text="{Binding AddableUser.Username}" />
                                <ComboBox Width="140" Margin="16 0 0 0"
                                          ItemsSource="{Binding GrantableLevels}"
                                          SelectedItem="{Binding NewMemberLevel, Mode=TwoWay}" />
                                <Button Content="Add" Margin="8 0 0 0" Style="{DynamicResource AccentButtonStyle}"
                                        Command="{Binding AddMemberCommand}" />
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>
                </Border>

                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                           Visibility="{Binding IsHiddenFromMe, Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="Guests cannot see who else is in a repo. Ask an admin for a higher membership level." />

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0 16 0 0"
                        Visibility="{Binding CanSeeMembers, Converter={StaticResource BoolToVisibilityConverter}}">
                    <GroupBox Header="Members" Padding="0 16 0 16">
                        <StackPanel Orientation="Vertical">

                            <ItemsControl ItemsSource="{Binding Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RepoMemberViewModel}">
                                        <StackPanel Orientation="Vertical" Margin="0 0 0 16">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Width="240"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Username}" />

                                                <ComboBox Width="140"
                                                          ItemsSource="{Binding AvailableLevels}"
                                                          SelectedItem="{Binding Level, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanChangeLevel}" />

                                                <Button Content="Remove" Margin="8 0 0 0"
                                                        Command="{Binding RequestKickCommand}" />
                                            </StackPanel>

                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0 4 0 0"
                                                       Visibility="{Binding HasRestriction, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Text="{Binding Restriction}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Refresh" HorizontalAlignment="Left" Margin="0 8 0 0"
                                    Command="{Binding RefreshCommand}" />

                        </StackPanel>
                    </GroupBox>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Page>
