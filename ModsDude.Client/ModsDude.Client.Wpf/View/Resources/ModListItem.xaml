<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:ModsDude.Client.Wpf.View.Behaviors"
                    xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels">

    <!-- Merged here as well as in App.xaml so the StaticResource lookups below resolve against
         this dictionary's own chain rather than depending on merge order up in App.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The one place a mod is styled for a list. Being an implicit template, any items control
         bound to ModListItemViewModels gets the same row without having to ask for it. -->
    <DataTemplate DataType="{x:Type vm:ModListItemViewModel}">

        <!-- b:LazyLoad.Source is what pulls the icon out of the mod archive, and only once the row
             is actually realized by the virtualizing panel. It re-fires when a recycled row is
             handed a different mod. -->
        <Border b:LazyLoad.Source="{Binding}"
                Height="72"
                BorderThickness="0 0 0 1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid ColumnDefinitions="auto auto * auto auto">

                <CheckBox Grid.Column="0"
                          Margin="12 0 0 0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Border Grid.Column="1"
                        Width="56" Height="56"
                        Margin="4 0 0 0"
                        CornerRadius="4"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <Grid>
                        <!-- Shows through until the icon has decoded, and stays for mods without one. -->
                        <TextBlock Text="{Binding Initials}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Style="{DynamicResource BodyStrongTextBlockStyle}" />

                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <!-- The name gets the star column so it ellipsizes instead of shoving the version
                     off the row. That parks the version chip against the right edge of the text
                     area, where it lines up into a column of its own down the list. -->
                <Grid Grid.Column="2" Margin="16 0 12 0" VerticalAlignment="Center"
                      RowDefinitions="auto auto" ColumnDefinitions="* auto">

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Style="{DynamicResource BodyStrongTextBlockStyle}"
                               ToolTip="{Binding Name}"
                               ToolTipService.InitialShowDelay="400" />

                    <!-- Right aligned so the chip hugs the version instead of stretching to
                         whatever width the instances below it need. -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Margin="8 0 0 0"
                            Padding="6 1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            CornerRadius="3"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding Version}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Style="{DynamicResource CaptionTextBlockStyle}" />
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="0 2 0 0"
                               Text="{Binding ShortDescription}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- Sits under the version chip, so the instances line up into a column of
                         their own down the list. Hidden when the repo only has one to name. -->
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Margin="8 2 0 0"
                               MaxWidth="220"
                               Text="{Binding Instances}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               TextAlignment="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Visibility="{Binding HasInstances, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>

                <Border Grid.Column="3"
                        Margin="0 0 8 0"
                        Padding="8 2"
                        VerticalAlignment="Center"
                        CornerRadius="3"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="New">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Style="{DynamicResource CaptionTextBlockStyle}" />
                </Border>

                <Button Grid.Column="4"
                        Margin="0 0 12 0"
                        VerticalAlignment="Center"
                        Style="{DynamicResource SubtleIconButton}"
                        Content="&#xE712;"
                        ToolTip="Details"
                        Command="{Binding ShowDetailsCommand}" />

            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
