<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:ModsDude.Client.Wpf.View.Behaviors"
                    xmlns:vm="clr-namespace:ModsDude.Client.Wpf.ViewModel.ViewModels">

    <!-- Merged here as well as in App.xaml so the StaticResource lookups below resolve against
         this dictionary's own chain rather than depending on merge order up in App.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The one place a mod is styled for a list. Being an implicit template, any items control
         bound to ModListItemViewModels gets the same row without having to ask for it. -->
    <DataTemplate DataType="{x:Type vm:ModListItemViewModel}">

        <!-- b:LazyLoad.Source is what pulls the icon out of the mod archive, and only once the row
             is actually realized by the virtualizing panel. It re-fires when a recycled row is
             handed a different mod. -->
        <Border b:LazyLoad.Source="{Binding}"
                Height="72"
                BorderThickness="0 0 0 1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>

                <Grid ColumnDefinitions="auto auto * auto auto auto auto auto">

                    <CheckBox Grid.Column="0"
                              Margin="12 0 0 0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsPickable}"
                              Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Border Grid.Column="1"
                            Width="56" Height="56"
                            Margin="4 0 0 0"
                            CornerRadius="4"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <!-- Shows through until the icon has decoded, and stays for mods without one. -->
                            <TextBlock Text="{Binding Initials}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}" />

                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- The name gets the star column so it ellipsizes instead of shoving the version
                         off the row. That parks the version chip against the right edge of the text
                         area, where it lines up into a column of its own down the list. -->
                    <Grid Grid.Column="2" Margin="16 0 12 0" VerticalAlignment="Center"
                          RowDefinitions="auto auto" ColumnDefinitions="* auto">

                        <!-- The name is the way into the details, so the row needs no button of its
                             own for them. The trimming lives on the TextBlock and the click on the
                             link inside it, which is why the tooltip is still the full name. -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource BodyStrongTextBlockStyle}"
                                   ToolTip="{Binding Name}"
                                   ToolTipService.InitialShowDelay="400">
                            <Hyperlink Style="{StaticResource TextLink}"
                                       Command="{Binding ShowDetailsCommand}">
                                <Run Text="{Binding Name, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>

                        <!-- Right aligned so the chip hugs the version instead of stretching to
                             whatever width the sources below it need. The size, where a page shows
                             one, sits before it: it is a fact about the file this version is, and the
                             chip stays the last thing on the line so the chips still make a column. -->
                        <StackPanel Grid.Row="0" Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="8 0 0 0"
                                       VerticalAlignment="Center"
                                       Text="{Binding SizeText}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       ToolTip="The size of the file in the repo"
                                       Visibility="{Binding HasSize, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <Border Margin="8 0 0 0"
                                    Padding="6 1"
                                    VerticalAlignment="Center"
                                    CornerRadius="3"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding ShowsVersionChip, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Version}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Style="{DynamicResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>

                        <!-- The mod's description, whatever the import is doing. What went wrong with
                             an import is a chip and an icon on the row and a dialog behind that: an
                             exception message rendered here is a line of clipped text nobody reads. -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Margin="0 2 0 0"
                                   Text="{Binding ShortDescription}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />

                        <!-- Sits under the version chip, so the sources line up into a column of
                             their own down the list. Hidden when only one source is enabled, where
                             naming it on every row says nothing. -->
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Margin="8 2 0 0"
                                   MaxWidth="220"
                                   Text="{Binding Sources}"
                                   ToolTip="{Binding Sources}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   TextAlignment="Right"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Where the sources go on the lists that have them. The repo's own list has
                             no sources to name and this is what it has instead, so the two never
                             share a row. -->
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Margin="8 2 0 0"
                                   MaxWidth="260"
                                   Text="{Binding UsageText}"
                                   ToolTip="{Binding UsageTooltip}"
                                   ToolTipService.InitialShowDelay="400"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   TextAlignment="Right"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <!-- The adapter's determination, not a setting: it is re-derived from every
                         archive, so there is nothing here to toggle. -->
                    <TextBlock Grid.Column="3"
                               Margin="0 0 8 0"
                               VerticalAlignment="Center"
                               Text="&#xE72E;"
                               FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="Version-sensitive. Batch updates leave this mod alone."
                               Visibility="{Binding ShowsAdapterLockIcon, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Shares one slot between two facts that both mean "this row will ask you
                         something at save": a source conflict, and a version the ordering could not
                         place against what the repo holds. A conflict is the more urgent of the two
                         and wins the slot when a version is somehow both. -->
                    <Border Grid.Column="4"
                            Margin="0 0 8 0"
                            ToolTip="{Binding SecondaryChipTooltip}"
                            Visibility="{Binding HasSecondaryChip, Converter={StaticResource BoolToVisibilityConverter}}">

                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusChip}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSourceConflict}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding SecondaryChipText}"
                                   Style="{DynamicResource CaptionTextBlockStyle}" />
                    </Border>

                    <!-- What the editor's draft has done to this mod. Filled, where every status
                         beside it is an outline: this is the one chip on the row that is somebody's
                         own doing. On the status chip's line rather than the name's, so the two
                         read as one row of chips. The words behind it are the tooltip. -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- A newer version somewhere else, and the way to it. First in the row of chips
                         because it is the only one that asks for something to be done outside the
                         app; see RemoteOfferViewModel. -->
                    <Button Margin="0 0 8 0"
                            Style="{StaticResource RemoteOfferChip}"
                            Command="{Binding RemoteOffer.Open}"
                            ToolTip="{Binding RemoteOffer.Tooltip}"
                            Visibility="{Binding HasRemoteOffer, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RemoteOffer.Text}"
                                       Style="{DynamicResource CaptionTextBlockStyle}" />
                            <TextBlock Margin="4 0 0 0"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Text="&#xE8A7;"
                                       FontFamily="{DynamicResource SymbolThemeFontFamily}" />
                        </StackPanel>
                    </Button>

                    <TextBlock Margin="0 0 8 0"
                               VerticalAlignment="Center"
                               Text="{Binding Detail}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Border Margin="0 0 8 0"
                            ToolTip="{Binding TouchTooltip}"
                            ToolTipService.InitialShowDelay="300"
                            Visibility="{Binding HasTouch, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusChip}">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Touch}" Value="Added">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                                    </DataTrigger>
                                    <!-- Caution: this is a row about to lose something, and it
                                         matches the count in the list's own header. -->
                                    <DataTrigger Binding="{Binding Touch}" Value="TakenOut">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding TouchText}"
                                   Style="{DynamicResource CaptionTextBlockStyle}" />
                    </Border>

                    </StackPanel>

                    <!-- One chip, showing the import while it is happening and the presence status
                         otherwise. A running import is the more urgent of the two, and stacking them
                         would make every row two chips wide for the sake of one moment. -->
                    <Border Grid.Column="6"
                            Margin="0 0 8 0"
                            ToolTip="{Binding ImportProblemTooltip}"
                            ToolTipService.InitialShowDelay="400">

                        <Border.Style>
                            <!-- Every fill here comes with the text colour that can be read on it;
                                 see StatusChip in Controls.xaml for why they cannot be set apart. -->
                            <Style TargetType="Border" BasedOn="{StaticResource StatusChip}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="New">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                                    </DataTrigger>
                                    <!-- Green for the two that are only on disk, because what they
                                         have in common is that saving uploads a file - and the
                                         accent for the one that costs nothing. The fill says what
                                         the version means for the repo; the word says what it means
                                         for the profile. -->
                                    <DataTrigger Binding="{Binding Status}" Value="NewVersion">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="UpdatePending">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                    <!-- Where a draft exists to tell apart from, every fill above steps
                                         back to an outline: a filled chip there means "you did this"
                                         (see the touch chip), and a status is only a fact about the
                                         version. A running import is not a fact, so it keeps its fill,
                                         and the triggers below it win. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding OutlineStatus}" Value="True" />
                                            <Condition Binding="{Binding HasImportState}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Padding" Value="7 1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding HasImportState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ImportState}" Value="Running">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ImportState}" Value="Succeeded">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                                    </DataTrigger>
                                    <!-- Skipped and failed are deliberately different colours: one is
                                         waiting on a decision, the other went wrong. -->
                                    <DataTrigger Binding="{Binding ImportState}" Value="Skipped">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ImportState}" Value="Failed">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!-- The choice between the two is made in the view model rather than by a
                             trigger, so the chip can keep the theme's caption style. -->
                        <TextBlock Text="{Binding ChipText}"
                                   Style="{DynamicResource CaptionTextBlockStyle}" />
                    </Border>

                    <!-- Margin on the panel rather than on the grid inside it, so the row keeps its
                         trailing gap for a member who has no actions to be offered. -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0 0 12 0">

                        <Grid Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibilityConverter}}">

                            <ToggleButton x:Name="RowActionsButton"
                                          Style="{DynamicResource SubtleIconToggleButton}"
                                          Content="&#xE10C;"
                                          ToolTip="Manage this mod" />

                            <!-- Declared inline so it inherits the row's data context; a context menu
                                 would not, and every action here needs the row it was opened on. -->
                            <Popup IsOpen="{Binding IsChecked, ElementName=RowActionsButton, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=RowActionsButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   HorizontalOffset="-160">

                                <Border CornerRadius="{DynamicResource OverlayCornerRadius}"
                                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Padding="4">
                                    <StackPanel Width="200">
                                        <Button Content="Reorder versions…"
                                                HorizontalContentAlignment="Left"
                                                Style="{DynamicResource SubtleMenuButton}"
                                                ToolTip="{Binding Actions.Restriction}" ToolTipService.ShowOnDisabled="True"
                                                Command="{Binding Actions.ReorderVersions}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Delete this version"
                                                HorizontalContentAlignment="Left"
                                                Style="{DynamicResource SubtleMenuButton}"
                                                ToolTip="{Binding Actions.Restriction}" ToolTipService.ShowOnDisabled="True"
                                                Command="{Binding Actions.DeleteVersion}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Delete the whole mod"
                                                HorizontalContentAlignment="Left"
                                                Style="{DynamicResource SubtleMenuButton}"
                                                ToolTip="{Binding Actions.Restriction}" ToolTipService.ShowOnDisabled="True"
                                                Command="{Binding Actions.DeleteMod}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Down the leading edge where the draft has touched this mod, in the touch chip's
                     colour: a column of them reads at a glance down a list a chip would have to be
                     read one row at a time. Set in from the edge, which is where the editor draws
                     the mark for a picked row. -->
                <Rectangle Width="3"
                           Margin="5 8 0 8"
                           HorizontalAlignment="Left"
                           RadiusX="1.5" RadiusY="1.5"
                           IsHitTestVisible="False"
                           Visibility="{Binding HasTouch, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Touch}" Value="Added">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Touch}" Value="TakenOut">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- Along the bottom edge rather than in the row, so a list mid-import reads as a
                     column of bars rather than as a column of numbers nobody can scan. -->
                <ProgressBar Height="3"
                             VerticalAlignment="Bottom"
                             Minimum="0" Maximum="1"
                             Value="{Binding ImportProgress, Mode=OneWay}"
                             Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
