<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uc="clr-namespace:ModsDude.Client.Wpf.View.UserControls">

    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- Text that reads as a TextBlock and selects like a TextBox. WPF's TextBlock has no selection
         of its own, so anything a user might want to take away - an error message, an exception - has
         to be a read-only TextBox wearing no chrome. IsReadOnlyCaretVisible is off so it does not
         blink an insertion point at somebody who is only reading, and the padding is zeroed because
         a TextBox brings its own and would otherwise sit a few pixels off from the labels around it. -->
    <Style x:Key="SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="IBeam" />
    </Style>

    <!-- A borderless icon button, for the kind of secondary action that would be visual noise with
         full button chrome on every row of a long list. -->
    <Style x:Key="SubtleIconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same chrome for a button that stays down while the thing it opened is open. -->
    <Style x:Key="SubtleIconToggleButton" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Background"
                            Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width row in a popup. Buttons rather than MenuItems so the popup can be an ordinary
         panel and inherit the data context of the row that opened it. -->
    <Style x:Key="SubtleMenuButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10 7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A name that is also the way into whatever the row is about. It reads as ordinary text until
         the pointer is on it, so a list of them does not turn into a wall of links. A hyperlink
         rather than a click handler on the text: the hit area is then the glyphs themselves rather
         than the whole column they sit in, and it takes focus and the keyboard like any control. -->
    <Style x:Key="TextLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The pill a row wears to say what state it is in.
         Background and foreground have to move together, because the theme's status fills are
         bright: SystemFillColorCaution is #FCE100, and the primary text colour on it is white on
         yellow - a chip whose text cannot be read at all. The pairs this app uses are
           neutral    ControlFillColorSecondary  + TextFillColorPrimary   (the default, below)
           success    SystemFillColorSuccess     + TextFillColorInverse
           caution    SystemFillColorCaution     + TextFillColorInverse
           critical   SystemFillColorCritical    + TextFillColorInverse
           attention  AccentFillColorDefault     + TextOnAccentFillColorPrimary
         Attention is the accent rather than SystemFillColorAttention deliberately: that one is
         derived from whatever accent colour Windows is set to, so its brightness is unknowable and
         no fixed text colour is safe on it, while the theme guarantees TextOnAccent against
         AccentFillColorDefault - which is the pairing FilterChip below already relies on.
         The foreground is set on the border and inherited, so a trigger that changes the fill can
         change the text with it; none of the theme's TextBlock styles set a foreground of their
         own, so nothing downstream overrides it. -->
    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="Padding" Value="8 2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- A presence filter chip. Radio buttons so the group enforces one active filter without any
         view model bookkeeping; the chrome is the button's, not the radio's. -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0 0 6 0" />
        <Setter Property="Padding" Value="12 5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Background"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Background" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A source chip. The same shape as the FilterChip above and deliberately never in the same row
         as one: these are independent toggles and those are mutually exclusive, so one row of both
         would read as one control with two kinds of behaviour in it. Above the filters where a page
         has both, because a source decides what a list is *of* and a filter narrows what it shows.
         Failure colours the chip rather than adding a second line - a line under one chip costs
         every chip in the row the height of the worst of them - and the reason is the tooltip,
         along with the path.
         Bound against ModSourceViewModel, which is what both the profile editor and the repo's mod
         page put behind these. See docs/09-mod-catalog.md#the-source-chips. -->
    <Style x:Key="SourceChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0 0 6 0" />
        <Setter Property="Padding" Value="10 4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Background"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <!-- After the checked trigger, so a source that is switched on and
                             unreadable reads as unreadable. -->
                        <DataTrigger Binding="{Binding HasFailed}" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter TargetName="Background" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Background" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The "add a source" chips and the rescan, which are actions rather than toggles and so keep
         the neutral chrome whatever is switched on. -->
    <Style x:Key="SourceActionChip" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0 0 6 0" />
        <Setter Property="Padding" Value="10 4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Background" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- A newer version somewhere else - ModHub - on a mod's own row. The status chip's shape, since it
         sits in the same row of chips, but outlined in the accent and clickable: it is the one chip
         that goes somewhere, and it goes out of the app. Bound against RemoteOfferViewModel. -->
    <Style x:Key="RemoteOfferChip" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8 2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- The row of a list somebody is choosing from - a slot, in the dialogs that pick one - drawn the way
         the mod lists and the savegame log draw theirs: a full-width row with a hairline under it, the
         accent at low opacity and a bar down the left for the chosen one, and a lighter fill under the
         pointer. The default ListBoxItem is a padded box with the theme's own highlight, which is what
         made these read as a settings control rather than as a list of things. -->
    <Style x:Key="SlotRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row"
                            BorderThickness="0 0 0 1"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Background="Transparent">
                        <Grid>
                            <Border x:Name="Fill"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Opacity="0" />

                            <Rectangle x:Name="Bar"
                                       Width="3"
                                       Margin="0 6"
                                       RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}" />

                            <ContentPresenter />

                            <Border x:Name="Focus"
                                    BorderThickness="0"
                                    BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.16" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A list to choose one thing from, in a dialog. Scrolls by the pixel rather than by the row:
         a slot is two or three lines tall, so scrolling by the item moved the list a third of its
         height with every notch of the wheel and made it jump rather than glide. That costs
         virtualization, which is the right trade for a list of a couple of dozen. -->
    <Style x:Key="SlotList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SlotRow}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>


    <!-- What every sidebar is drawn on, open, collapsed or peeked: the card tint over the window's base
         colour, worked out once. Opaque because the peek lies over the page's content, and the same brush
         for the others so that the three cannot come out as different shades. The app is dark only; if it
         ever has a light theme this needs a value for it. -->
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#2B2B2B" />

    <!-- A sidebar and the page beside it; see SidebarShell. The docked sidebar takes the first column at
         whatever width the control sets; the peek is a second copy at full width drawn over both
         columns, above everything in this shell's page, and is only visible while the control says it
         is peeking. It has its own opaque surface because it lies over the page's content. It opens by
         growing out of the rail's own edge (the width is animated in SidebarShell), short on purpose: it
         is there to say where the panel came from, not to be watched. -->
    <Style x:Key="SidebarShellStyle" TargetType="uc:SidebarShell">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="uc:SidebarShell">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- A sidebar is a strip of its own rather than part of the page: a tint behind it and a
                             rule down its edge, so that two side by side read as two, and neither as the start
                             of the page beside it. -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource SidebarSurfaceBrush}" />

                        <ContentControl x:Name="PART_Docked"
                                        Grid.Column="0"
                                        ClipToBounds="True"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        ContentTemplate="{TemplateBinding SidebarTemplate}"
                                        Content="{TemplateBinding DataContext}" />

                        <Border Grid.Column="0"
                                Width="1"
                                HorizontalAlignment="Right"
                                IsHitTestVisible="False"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <ContentPresenter Grid.Column="1" />

                        <Border x:Name="PART_Peek"
                                Grid.ColumnSpan="2"
                                Panel.ZIndex="100"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                BorderThickness="0 0 1 0"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                ClipToBounds="True"
                                Background="{DynamicResource SidebarSurfaceBrush}">
                            <!-- Always laid out at full width and clipped by the border, which is what opens: the
                                 panel is revealed to the right of the rail rather than slid in from beside it, so
                                 the rail's icons and this copy's are never seen in two places. -->
                            <ContentControl x:Name="PART_PeekContent"
                                            HorizontalAlignment="Left"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            ContentTemplate="{TemplateBinding SidebarTemplate}"
                                            Content="{TemplateBinding DataContext}" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPeekVisible" Value="True">
                            <Setter TargetName="PART_Peek" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
