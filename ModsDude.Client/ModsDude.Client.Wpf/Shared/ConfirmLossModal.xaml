<UserControl x:Class="ModsDude.Client.Wpf.Shared.ConfirmLossModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
             mc:Ignorable="d"
             Width="520" MaxHeight="620"
             d:DataContext="{d:DesignInstance Type=shared:ConfirmLossModalViewModel, IsDesignTimeCreatable=False}"
             Focusable="True">

    <Border CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>

        <Grid RowDefinitions="auto * auto">

            <StackPanel Grid.Row="0" Margin="24 24 24 12">
                <TextBlock Text="{Binding Title}"
                           TextWrapping="Wrap"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="{Binding Message}"
                           Margin="0 12 0 0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="24 0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0 0 0 4"
                                       Text="{Binding}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Margin="0 16 0 0"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">

                <!-- A uniform grid because it leaves collapsed buttons out of the count. Three
                     phrases side by side do not fit, so an alternative stacks every answer. -->
                <UniformGrid Margin="20 24">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Rows" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAlternative}" Value="True">
                                    <Setter Property="Rows" Value="0" />
                                    <Setter Property="Columns" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <Button Margin="4"
                            Content="{Binding AlternativeText}"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding AlternativeCommand}"
                            Visibility="{Binding HasAlternative, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Button Margin="4"
                            Content="{Binding ConfirmText}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ConfirmCommand}" />

                    <Button Margin="4"
                            Content="{Binding CancelText}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}" />
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</UserControl>
