<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Every colour the app draws with. Nothing else names a colour: XAML takes these brushes, or the
         theme's own, which FluentPalette.xaml points at these colours. The app is dark only.

         The UI is built in layers, each a step lighter than the one it lies on:
           window   title bar and rail
           shell    the repo's header and sidebar, a sheet with a rounded corner on the window
           content  the page, a pane with a rounded corner on the shell, casting a shadow onto it
           card     the groups on a page
         and two that go the other way: an inset well (lists, search) sunk into a card, and the
         footer of a page, a step below its content. -->

    <Color x:Key="WindowColor">#0F1114</Color>
    <Color x:Key="ShellColor">#14161A</Color>
    <Color x:Key="InsetColor">#121418</Color>
    <Color x:Key="ContentColor">#191C21</Color>
    <Color x:Key="FooterColor">#16191D</Color>
    <Color x:Key="CardColor">#1F2329</Color>
    <Color x:Key="RaisedColor">#282C33</Color>
    <Color x:Key="PopupColor">#1F2329</Color>

    <Color x:Key="ShellStrokeColor">#23272D</Color>
    <Color x:Key="ContentStrokeColor">#262A31</Color>
    <Color x:Key="CardStrokeColor">#2C3138</Color>
    <Color x:Key="InsetStrokeColor">#23272D</Color>
    <Color x:Key="RaisedStrokeColor">#363B44</Color>
    <Color x:Key="StrongStrokeColor">#454B55</Color>

    <Color x:Key="TextPrimaryColor">#EEF0F3</Color>
    <Color x:Key="TextSecondaryColor">#B8BEC8</Color>
    <Color x:Key="TextMutedColor">#8F96A1</Color>
    <Color x:Key="TextDisabledColor">#5F6670</Color>

    <Color x:Key="AccentColor">#FF8A3D</Color>
    <Color x:Key="AccentTextColor">#FFA86B</Color>
    <Color x:Key="OnAccentColor">#1C0F05</Color>
    <Color x:Key="OnAccentSecondaryColor">#991C0F05</Color>
    <Color x:Key="AccentTintColor">#21FF8A3D</Color>
    <Color x:Key="AccentBorderColor">#6BFF8A3D</Color>

    <Color x:Key="InfoColor">#6FA8FF</Color>
    <Color x:Key="SuccessColor">#5CC98A</Color>
    <Color x:Key="CautionColor">#F2C14E</Color>
    <Color x:Key="LockedColor">#B4A2E8</Color>
    <Color x:Key="CriticalColor">#FF6B6B</Color>

    <Color x:Key="SuccessTintColor">#1F5CC98A</Color>
    <Color x:Key="CautionTintColor">#1FF2C14E</Color>
    <Color x:Key="CriticalTintColor">#1FFF6B6B</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource ShellColor}" />
    <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource InsetColor}" />
    <SolidColorBrush x:Key="ContentBrush" Color="{StaticResource ContentColor}" />
    <SolidColorBrush x:Key="FooterBrush" Color="{StaticResource FooterColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="PopupBrush" Color="{StaticResource PopupColor}" />

    <SolidColorBrush x:Key="ShellStrokeBrush" Color="{StaticResource ShellStrokeColor}" />
    <SolidColorBrush x:Key="ContentStrokeBrush" Color="{StaticResource ContentStrokeColor}" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource CardStrokeColor}" />
    <SolidColorBrush x:Key="InsetStrokeBrush" Color="{StaticResource InsetStrokeColor}" />
    <SolidColorBrush x:Key="RaisedStrokeBrush" Color="{StaticResource RaisedStrokeColor}" />
    <SolidColorBrush x:Key="StrongStrokeBrush" Color="{StaticResource StrongStrokeColor}" />

    <!-- The hairline between the rows of a well: the card's colour, so a row reads as cut out of it. -->
    <SolidColorBrush x:Key="RowDividerBrush" Color="{StaticResource CardColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />

    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="LockedBrush" Color="{StaticResource LockedColor}" />

    <!-- A badge in a status colour: the colour faint behind, stronger round the edge, and the text a
         lighter shade of it so it reads on the faint fill. -->
    <SolidColorBrush x:Key="InfoTintBrush" Color="#1F6FA8FF" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#596FA8FF" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#A9C9FF" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#595CC98A" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#9BE2B9" />
    <SolidColorBrush x:Key="CautionTintBrush" Color="{StaticResource CautionTintColor}" />
    <SolidColorBrush x:Key="CautionBorderBrush" Color="#59F2C14E" />
    <SolidColorBrush x:Key="CautionTextBrush" Color="#F7D88E" />
    <SolidColorBrush x:Key="LockedTintBrush" Color="#1FB4A2E8" />
    <SolidColorBrush x:Key="LockedBorderBrush" Color="#59B4A2E8" />
    <SolidColorBrush x:Key="LockedTextBrush" Color="#D2C7F2" />
    <SolidColorBrush x:Key="CriticalTintBrush" Color="{StaticResource CriticalTintColor}" />
    <SolidColorBrush x:Key="CriticalBorderBrush" Color="#59FF6B6B" />
    <SolidColorBrush x:Key="CriticalTextBrush" Color="#FFA3A3" />

    <!-- Theme brushes the map in scripts/fluent-palette.ps1 cannot reach, because the theme builds them
         from colours that everything else shares: a text field is an inset well, edged all round,
         where the theme draws it as a raised control with a line under it. -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource InsetColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource InsetColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource ContentStrokeColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource RaisedStrokeColor}" />

    <!-- Text on a fill that is not ours to pick: a user's avatar colour, the close button's red. -->
    <SolidColorBrush x:Key="OnColorBrush" Color="#FFFFFF" />

    <!-- The title bar's close button, red under the pointer as Windows draws its own. -->
    <SolidColorBrush x:Key="CaptionCloseBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#C83C31" />

    <!-- What dims the app under the modal layer. -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#990A0B0D" />

    <!-- Shadows. Black at the strength of each layer's, and the accent's own glow under what is lit. -->
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="AccentGlowColor">#FF8A3D</Color>

    <!-- Corners, one per kind of thing, so nothing picks a radius of its own. The first three are the
         theme's keys, which its controls read dynamically: controls, popups, and the modal layer. -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="LayerCornerRadius">14 0 0 0</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="WellCornerRadius">10</CornerRadius>
    <!-- A segment inside a well's 1px edge and 2px padding, so its corners run parallel to the well's. -->
    <CornerRadius x:Key="SegmentCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">6</CornerRadius>
</ResourceDictionary>
