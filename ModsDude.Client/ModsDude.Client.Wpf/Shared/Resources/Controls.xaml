<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:ModsDude.Client.Wpf.Shared.Converters"
                    xmlns:shared="clr-namespace:ModsDude.Client.Wpf.Shared"
                    xmlns:behaviors="clr-namespace:ModsDude.Client.Wpf.Shared.Behaviors">

    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    <converters:IconKindToStringConverter x:Key="IconKindToStringConverter" />
    <converters:GlyphCenteringConverter x:Key="GlyphCenteringConverter" />

    <!-- An icon glyph drawn centred in a frame: nudged so its ink is centred, not just its box. See
         GlyphCenteringConverter. -->
    <Style x:Key="CenteredGlyph" TargetType="TextBlock">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource GlyphCenteringConverter}">
                    <Binding Path="Text" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="FontFamily" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="FontSize" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text that reads as a TextBlock and selects like a TextBox. WPF's TextBlock has no selection
         of its own, so anything a user might want to take away - an error message, an exception - has
         to be a read-only TextBox wearing no chrome. IsReadOnlyCaretVisible is off so it does not
         blink an insertion point at somebody who is only reading, and the padding is zeroed because
         a TextBox brings its own and would otherwise sit a few pixels off from the labels around it. -->
    <Style x:Key="SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="IBeam" />
    </Style>

    <!-- A borderless icon button, for the kind of secondary action that would be visual noise with
         full button chrome on every row of a long list. -->
    <Style x:Key="SubtleIconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same chrome for a button that stays down while the thing it opened is open. -->
    <Style x:Key="SubtleIconToggleButton" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Background"
                            Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width row in a popup. Buttons rather than MenuItems so the popup can be an ordinary
         panel and inherit the data context of the row that opened it. -->
    <Style x:Key="SubtleMenuButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10 7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A label/value pair in a two-column grid: the label is static and quiet, the value is what
         changes and reads first. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0 4 16 0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="Margin" Value="0 4 0 0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- See SplitButton. The chrome is drawn behind two bare buttons, once per half and split down the
         seam, so only the outer corners round and the halves meet on a hairline; every state is set
         from here. The chevron is drawn rather than a glyph, so a missing icon font cannot leave a
         stray mark. The caret ignores the pointer while the menu is up, so the click that closes the
         menu does not open it again. -->
    <Style TargetType="shared:SplitButton">
        <Setter Property="Padding" Value="11 5 11 6" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shared:SplitButton">
                    <Grid x:Name="Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="PrimaryChrome"
                                CornerRadius="4 0 0 4"
                                BorderThickness="1 1 0 1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" />

                        <Button x:Name="PART_Primary"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Command="{TemplateBinding Command}"
                                Content="{TemplateBinding Header}"
                                Padding="{TemplateBinding Padding}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                FocusVisualStyle="{x:Null}"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border x:Name="PrimaryFocus"
                                CornerRadius="4 0 0 4"
                                BorderThickness="0"
                                IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />

                        <Border x:Name="CaretChrome"
                                Grid.Column="1"
                                CornerRadius="0 4 4 0"
                                BorderThickness="0 1 1 1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" />

                        <Rectangle x:Name="Seam"
                                   Grid.Column="1"
                                   Width="1" Margin="0 7"
                                   HorizontalAlignment="Left"
                                   IsHitTestVisible="False"
                                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

                        <ToggleButton x:Name="PART_Caret"
                                      Grid.Column="1"
                                      VerticalAlignment="Stretch"
                                      Width="34"
                                      FocusVisualStyle="{x:Null}"
                                      Cursor="Hand"
                                      ToolTip="{TemplateBinding CaretToolTip}"
                                      IsChecked="{Binding IsMenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Path x:Name="Chevron"
                                  Data="M 0 0 L 4.5 4.5 L 9 0"
                                  Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </ToggleButton>

                        <Border x:Name="CaretFocus"
                                Grid.Column="1"
                                CornerRadius="0 4 4 0"
                                BorderThickness="0"
                                IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />

                        <Popup x:Name="Menu"
                               IsOpen="{Binding IsMenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=Root}"
                               Placement="{TemplateBinding MenuPlacement}"
                               VerticalOffset="4"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border CornerRadius="{DynamicResource OverlayCornerRadius}"
                                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="4">
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger SourceName="PART_Primary" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger SourceName="PART_Primary" Property="IsPressed" Value="True">
                            <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger SourceName="PART_Primary" Property="IsEnabled" Value="False">
                            <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="PART_Primary" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                        <Trigger SourceName="PART_Caret" Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaretChrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger SourceName="PART_Caret" Property="IsChecked" Value="True">
                            <Setter TargetName="CaretChrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            <Setter TargetName="PART_Caret" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                        <Trigger SourceName="PART_Caret" Property="IsEnabled" Value="False">
                            <Setter TargetName="CaretChrome" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>

                        <Trigger Property="IsAccent" Value="True">
                            <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="PrimaryChrome" Property="BorderThickness" Value="0" />
                            <Setter TargetName="CaretChrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="CaretChrome" Property="BorderThickness" Value="0" />
                            <Setter TargetName="PART_Primary" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter TargetName="Seam" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter TargetName="Seam" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsAccent" Value="True" />
                                <Condition SourceName="PART_Primary" Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsAccent" Value="True" />
                                <Condition SourceName="PART_Primary" Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsAccent" Value="True" />
                                <Condition SourceName="PART_Primary" Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PrimaryChrome" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="PART_Primary" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsAccent" Value="True" />
                                <Condition SourceName="PART_Caret" Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CaretChrome" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsAccent" Value="True" />
                                <Condition SourceName="PART_Caret" Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CaretChrome" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsAccent" Value="True" />
                                <Condition SourceName="PART_Caret" Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CaretChrome" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                        </MultiTrigger>

                        <Trigger SourceName="PART_Primary" Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PrimaryFocus" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger SourceName="PART_Caret" Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CaretFocus" Property="BorderThickness" Value="1" />
                        </Trigger>

                        <Trigger Property="MenuPlacement" Value="Top">
                            <Setter TargetName="Menu" Property="VerticalOffset" Value="-4" />
                        </Trigger>

                        <Trigger Property="IsMenuAvailable" Value="False">
                            <Setter TargetName="CaretChrome" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Seam" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Caret" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CaretFocus" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PrimaryChrome" Property="CornerRadius" Value="4" />
                            <Setter TargetName="PrimaryFocus" Property="CornerRadius" Value="4" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMenuAvailable" Value="False" />
                                <Condition Property="IsAccent" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PrimaryChrome" Property="BorderThickness" Value="1" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A name that is also the way into whatever the row is about. It reads as ordinary text until
         the pointer is on it, so a list of them does not turn into a wall of links. A hyperlink
         rather than a click handler on the text: the hit area is then the glyphs themselves rather
         than the whole column they sit in, and it takes focus and the keyboard like any control. -->
    <Style x:Key="TextLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The pill a row wears to say what state it is in.
         Background and foreground have to move together, because the theme's status fills are
         bright: SystemFillColorCaution is #FCE100, and the primary text colour on it is white on
         yellow - a chip whose text cannot be read at all. The pairs this app uses are
           neutral    ControlFillColorSecondary  + TextFillColorPrimary   (the default, below)
           success    SystemFillColorSuccess     + TextFillColorInverse
           caution    SystemFillColorCaution     + TextFillColorInverse
           critical   SystemFillColorCritical    + TextFillColorInverse
           attention  AccentFillColorDefault     + TextOnAccentFillColorPrimary
         Attention is the accent rather than SystemFillColorAttention deliberately: that one is
         derived from whatever accent colour Windows is set to, so its brightness is unknowable and
         no fixed text colour is safe on it, while the theme guarantees TextOnAccent against
         AccentFillColorDefault - which is the pairing FilterChip below already relies on.
         The foreground is set on the border and inherited, so a trigger that changes the fill can
         change the text with it; none of the theme's TextBlock styles set a foreground of their
         own, so nothing downstream overrides it. -->
    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="Padding" Value="8 2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SuccessStatusChip" TargetType="Border" BasedOn="{StaticResource StatusChip}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
    </Style>

    <!-- Where a game's profile stands against its folders, bound to a SyncState of type
         ProfileSyncState on the data context. -->
    <Style x:Key="ProfileSyncChip" TargetType="Border" BasedOn="{StaticResource StatusChip}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SyncState}" Value="InSync">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SyncState}" Value="Drifted">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SyncState}" Value="NotApplied">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SyncState}" Value="Applying">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A presence filter chip. Radio buttons so the group enforces one active filter without any
         view model bookkeeping; the chrome is the button's, not the radio's. -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0 0 6 0" />
        <Setter Property="Padding" Value="12 5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Background"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Background" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A source chip. The same shape as the FilterChip above and deliberately never in the same row
         as one: these are independent toggles and those are mutually exclusive, so one row of both
         would read as one control with two kinds of behaviour in it. Above the filters where a page
         has both, because a source decides what a list is *of* and a filter narrows what it shows.
         Failure colours the chip rather than adding a second line - a line under one chip costs
         every chip in the row the height of the worst of them - and the reason is the tooltip,
         along with the path.
         Bound against ModSourceViewModel, which is what both the profile editor and the repo's mod
         page put behind these. See docs/09-mod-catalog.md#the-source-chips. -->
    <Style x:Key="SourceChip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0 0 6 0" />
        <Setter Property="Padding" Value="10 4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Background"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <!-- After the checked trigger, so a source that is switched on and
                             unreadable reads as unreadable. -->
                        <DataTrigger Binding="{Binding HasFailed}" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter TargetName="Background" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Background" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The "add a source" chips and the rescan, which are actions rather than toggles and so keep
         the neutral chrome whatever is switched on. -->
    <Style x:Key="SourceActionChip" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0 0 6 0" />
        <Setter Property="Padding" Value="10 4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Background" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- A newer version somewhere else - ModHub - on a mod's own row. The status chip's shape, since it
         sits in the same row of chips, but outlined in the accent and clickable: it is the one chip
         that goes somewhere, and it goes out of the app. Bound against RemoteUpdateViewModel. -->
    <Style x:Key="RemoteUpdateChip" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8 2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Background"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- The row of a list somebody is choosing from - a slot, in the modals that pick one - drawn the way
         the mod lists and the savegame log draw theirs: a full-width row with a hairline under it, the
         accent at low opacity and a bar down the left for the chosen one, and a lighter fill under the
         pointer. The default ListBoxItem is a padded box with the theme's own highlight, which is what
         made these read as a settings control rather than as a list of things. -->
    <Style x:Key="SlotRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row"
                            BorderThickness="0 0 0 1"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Background="Transparent">
                        <Grid>
                            <Border x:Name="Fill"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Opacity="0" />

                            <Rectangle x:Name="Bar"
                                       Width="3"
                                       Margin="0 6"
                                       RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}" />

                            <ContentPresenter />

                            <Border x:Name="Focus"
                                    BorderThickness="0"
                                    BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.16" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A list to choose one thing from, in a modal. Scrolls by the pixel rather than by the row:
         a slot is two or three lines tall, so scrolling by the item moved the list a third of its
         height with every notch of the wheel and made it jump rather than glide. That costs
         virtualization, which is the right trade for a list of a couple of dozen. -->
    <Style x:Key="SlotList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SlotRow}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>


    <!-- The container for a row in a mod list somebody picks from - both of the profile editor's, and
         the repo's own. It draws two different things that a plain list would draw as one: what is
         *picked*, which is a property of the row and survives the search, and which row is *current*,
         which is the framework's and is only a focus ring. Explorer draws the same distinction, and for
         the same reason - the arrow keys have to be able to move without that meaning the set has
         changed. -->
    <Style x:Key="ModRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <!-- The accent at low opacity rather than a named fill: it reads as a
                             selection in both themes, and it is the one colour on the row that
                             cannot be confused with the hover state under it. -->
                        <Border x:Name="Fill"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Opacity="0" />

                        <Rectangle x:Name="Bar"
                                   Width="3"
                                   Margin="0 6"
                                   RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left"
                                   Visibility="Collapsed"
                                   Fill="{DynamicResource AccentFillColorDefaultBrush}" />

                        <ContentPresenter />

                        <Border x:Name="Focus"
                                BorderThickness="0"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.16" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A mod list with a selection, which has to behave the same wherever it is: taking mods out of
         a profile is the same job as putting them in, and as picking versions to delete from a repo.
         SelectionMode stays Single on purpose. The list's own selection is only ever the current
         item - what is picked lives on the rows, because a list control drops from its selection
         whatever the collection view filters out, and that would mean one more character in the
         search box quietly discarding the set being assembled. See ListSelection. -->
    <Style x:Key="ModList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModRow}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <!-- The strip under a mod list while something is picked. Absent at zero, so the list keeps its
         height until there is something to say. -->
    <Style x:Key="SelectionBar" TargetType="Border">
        <Setter Property="Margin" Value="0 8 0 0" />
        <Setter Property="Padding" Value="10 8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>

    <!-- The title and cards of a page with little in it, held to a column in the middle of the window.
         The app is mostly used fullscreen, where a card stretched edge to edge had its content in the
         left quarter and anything right-aligned in it at the far side of the screen. Stretch rather
         than Center, so the cards fill the column instead of shrinking to their content: WPF centres a
         stretched element its MaxWidth stops from stretching. Pages that need the room - the mod
         lists, the saves, the history - do not use it. -->
    <Style x:Key="PageColumn" TargetType="FrameworkElement">
        <Setter Property="MaxWidth" Value="1000" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- The buttons under a PageColumn, starting at the column's left edge. The margin is the page
         border's padding, so that the two columns are the same width and so start in the same place. -->
    <Style x:Key="PageActions" TargetType="StackPanel" BasedOn="{StaticResource PageColumn}">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="32 24" />
    </Style>


    <!-- What every sidebar is drawn on: the card tint over the window's base colour, worked out once.
         Opaque so that the rail's hover labels, which lie over the page, match the rail they come out
         of. The app is dark only; if it ever has a light theme this needs a value for it. -->
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#2B2B2B" />

    <!-- A hovered row on that surface, opaque for the same reason. -->
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#3A3A3A" />

    <!-- A sidebar is a strip of its own rather than part of the page: a tint behind it and a rule down
         its edge, so that two side by side read as two, and neither as the start of the page beside it. -->
    <Style x:Key="SidebarSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SidebarSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0 0 1 0" />
    </Style>

    <!-- The pages of one thing, side by side along a bar: an item list of MenuItemViewModels, selected the
         way a sidebar list is. Each tab is the bar's full height, so the accent underline of the selected
         one sits on the bar's bottom edge. A closed entry is dimmed and says why in its tooltip. -->
    <Style x:Key="PageTabs" TargetType="ListBox">
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="behaviors:DragSelection.Suppressed" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                    <Setter Property="ToolTip" Value="{Binding UnavailableReason}" />
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Background="Transparent">
                                    <Border x:Name="Hover"
                                            Margin="0 10"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Visibility="Hidden" />
                                    <StackPanel Margin="16 0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="Icon"
                                                   Text="{Binding Icon}"
                                                   Margin="0 0 10 0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="Title"
                                                   Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="Underline"
                                            Height="3"
                                            Margin="12 0"
                                            CornerRadius="1.5 1.5 0 0"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="Hidden" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
