{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Four lines per request otherwise, and a ModHub backfill is thousands of requests. The crawler
      // logs what matters itself.
      "System.Net.Http.HttpClient.ModHub": "Warning"
    }
  },
  "AllowedHosts": "*",
  // No user flow (SignUpSignInPolicyId) and no b2clogin.com instance: those belong to the B2C
  // tenant this moved off, and a user flow is what makes Microsoft.Identity.Web treat the app as
  // B2C. It would then look for a tfp claim the tokens this app actually receives do not carry.
  "EntraExternalId": {
    "Domain": "modsdudeexternal.onmicrosoft.com",
    "ClientId": "ea79defc-48db-4e20-9a17-7ae64fbec3cd",
    "Audience": "ea79defc-48db-4e20-9a17-7ae64fbec3cd",
    "Authority": "https://modsdudeexternal.ciamlogin.com/cce54c8f-87a3-4c39-a558-9a15733d2cdf",
    "TokenEndpoint": "https://modsdudeexternal.ciamlogin.com/cce54c8f-87a3-4c39-a558-9a15733d2cdf/oauth2/v2.0/token",
    "AuthorizationEndpoint": "https://modsdudeexternal.ciamlogin.com/cce54c8f-87a3-4c39-a558-9a15733d2cdf/oauth2/v2.0/authorize"
  },
  "SwaggerAuthentication": {
    "ClientId": "864f5fa0-c3e8-469c-9b30-9ff1893941a2"
  },
  // Stated rather than left to the defaults in code, because this is the one background job that
  // deletes things. MinimumBlobAge is what keeps it away from an import that has uploaded but not
  // yet registered; see BlobReclamationOptions.
  "BlobReclamation": {
    "Enabled": true,
    "Interval": "1.00:00:00",
    "MinimumBlobAge": "1.00:00:00"
  },
  // The other background jobs that delete things: scheduling at 05:00 and deleting at 06:00, Swedish
  // time. A deletion date means the deletion job's run on that day. See RetentionOptions.
  "Retention": {
    "Enabled": true,
    "TimeZone": "Europe/Stockholm",
    "ScheduleCron": "0 5 * * *",
    "DeleteCron": "0 6 * * *"
  },
  // Basic auth. The password is deliberately empty here - set it through user secrets or the
  // HangfireDashboard__Password environment variable. Without one the dashboard is not mapped.
  "HangfireDashboard": {
    "Path": "/hangfire",
    "Username": "admin",
    "Password": ""
  },
  // The crawler reads somebody else's website, so its pace and identity are stated here rather than
  // left to the defaults in code. The first sweep of a game takes a couple of hours at one request a
  // second; see ModHubOptions.
  "ModHub": {
    "Enabled": true,
    "Games": [ "fs2025" ],
    "UserAgent": "ModsDude",
    "RequestDelay": "00:00:01",
    "PollInterval": "01:00:00",
    "SweepInterval": "7.00:00:00"
  }
}
