{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Every authorization request otherwise, with the address a sign-in was started for.
      "OpenIddict": "Warning",
      // Four lines per request otherwise, and a ModHub backfill is thousands of requests. The crawler
      // logs what matters itself.
      "System.Net.Http.HttpClient.ModHub": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Where GET /download sends a browser: the installer of the client release with this server's build.
  "ClientDownload": {
    "GithubRepository": "https://github.com/anton-jh/ModsDude"
  },
  // Stated rather than left to the defaults in code, because this job deletes blobs. Daily at 04:00
  // UTC. It deletes only blobs the database queued, once they have sat untouched for MinimumBlobAge,
  // and only while storage keeps deleted blobs for at least MinimumSoftDeleteDays. See
  // StorageMaintenanceOptions.
  "StorageMaintenance": {
    "Enabled": true,
    "Cron": "0 4 * * *",
    "MinimumBlobAge": "1.00:00:00",
    "MinimumSoftDeleteDays": 14
  },
  // The other background jobs that delete things: scheduling at 05:00 and deleting at 06:00, Swedish
  // time. A deletion date means the deletion job's run on that day. See RetentionOptions.
  "Retention": {
    "Enabled": true,
    "TimeZone": "Europe/Stockholm",
    "ScheduleCron": "0 5 * * *",
    "DeleteCron": "0 6 * * *"
  },
  // Basic auth for /admin and the Hangfire dashboard at /admin/jobs, on Port only. The password is
  // deliberately empty here - set it through user secrets or the Admin__Password environment variable.
  // Port is the development one in appsettings.Development.json and 8081 in deploy/compose.yml. Without
  // both nobody gets in.
  "Admin": {
    "Username": "admin",
    "Password": "",
    "Port": 0
  },
  // The token CI announces updates to clients with; see deploy/update-announcement. Deliberately empty
  // here - set it through user secrets or the Deploy__Token environment variable. Without one nobody
  // gets in.
  "Deploy": {
    "Token": ""
  },
  // The crawler reads somebody else's website, so its pace and identity are stated here rather than
  // left to the defaults in code. The first sweep of a game takes a couple of hours at one request a
  // second. After that it runs daily at 19:00 Swedish time; see ModHubOptions.
  "ModHub": {
    "Enabled": true,
    "Games": [ "fs2025" ],
    "UserAgent": "ModsDude",
    "RequestDelay": "00:00:01",
    "PollCron": "0 19 * * *",
    "TimeZone": "Europe/Stockholm",
    "SweepInterval": "7.00:00:00"
  }
}
