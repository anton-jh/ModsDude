@page "/admin"
@model AdminPageModel
@{
    const string timeFormat = "yyyy-MM-dd HH:mm 'UTC'";
}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ModsDude admin</title>
<style>
    :root {
        color-scheme: dark;
    }

    body {
        margin: 0;
        background: #121212;
        color: #e8e8e8;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
    }

    main {
        max-width: 56rem;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    h1 {
        margin: 0;
        font-size: 1.5rem;
    }

    h2 {
        margin: 0 0 0.25rem;
        font-size: 1.125rem;
    }

    a {
        color: #7f9fff;
    }

    .muted {
        color: #a0a0a0;
    }

    .actions {
        margin: 1rem 0;
    }

    button {
        padding: 0.5rem 1.25rem;
        border: 1px solid #3a3a3a;
        border-radius: 0.375rem;
        background: #1c1c1c;
        color: #e8e8e8;
        font: inherit;
        cursor: pointer;
    }

    button:hover {
        background: #262626;
    }

    button.accent {
        border-color: #4f7cff;
        background: #4f7cff;
        color: #fff;
        font-weight: 600;
    }

    button.accent:hover {
        background: #3a65e0;
    }

    .panel {
        margin: 1rem 0;
        padding: 1rem;
        border: 1px solid #3a3a3a;
        border-radius: 0.375rem;
        background: #1c1c1c;
    }

    .panel.error {
        border-color: #a04040;
    }

    .code {
        font-family: Consolas, ui-monospace, monospace;
    }

    .panel .code {
        font-size: 1.75rem;
        letter-spacing: 0.05em;
        user-select: all;
    }

    .table-scroll {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

    th, td {
        padding: 0.5rem;
        border-bottom: 1px solid #2a2a2a;
        text-align: left;
        white-space: nowrap;
    }

    th {
        color: #a0a0a0;
        font-weight: 600;
    }

    .status {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        background: #2a2a2a;
        font-size: 0.75rem;
    }

    .status.Active {
        background: #1f3a26;
        color: #8fd6a0;
    }

    .status.Redeemed {
        background: #1f2c4a;
        color: #9fb6ff;
    }
</style>
</head>
<body>
<main>
    <header>
        <h1>ModsDude admin</h1>
        <a href="/admin/jobs">Jobs</a>
    </header>

    <section>
        <h2>Trust codes</h2>
        <div class="muted">Lets one user create repos. Single use, valid for @TrustCode.Lifetime.TotalHours hours.</div>

        <form method="post" asp-page-handler="Issue" class="actions">
            <input type="hidden" name="requestId" value="@Model.IssueRequestId">
            <button type="submit" class="accent">Issue trust code</button>
        </form>

        @if (Model.Error is not null)
        {
            <div class="panel error">@Model.Error</div>
        }

        @if (Model.Issued is { } issued)
        {
            <div class="panel">
                <div class="code">@issued.Code</div>
                <div class="muted">Expires @issued.ExpiresAt.ToString(timeFormat)</div>
            </div>
        }

        @if (Model.TrustCodes.Count == 0)
        {
            <p class="muted">No trust codes yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Status</th>
                            <th>Issued</th>
                            <th>Expires</th>
                            <th>Redeemed by</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.TrustCodes)
                        {
                            <tr>
                                <td class="code">@row.Code</td>
                                <td><span class="status @row.Status">@row.Status</span></td>
                                <td>@row.Created.ToString(timeFormat)</td>
                                <td>@row.ExpiresAt.ToString(timeFormat)</td>
                                <td>@(row.RedeemedBy ?? "")</td>
                                <td>
                                    @if (row.Status is TrustCodeStatus.Active)
                                    {
                                        <form method="post" asp-page-handler="Revoke" onsubmit="return confirm('Revoke @row.Code? It stops working at once.')">
                                            <input type="hidden" name="id" value="@row.Id">
                                            <button type="submit">Revoke</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>
</body>
</html>
