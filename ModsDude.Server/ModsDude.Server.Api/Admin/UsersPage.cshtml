@page "/admin/users"
@model UsersPageModel
@using ModsDude.Server.Domain.RepoMemberships
@using ModsDude.Server.Domain.Users
@{
    ViewData[AdminLayout.SectionKey] = AdminSection.Users;
}

<section>
    <h2>Users</h2>
    <div class="muted">Traffic covers the last @AdminWindows.TrafficDays days, counted when links are issued.</div>

    @if (Model.Users.Count == 0)
    {
        <p class="muted">No users yet.</p>
    }
    else
    {
        <div class="rows" style="--columns: minmax(10rem, 2fr) 10rem 5rem 6.5rem 6.5rem">
            <div class="rows-header">
                <span>User</span>
                <span>Last seen</span>
                <span class="number">Repos</span>
                <span class="number">Downloaded</span>
                <span class="number">Uploaded</span>
            </div>

            @foreach (var user in Model.Users)
            {
                <details id="@UsersPageModel.RowAnchor(user.Id)" open="@(Model.Open == user.Id)">
                    <summary>
                        <span>
                            @user.Name
                            @if (user.BlockedAt is not null)
                            {
                                <span class="status Blocked">Blocked</span>
                            }
                            @if (user.IsTrusted)
                            {
                                <span class="status Trusted">Trusted</span>
                            }
                        </span>
                        <span>@AdminFormat.Time(user.LastSeen)</span>
                        <span class="number">@AdminFormat.Count(user.Memberships.Count)</span>
                        <span class="number">@AdminFormat.Bytes(user.DownloadedBytes)</span>
                        <span class="number">@AdminFormat.Bytes(user.UploadedBytes)</span>
                    </summary>

                    <div class="row-details">
                        <dl class="facts">
                            <div><dt>Created</dt><dd>@AdminFormat.Time(user.Created)</dd></div>
                            @if (user.BlockedAt is DateTime blockedAt)
                            {
                                <div><dt>Blocked</dt><dd>@AdminFormat.Time(blockedAt)</dd></div>
                            }
                        </dl>

                        <h3>Account</h3>
                        <div class="toolbar">
                            @if (user.BlockedAt is null)
                            {
                                <form method="post" asp-page-handler="Block" data-confirm="Block @user.Name? They cannot use ModsDude until unblocked.">
                                    <input type="hidden" name="userId" value="@user.Id">
                                    <button type="submit" class="danger">Block</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Unblock">
                                    <input type="hidden" name="userId" value="@user.Id">
                                    <button type="submit">Unblock</button>
                                </form>
                            }

                            @if (user.IsTrusted)
                            {
                                <form method="post" asp-page-handler="RevokeTrust" data-confirm="Revoke trust from @user.Name? They can no longer create repos.">
                                    <input type="hidden" name="userId" value="@user.Id">
                                    <button type="submit">Revoke trust</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="GrantTrust">
                                    <input type="hidden" name="userId" value="@user.Id">
                                    <button type="submit">Grant trust</button>
                                </form>
                            }

                            @if (user.HasAvatar)
                            {
                                <form method="post" asp-page-handler="RemoveAvatar" data-confirm="Remove the avatar of @user.Name?">
                                    <input type="hidden" name="userId" value="@user.Id">
                                    <button type="submit">Remove avatar</button>
                                </form>
                            }

                            <form method="post" asp-page-handler="Rename">
                                <input type="hidden" name="userId" value="@user.Id">
                                <input type="text" name="name" value="@user.DisplayName" maxlength="@DisplayName.MaximumLength" required aria-label="Display name">
                                <button type="submit">Rename</button>
                            </form>
                        </div>

                        <h3>Memberships</h3>
                        @if (user.Memberships.Count == 0)
                        {
                            <p class="muted">Not a member of any repo.</p>
                        }
                        else
                        {
                            <div class="scroll-list"><table>
                                <thead>
                                    <tr>
                                        <th>Repo</th>
                                        <th>Level</th>
                                        <th class="number">Downloaded</th>
                                        <th class="number">Uploaded</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var membership in user.Memberships)
                                    {
                                        <tr>
                                            <td>@membership.Repo</td>
                                            <td>
                                                <form method="post" asp-page-handler="SetLevel" class="toolbar">
                                                    <input type="hidden" name="userId" value="@user.Id">
                                                    <input type="hidden" name="repoId" value="@membership.RepoId">
                                                    <input type="hidden" name="revision" value="@membership.Revision">
                                                    <select name="level" aria-label="Level">
                                                        @foreach (var level in Enum.GetValues<RepoMembershipLevel>())
                                                        {
                                                            <option value="@level" selected="@(level == membership.Level)">@level</option>
                                                        }
                                                    </select>
                                                    <button type="submit">Save</button>
                                                </form>
                                            </td>
                                            <td class="number">@AdminFormat.Bytes(membership.DownloadedBytes)</td>
                                            <td class="number">@AdminFormat.Bytes(membership.UploadedBytes)</td>
                                            <td>
                                                <form method="post" asp-page-handler="RemoveMembership" data-confirm="Remove @user.Name from @membership.Repo?">
                                                    <input type="hidden" name="userId" value="@user.Id">
                                                    <input type="hidden" name="repoId" value="@membership.RepoId">
                                                    <input type="hidden" name="revision" value="@membership.Revision">
                                                    <button type="submit" class="danger">Remove</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        }

                        @if (user.BlockedAt is not null || user.AvailableRepos.Count == 0)
                        {
                            <div class="toolbar">
                                <span title="@(user.BlockedAt is not null ? "A blocked user cannot be added to a repo." : "Already a member of every repo.")"><button type="button" disabled>Add to repo</button></span>
                            </div>
                        }
                        else
                        {
                            var dialogId = $"add-membership-{UsersPageModel.RowAnchor(user.Id)}";

                            <div class="toolbar">
                                <button type="button" data-open-dialog="@dialogId">Add to repo</button>
                            </div>

                            <dialog id="@dialogId">
                                <form method="post" asp-page-handler="AddMembership" class="dialog-form">
                                    <h2>Add @user.Name to a repo</h2>
                                    <input type="hidden" name="userId" value="@user.Id">
                                    <input type="search" placeholder="Search repos" aria-label="Search repos" data-filters="@dialogId-repos">
                                    <select id="@dialogId-repos" name="repoId" size="10" required aria-label="Repo">
                                        @foreach (var repo in user.AvailableRepos)
                                        {
                                            <option value="@repo.Id">@repo.Name</option>
                                        }
                                    </select>
                                    <select name="level" aria-label="Level">
                                        @foreach (var level in Enum.GetValues<RepoMembershipLevel>())
                                        {
                                            <option value="@level" selected="@(level == RepoMembershipLevel.Member)">@level</option>
                                        }
                                    </select>
                                    <div class="dialog-actions">
                                        <button type="button" data-close-dialog>Cancel</button>
                                        <button type="submit" class="accent">Add</button>
                                    </div>
                                </form>
                            </dialog>
                        }
                    </div>
                </details>
            }
        </div>
    }
</section>
