@{
    var section = ViewData[AdminLayout.SectionKey] as AdminSection?;

    string? Current(AdminSection link) => link == section ? "page" : null;
}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>ModsDude admin</title>
@await Html.PartialAsync("/Shared/_Theme.cshtml")
<style>
    :root {
        --series-1: var(--info);
        --series-2: var(--locked);
        --series-3: var(--success);
    }

    body {
        display: flex;
        flex-direction: column;
    }

    .topbar {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 8px 32px;
        padding: 0 24px;
    }

    .topbar .brand {
        min-height: 52px;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    nav a {
        position: relative;
        display: flex;
        align-items: center;
        min-height: 52px;
        padding: 0 12px;
        color: var(--text-secondary);
        font-size: 13px;
        font-weight: 600;
    }

    nav a:hover {
        color: var(--text-primary);
        text-decoration: none;
    }

    nav a[aria-current="page"] {
        color: var(--text-primary);
    }

    nav a[aria-current="page"]::after {
        content: "";
        position: absolute;
        right: 12px;
        bottom: 0;
        left: 12px;
        height: 3px;
        border-radius: 3px 3px 0 0;
        background: var(--accent);
        box-shadow: 0 0 12px var(--accent-glow-soft);
    }

    .pane {
        flex: 1;
        margin-left: 12px;
        border-top: 1px solid var(--content-stroke);
        border-left: 1px solid var(--content-stroke);
        border-radius: var(--layer-radius);
        background: var(--content);
        box-shadow: -6px 0 18px color-mix(in srgb, var(--shadow) 18%, transparent);
    }

    main {
        display: flex;
        flex-direction: column;
        gap: 20px;
        max-width: 80rem;
        margin: 0 auto;
        padding: 32px 28px;
    }

    h2 {
        margin: 0;
        font-size: 17px;
        font-weight: 600;
    }

    section.card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding: 20px 24px 24px;
    }

    section.card > * {
        max-width: 100%;
    }

    section.card > .well, section.card > .tiles, section.card > .chart, section.card > details {
        align-self: stretch;
    }

    section.card h2 + .muted {
        margin-top: -8px;
        font-size: 13px;
    }

    p {
        margin: 0;
    }

    .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .toolbar form {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    td button, td select, td input {
        min-height: 28px;
        padding: 0 10px;
        font-size: 12px;
    }

    .issued {
        padding: 14px 18px;
    }

    .issued .code {
        font-size: 28px;
        letter-spacing: 0.05em;
        user-select: all;
    }

    .tiles {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
        gap: 10px;
    }

    .tile {
        padding: 12px 16px;
    }

    .tile .value {
        margin-top: 2px;
        font-size: 22px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .table-scroll {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    th, td {
        padding: 9px 14px;
        border-bottom: 1px solid var(--row-divider);
        text-align: left;
        vertical-align: middle;
        white-space: nowrap;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    th.number, td.number {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    dialog {
        width: min(28rem, calc(100vw - 2rem));
        padding: 22px 24px 0;
        overflow: hidden;
        border: 1px solid var(--raised-stroke);
        border-radius: var(--overlay-radius);
        background: var(--card);
        color: var(--text-primary);
        box-shadow: var(--modal-shadow);
    }

    dialog.wide {
        width: min(48rem, calc(100vw - 2rem));
    }

    dialog::backdrop {
        background: var(--scrim);
    }

    dialog h2 {
        margin-bottom: 16px;
    }

    .dialog-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field > span {
        color: var(--text-secondary);
        font-size: 13px;
        font-weight: 600;
    }

    .dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin: 8px -24px 0;
        padding: 14px 24px;
        border-top: 1px solid var(--card-stroke);
        background: var(--footer);
    }

    .chart {
        position: relative;
    }

    .chart svg {
        display: block;
        width: 100%;
        height: auto;
    }

    .chart text {
        fill: var(--text-muted);
        font-size: 11px;
    }

    .chart .grid {
        stroke: var(--card-stroke);
        stroke-width: 1;
    }

    .chart .series {
        fill: none;
        stroke-width: 2;
        stroke-linejoin: round;
        stroke-linecap: round;
    }

    .chart .crosshair {
        stroke: var(--text-muted);
        stroke-width: 1;
        visibility: hidden;
    }

    .chart .tooltip {
        position: absolute;
        top: 0;
        padding: 8px 12px;
        border: 1px solid var(--raised-stroke);
        border-radius: var(--popup-radius);
        background: var(--popup);
        font-size: 12px;
        box-shadow: var(--modal-shadow);
        pointer-events: none;
        visibility: hidden;
        white-space: nowrap;
    }

    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        color: var(--text-secondary);
        font-size: 12px;
    }

    .swatch {
        display: inline-block;
        width: 12px;
        height: 4px;
        margin-right: 6px;
        border-radius: 2px;
        vertical-align: middle;
    }

    details.toggle summary {
        color: var(--accent-text);
        cursor: pointer;
        font-size: 13px;
    }

    details.toggle[open] summary {
        margin-bottom: 12px;
    }

    .rows {
        overflow: hidden;
        font-size: 13px;
    }

    .rows-header, .rows summary {
        display: grid;
        grid-template-columns: var(--columns);
        gap: 8px;
        align-items: center;
        padding: 9px 14px 9px 34px;
        border-bottom: 1px solid var(--row-divider);
    }

    .rows-header > *, .rows summary > * {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rows .number {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .rows summary {
        position: relative;
        list-style: none;
        cursor: pointer;
    }

    .rows summary::-webkit-details-marker {
        display: none;
    }

    .rows summary::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 14px;
        width: 6px;
        height: 6px;
        border-right: 1.5px solid var(--text-muted);
        border-bottom: 1.5px solid var(--text-muted);
        transform: translateY(-70%) rotate(-45deg);
    }

    .rows details[open] > summary::before {
        transform: translateY(-70%) rotate(45deg);
    }

    .rows summary:hover {
        background: rgb(255 255 255 / 0.04);
    }

    .rows details[open] > summary {
        background: var(--accent-tint);
        box-shadow: inset 3px 0 0 var(--accent);
    }

    .rows details:last-child > summary, .rows details:last-child > .row-details {
        border-bottom: none;
    }

    .row-details {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding: 16px 20px 20px 34px;
        border-bottom: 1px solid var(--row-divider);
        background: var(--footer);
    }

    .row-details > * {
        max-width: 100%;
    }

    .row-details > .well {
        width: fit-content;
        min-width: 24rem;
    }

    .row-details .scroll-list {
        max-height: 24rem;
        overflow-y: auto;
    }

    .row-details .scroll-list th {
        position: sticky;
        top: 0;
        background: var(--inset);
    }

    .row-details h3 {
        margin: 10px 0 0;
    }

    th, .rows-header, .row-details h3, .tile .label {
        color: var(--text-muted);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .facts {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
        gap: 10px 16px;
        align-self: stretch;
        margin: 0;
    }

    .facts dt {
        color: var(--text-muted);
        font-size: 12px;
    }

    .facts dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
    }

    @@media (max-width: 48rem) {
        .topbar {
            padding: 0 16px;
        }

        .topbar .brand, nav a {
            min-height: 44px;
        }

        nav a {
            padding: 0 8px;
        }

        nav a[aria-current="page"]::after {
            right: 8px;
            left: 8px;
        }

        .pane {
            margin-left: 0;
        }

        main {
            padding: 20px 16px;
        }

        section.card {
            padding: 16px;
        }

        .toolbar form {
            max-width: 100%;
        }

        .toolbar input[type="text"] {
            min-width: 0;
            flex: 1;
        }

        .facts {
            grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
        }

        .table-scroll {
            overflow-x: visible;
        }

        table, tbody, tr, td {
            display: block;
        }

        .row-details > .well {
            width: 100%;
            min-width: 0;
        }

        thead, .rows-header {
            display: none;
        }

        tr {
            padding: 8px 0;
            border-bottom: 1px solid var(--row-divider);
        }

        tbody tr:last-child {
            border-bottom: none;
        }

        td, td.number {
            padding: 2px 12px;
            border-bottom: none;
            text-align: right;
            white-space: normal;
            overflow-wrap: anywhere;
        }

        td[data-label]::before {
            content: attr(data-label);
            float: left;
            margin-right: 16px;
            color: var(--text-muted);
        }

        td:first-child {
            font-weight: 600;
            text-align: left;
        }

        td:first-child::before {
            content: none;
        }

        td .toolbar {
            justify-content: flex-end;
        }

        .row-details {
            padding: 12px 12px 16px;
        }

        .rows summary {
            display: flex;
            flex-wrap: wrap;
            gap: 2px 16px;
        }

        .rows summary > :first-child {
            flex-basis: 100%;
            font-weight: 600;
        }

        .rows summary > :not(:first-child) {
            font-size: 12px;
        }

        .rows summary > [data-label]:not(:first-child)::before {
            content: attr(data-label) " ";
            color: var(--text-muted);
        }

        .rows summary::before {
            top: 17px;
        }
    }
</style>
</head>
<body>
<header class="topbar">
    <div class="brand"><span class="brand-mark" aria-hidden="true">M</span>ModsDude admin</div>
    <nav>
        <a href="/admin" aria-current="@Current(AdminSection.Overview)">Overview</a>
        <a href="/admin/repos" aria-current="@Current(AdminSection.Repos)">Repos</a>
        <a href="/admin/users" aria-current="@Current(AdminSection.Users)">Users</a>
        <a href="/admin/trust-codes" aria-current="@Current(AdminSection.TrustCodes)">Trust codes</a>
        <a href="/admin/jobs">Jobs</a>
    </nav>
</header>
<div class="pane">
    <main>
        @if (TempData.TakeError() is string error)
        {
            <div class="notice error">@error</div>
        }
        @if (TempData.TakeNotice() is string notice)
        {
            <div class="notice">@notice</div>
        }

        @RenderBody()
    </main>
</div>
<script>
    // Asked here rather than in an onsubmit attribute, so a name in the question is never read as script.
    document.addEventListener("submit", event => {
        const question = event.target.dataset.confirm;
        if (question && !confirm(question)) {
            event.preventDefault();
        }
    });

    document.addEventListener("click", event => {
        const opener = event.target.closest("[data-open-dialog]");
        if (opener) {
            const dialog = document.getElementById(opener.dataset.openDialog);
            dialog.showModal();
            dialog.querySelector("input[type=search]")?.focus();
        }

        event.target.closest("[data-close-dialog]")?.closest("dialog").close();
    });

    // Each cell carries its column's heading, which narrow screens show beside it instead of the header row.
    function labelCells(headings, cells) {
        [...cells].forEach((cell, index) => {
            const heading = headings[index]?.textContent.trim();
            if (heading) {
                cell.dataset.label = heading;
            }
        });
    }

    for (const table of document.querySelectorAll("table")) {
        const headings = table.tHead?.rows[0]?.cells ?? [];
        for (const body of table.tBodies) {
            for (const row of body.rows) {
                labelCells(headings, row.cells);
            }
        }
    }

    for (const rows of document.querySelectorAll(".rows")) {
        const headings = rows.querySelector(":scope > .rows-header").children;
        for (const summary of rows.querySelectorAll(":scope > details > summary")) {
            labelCells(headings, summary.children);
        }
    }

    // A search box narrows the list it names to the options whose text contains what was typed.
    document.addEventListener("input", event => {
        const list = event.target.dataset.filters && document.getElementById(event.target.dataset.filters);
        if (!list) {
            return;
        }

        const query = event.target.value.trim().toLowerCase();
        for (const option of list.options) {
            option.hidden = !option.text.toLowerCase().includes(query);
        }

        if (list.selectedOptions[0]?.hidden) {
            list.selectedIndex = -1;
        }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
