@{
    var section = ViewData[AdminLayout.SectionKey] as AdminSection?;

    string NavClass(AdminSection link) => link == section ? "current" : "";
}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ModsDude admin</title>
<style>
    :root {
        color-scheme: dark;
        --surface: #121212;
        --panel: #1c1c1c;
        --hover: #262626;
        --border: #3a3a3a;
        --rule: #2a2a2a;
        --text: #e8e8e8;
        --muted: #a0a0a0;
        --link: #7f9fff;
        --accent: #4f7cff;
        --accent-hover: #3a65e0;
        --error: #a04040;
        --series-1: #3987e5;
        --series-2: #d95926;
        --series-3: #199e70;
    }

    body {
        margin: 0;
        background: var(--surface);
        color: var(--text);
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
    }

    main {
        max-width: 80rem;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    header {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    nav a.current {
        color: var(--text);
        font-weight: 600;
        text-decoration: none;
    }

    h1 {
        margin: 0;
        font-size: 1.5rem;
    }

    h2 {
        margin: 0 0 0.25rem;
        font-size: 1.125rem;
    }

    section {
        margin-bottom: 2.5rem;
    }

    a {
        color: var(--link);
    }

    .muted {
        color: var(--muted);
    }

    .actions {
        margin: 1rem 0;
    }

    button {
        padding: 0.5rem 1.25rem;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background: var(--panel);
        color: var(--text);
        font: inherit;
        cursor: pointer;
    }

    button:hover {
        background: var(--hover);
    }

    button:disabled, button:disabled:hover {
        background: var(--panel);
        color: var(--muted);
        cursor: not-allowed;
        opacity: 0.6;
    }

    button.accent {
        border-color: var(--accent);
        background: var(--accent);
        color: #fff;
        font-weight: 600;
    }

    button.accent:hover {
        background: var(--accent-hover);
    }

    button.danger {
        border-color: var(--error);
    }

    button.danger:hover {
        background: var(--error);
    }

    input[type="text"], input[type="search"], select {
        padding: 0.5rem;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--text);
        font: inherit;
    }

    .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        margin: 0.5rem 0;
    }

    .toolbar form {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    td .toolbar {
        margin: 0;
    }

    .row-details td {
        vertical-align: middle;
    }

    td button, td select {
        padding: 0.25rem 0.75rem;
        font-size: 0.875rem;
    }

    dialog {
        width: min(28rem, calc(100vw - 2rem));
        padding: 1.5rem;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background: var(--panel);
        color: var(--text);
    }

    dialog::backdrop {
        background: rgb(0 0 0 / 0.6);
    }

    dialog h2 {
        margin-bottom: 1rem;
    }

    .dialog-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .dialog-form select[size] {
        padding: 0.25rem;
    }

    .dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .panel {
        margin: 1rem 0;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background: var(--panel);
    }

    .panel.error {
        border-color: var(--error);
    }

    .panel.notice {
        border-color: var(--accent);
    }

    .code {
        font-family: Consolas, ui-monospace, monospace;
    }

    .panel .code {
        font-size: 1.75rem;
        letter-spacing: 0.05em;
        user-select: all;
    }

    .tiles {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
        gap: 0.75rem;
        margin: 1rem 0;
    }

    .tile {
        padding: 0.75rem 1rem;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background: var(--panel);
    }

    .tile .label {
        color: var(--muted);
        font-size: 0.75rem;
    }

    .tile .value {
        margin-top: 0.25rem;
        font-size: 1.375rem;
        font-variant-numeric: tabular-nums;
    }

    .table-scroll {
        overflow-x: auto;
        margin: 1rem 0;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

    th, td {
        padding: 0.5rem;
        border-bottom: 1px solid var(--rule);
        text-align: left;
        vertical-align: top;
        white-space: nowrap;
    }

    th {
        color: var(--muted);
        font-weight: 600;
    }

    th.number, td.number {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .status {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        background: var(--rule);
        font-size: 0.75rem;
    }

    .status.Active, .status.Trusted {
        background: #1f3a26;
        color: #8fd6a0;
    }

    .status.Redeemed {
        background: #1f2c4a;
        color: #9fb6ff;
    }

    .status.Blocked, .status.NoActiveAdmin {
        background: #4a1f1f;
        color: #f0a0a0;
    }

    .chart {
        position: relative;
        margin: 1rem 0;
    }

    .chart svg {
        display: block;
        width: 100%;
        height: auto;
    }

    .chart text {
        fill: var(--muted);
        font-size: 11px;
    }

    .chart .grid {
        stroke: var(--rule);
        stroke-width: 1;
    }

    .chart .series {
        fill: none;
        stroke-width: 2;
        stroke-linejoin: round;
        stroke-linecap: round;
    }

    .chart .crosshair {
        stroke: var(--muted);
        stroke-width: 1;
        visibility: hidden;
    }

    .chart .tooltip {
        position: absolute;
        top: 0;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background: var(--panel);
        font-size: 0.75rem;
        pointer-events: none;
        visibility: hidden;
        white-space: nowrap;
    }

    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.75rem;
        color: var(--muted);
    }

    .swatch {
        display: inline-block;
        width: 0.75rem;
        height: 0.25rem;
        margin-right: 0.375rem;
        border-radius: 2px;
        vertical-align: middle;
    }

    details.toggle summary {
        color: var(--link);
        cursor: pointer;
        font-size: 0.875rem;
    }

    .rows {
        margin: 1rem 0;
        font-size: 0.875rem;
    }

    .rows-header, .rows summary {
        display: grid;
        grid-template-columns: var(--columns);
        gap: 0.5rem;
        align-items: baseline;
        padding: 0.5rem 0.5rem 0.5rem 1.5rem;
        border-bottom: 1px solid var(--rule);
    }

    .rows-header {
        color: var(--muted);
        font-weight: 600;
    }

    .rows-header > *, .rows summary > * {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rows .number {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .rows summary {
        position: relative;
        list-style: none;
        cursor: pointer;
    }

    .rows summary::-webkit-details-marker {
        display: none;
    }

    .rows summary::before {
        content: "▸";
        position: absolute;
        top: 50%;
        left: 0.5rem;
        transform: translateY(-50%);
        color: var(--muted);
    }

    .rows details[open] > summary::before {
        content: "▾";
    }

    .rows summary:hover {
        background: var(--panel);
    }

    .rows details[open] > summary {
        background: var(--panel);
        border-bottom-color: transparent;
    }

    .row-details {
        padding: 0.5rem 1rem 1rem 1.5rem;
        border-bottom: 1px solid var(--rule);
        background: var(--panel);
    }

    .row-details table {
        width: auto;
        min-width: 24rem;
    }

    .row-details .scroll-list {
        display: inline-block;
        max-height: 24rem;
        overflow-y: auto;
    }

    .row-details .scroll-list th {
        position: sticky;
        top: 0;
        background: var(--panel);
    }

    .row-details h3 {
        margin: 1rem 0 0.25rem;
        color: var(--muted);
        font-size: 0.75rem;
        font-weight: 600;
    }

    .facts {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
        gap: 0.5rem 1rem;
        margin: 0.5rem 0 0;
    }

    .facts dt {
        color: var(--muted);
        font-size: 0.75rem;
    }

    .facts dd {
        margin: 0;
        font-variant-numeric: tabular-nums;
    }
</style>
</head>
<body>
<main>
    <header>
        <h1>ModsDude admin</h1>
        <nav>
            <a href="/admin" class="@NavClass(AdminSection.Overview)">Overview</a>
            <a href="/admin/repos" class="@NavClass(AdminSection.Repos)">Repos</a>
            <a href="/admin/users" class="@NavClass(AdminSection.Users)">Users</a>
            <a href="/admin/trust-codes" class="@NavClass(AdminSection.TrustCodes)">Trust codes</a>
            <a href="/admin/jobs">Jobs</a>
        </nav>
    </header>

    @if (TempData.TakeError() is string error)
    {
        <div class="panel error">@error</div>
    }
    @if (TempData.TakeNotice() is string notice)
    {
        <div class="panel notice">@notice</div>
    }

    @RenderBody()
</main>
<script>
    // Asked here rather than in an onsubmit attribute, so a name in the question is never read as script.
    document.addEventListener("submit", event => {
        const question = event.target.dataset.confirm;
        if (question && !confirm(question)) {
            event.preventDefault();
        }
    });

    document.addEventListener("click", event => {
        const opener = event.target.closest("[data-open-dialog]");
        if (opener) {
            const dialog = document.getElementById(opener.dataset.openDialog);
            dialog.showModal();
            dialog.querySelector("input[type=search]")?.focus();
        }

        event.target.closest("[data-close-dialog]")?.closest("dialog").close();
    });

    // A search box narrows the list it names to the options whose text contains what was typed.
    document.addEventListener("input", event => {
        const list = event.target.dataset.filters && document.getElementById(event.target.dataset.filters);
        if (!list) {
            return;
        }

        const query = event.target.value.trim().toLowerCase();
        for (const option of list.options) {
            option.hidden = !option.text.toLowerCase().includes(query);
        }

        if (list.selectedOptions[0]?.hidden) {
            list.selectedIndex = -1;
        }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
