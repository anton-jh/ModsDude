<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
@if (ViewData["Indexed"] is not true)
{
    <meta name="robots" content="noindex">
}
<title>@(ViewData["Title"] is string title ? $"{title} - ModsDude" : "ModsDude")</title>
@await Html.PartialAsync("/Shared/_Theme.cshtml")
<style>
    main {
        width: min(28rem, 100%);
        margin: 0 auto;
        padding: 56px 16px;
    }

    .brand {
        margin: 0 0 24px 4px;
    }

    .card {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 28px 28px 24px;
    }

    h1 {
        margin: 0 0 4px;
        font-size: 22px;
        font-weight: 600;
        letter-spacing: -0.01em;
    }

    h2 {
        margin: 8px 0 0;
        font-size: 15px;
        font-weight: 600;
    }

    p {
        margin: 0;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    form > button {
        align-self: flex-start;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field label {
        color: var(--text-secondary);
        font-size: 13px;
        font-weight: 600;
    }

    .field .hint {
        color: var(--text-muted);
        font-size: 12px;
    }

    .field input {
        width: 100%;
    }

    input.input-validation-error {
        border-color: var(--critical-border);
    }

    .field-validation-error {
        color: var(--critical-text);
        font-size: 13px;
    }

    .validation-summary-errors ul {
        margin: 0;
        padding: 10px 14px;
        border: 1px solid var(--critical-border);
        border-radius: var(--well-radius);
        background: var(--critical-tint);
        color: var(--critical-text);
        list-style: none;
    }

    .validation-summary-valid {
        display: none;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px;
        padding-top: 16px;
        border-top: 1px solid var(--card-stroke);
        font-size: 13px;
    }

    .invite {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .invite-row {
        display: flex;
        gap: 8px;
    }

    dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 8px 16px;
        margin: 0;
        padding: 12px 16px;
    }

    dt {
        color: var(--text-secondary);
    }

    dd {
        margin: 0;
        overflow-wrap: anywhere;
    }
</style>
@await RenderSectionAsync("Styles", required: false)
</head>
<body>
<main>
    <div class="brand"><span class="brand-mark" aria-hidden="true">M</span>ModsDude</div>
    <div class="card">
        @RenderBody()
    </div>
</main>
</body>
</html>
