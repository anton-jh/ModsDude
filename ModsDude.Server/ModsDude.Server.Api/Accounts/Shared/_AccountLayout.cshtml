<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex">
<title>@(ViewData["Title"] is string title ? $"{title} - ModsDude" : "ModsDude")</title>
<style>
    :root {
        color-scheme: dark;
        --surface: #121212;
        --panel: #1c1c1c;
        --hover: #262626;
        --border: #3a3a3a;
        --text: #e8e8e8;
        --muted: #a0a0a0;
        --link: #7f9fff;
        --accent: #4f7cff;
        --accent-hover: #3a65e0;
        --error: #e06c6c;
        --success: #4caf7d;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        min-height: 100vh;
        background: var(--surface);
        color: var(--text);
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        line-height: 1.5;
    }

    main {
        width: min(26rem, 100%);
        margin: 0 auto;
        padding: 3rem 1rem;
    }

    .brand {
        margin: 0 0 2rem;
        color: var(--muted);
        font-weight: 600;
        letter-spacing: 0.02em;
    }

    .panel {
        padding: 1.5rem;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        background: var(--panel);
    }

    h1 {
        margin: 0 0 1.25rem;
        font-size: 1.375rem;
    }

    h2 {
        margin: 1.5rem 0 0.5rem;
        font-size: 1rem;
    }

    p {
        margin: 0 0 1rem;
    }

    a {
        color: var(--link);
    }

    .muted {
        color: var(--muted);
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .field label {
        font-size: 0.875rem;
        font-weight: 600;
    }

    .field .hint {
        color: var(--muted);
        font-size: 0.8125rem;
    }

    input[type="text"], input[type="email"], input[type="password"] {
        width: 100%;
        padding: 0.5rem 0.625rem;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--text);
        font: inherit;
    }

    input:focus-visible, button:focus-visible, a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    input.input-validation-error {
        border-color: var(--error);
    }

    .field-validation-error, .form-error {
        color: var(--error);
        font-size: 0.875rem;
    }

    .validation-summary-errors ul {
        margin: 0;
        padding: 0;
        list-style: none;
        color: var(--error);
        font-size: 0.875rem;
    }

    .validation-summary-valid {
        display: none;
    }

    .notice {
        padding: 0.75rem 1rem;
        border: 1px solid var(--success);
        border-radius: 0.375rem;
        color: var(--text);
    }

    button {
        padding: 0.5rem 1.25rem;
        border: 1px solid var(--border);
        border-radius: 0.375rem;
        background: var(--panel);
        color: var(--text);
        font: inherit;
        cursor: pointer;
    }

    button:hover {
        background: var(--hover);
    }

    button.accent {
        border-color: var(--accent);
        background: var(--accent);
        color: #fff;
        font-weight: 600;
    }

    button.accent:hover {
        background: var(--accent-hover);
    }

    button.link {
        padding: 0;
        border: none;
        background: none;
        color: var(--link);
        text-decoration: underline;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem;
        margin-top: 1.25rem;
        font-size: 0.875rem;
    }

    .separated {
        margin-top: 1.5rem;
    }

    .row {
        display: flex;
        gap: 0.5rem;
    }

    .row input {
        flex: 1;
    }

    dl {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.5rem 1rem;
        margin: 0 0 1.25rem;
    }

    dt {
        color: var(--muted);
    }

    dd {
        margin: 0;
        overflow-wrap: anywhere;
    }
</style>
</head>
<body>
<main>
    <p class="brand">ModsDude</p>
    <div class="panel">
        @RenderBody()
    </div>
</main>
</body>
</html>
