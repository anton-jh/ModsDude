@page "/account/check-email"
@model CheckEmailPageModel
@{
    ViewData["Title"] = "Check your email";
}

<h1>Check your email</h1>

<dl class="well">
    <dt>Sent to</dt>
    <dd>@Model.Email</dd>
</dl>

<p>Open the link in the email to confirm your address. Then sign in.</p>

@if (Model.Resent)
{
    <p class="notice">If that address is waiting for confirmation, a new link is on its way.</p>
}

@if (Model.CouldNotSend)
{
    <p class="notice error">Could not send the email. Try again in a moment.</p>
}

<form method="post">
    <input type="hidden" asp-for="Email">
    <input type="hidden" asp-for="ReturnUrl">
    <button type="submit">Send the link again</button>
</form>

<div class="links">
    <a asp-page="/Accounts/SignInPage" asp-route-email="@Model.Email" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
</div>
