@page "/account/reset-password"
@model ResetPasswordPageModel
@{
    ViewData["Title"] = "Choose a new password";
}

<h1>Choose a new password</h1>

@if (Model.Changed)
{
    <p class="notice">Password changed. You are signed out on every device.</p>
    <div class="links">
        <a asp-page="/Accounts/SignInPage">Sign in</a>
    </div>
}
else
{
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="AccountId">
        <input type="hidden" asp-for="Code">

        <div class="field">
            <label asp-for="Password">New password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" autofocus>
            <span class="hint">At least @Model.MinimumPasswordLength characters.</span>
            <span asp-validation-for="Password"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword">New password again</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password">
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="accent">Change password</button>
    </form>
}
