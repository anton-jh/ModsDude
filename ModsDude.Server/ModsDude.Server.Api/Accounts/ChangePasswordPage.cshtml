@page "/account/password"
@model ChangePasswordPageModel
@{
    ViewData["Title"] = "Change password";
}

<h1>Change password</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="field">
        <label asp-for="CurrentPassword">Current password</label>
        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus>
        <span asp-validation-for="CurrentPassword"></span>
    </div>

    <div class="field">
        <label asp-for="NewPassword">New password</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password">
        <span class="hint">At least @Model.MinimumPasswordLength characters.</span>
        <span asp-validation-for="NewPassword"></span>
    </div>

    <div class="field">
        <label asp-for="ConfirmPassword">New password again</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password">
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="accent">Change password</button>
</form>

<div class="links">
    <a asp-page="/Accounts/AccountHomePage">Back to account</a>
</div>
