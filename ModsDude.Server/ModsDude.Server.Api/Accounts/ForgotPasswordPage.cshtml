@page "/account/forgot-password"
@model ForgotPasswordPageModel
@{
    ViewData["Title"] = "Forgot password";
}

<h1>Forgot password</h1>

@if (Model.Sent)
{
    <p class="notice">If that address has an account, a link to choose a new password is on its way.</p>
}
else
{
    @if (Model.CouldNotSend)
    {
        <p class="form-error">Could not send the email. Try again in a moment.</p>
    }

    <form method="post">
        <div class="field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="username" autofocus>
            <span asp-validation-for="Email"></span>
        </div>

        <button type="submit" class="accent">Send link</button>
    </form>
}

<div class="links">
    <a asp-page="/Accounts/SignInPage" asp-route-email="@Model.Email">Sign in</a>
</div>
